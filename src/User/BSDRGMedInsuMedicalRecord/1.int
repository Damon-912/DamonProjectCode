			kill ^BSDRGMedInsF2C8I("MdtrtId")
		}
		if ((idxlist="")||($listfind(idxlist,"MdtrtSn"))),'$listfind(pIgnoreIndexList,"MdtrtSn") {
			kill ^BSDRGMedInsF2C8I("MdtrtSn")
		}
		if ((idxlist="")||($listfind(idxlist,"PsnNo"))),'$listfind(pIgnoreIndexList,"PsnNo") {
			kill ^BSDRGMedInsF2C8I("PsnNo")
		}
		Set sc=1
		If $system.CLS.IsMthd("%OnAfterPurgeIndices") { Set sc=..%OnAfterPurgeIndices(.idxlist) }
	} Catch tException {
		Set sc=tException.AsStatus(),$ZE=""
