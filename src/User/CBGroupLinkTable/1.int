	// Get ROWID value for UNIQUE Key TableGroup value given in %con
	new %d,id,rtm set rtm=$zu(115,5,$s(pInternal:0,1:1)) set %d(2)=$lg(%con,1) set %d(3)=$lg(%con,2)
