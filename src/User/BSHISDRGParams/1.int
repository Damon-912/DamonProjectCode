%UnlockExtent(shared=0,immediate=0) public {
	If 'shared {
		If 'immediate {
			Lock -^BSHISDRGParamsD
			 Quit 1
		}
		Lock -^BSHISDRGParamsD#"I"
		Quit 1
	}
	If 'immediate {
		Lock -^BSHISDRGParamsD#"S"
		Quit 1
	}
	Lock -^BSHISDRGParamsD#"SI"
	Quit 1 }
%UnlockId(id,shared=0,immediate=0) public {
	If 'shared {
		If 'immediate {
			Lock -(^BSHISDRGParamsD(id)#"E")
			Quit 1
		}
		Lock -(^BSHISDRGParamsD(id)#"IE")
		Quit 1
	}
	If 'immediate {
		Lock -(^BSHISDRGParamsD(id)#"SE")
		Quit 1
	}
	Lock -(^BSHISDRGParamsD(id)#"SIE")
	Quit 1 }
%ValidateIndices(idxList="",autoCorrect=0,lockOption=1,multiProcess=1)
