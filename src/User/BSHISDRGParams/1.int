	if $case(autoCorrect,1:0,0:0,:1) { QUIT $$Error^%apiOBJ(5591,"##class(User.BSHISDRGParams).%ValidateIndices()","autoCorrect","'0' or '1'") }
	if $case(lockOption,2:0,1:0,0:0,:1) { QUIT $$Error^%apiOBJ(5591,"##class(User.BSHISDRGParams).%ValidateIndices()","lockOption","'0', '1' or '2'") }
	if $case(multiProcess,1:0,0:0,:1) { QUIT $$Error^%apiOBJ(5591,"##class(User.BSHISDRGParams).%ValidateIndices()","multiProcess","'0' or '1'") }
	new mapList QUIT $$ValidateIndices^%SYS.SECURITY("User.BSHISDRGParams",idxList,autoCorrect,lockOption,multiProcess)
