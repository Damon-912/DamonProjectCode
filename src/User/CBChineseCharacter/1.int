	if $g(%d(5))'="",'(($l(%d(5))'>4)) { set sqlcode=..%SQLInvalid(5+1,%d(5)) } 
	if $g(%d(3))'="",'(($l(%d(3))'>5)) { set sqlcode=..%SQLInvalid(3+1,%d(3)) } 
	if $g(%d(10))'="",'(($l(%d(10))'>50)) { set sqlcode=..%SQLInvalid(10+1,%d(10)) } 
	QUIT 'sqlcode
%SQLnBuild() public {
	set %n=$lb(,"ID","ASCIICODE","Character","PinyinSpelling","PinyinFirstSpell","FourCornersCode","WuBiCode","ZhengCode","LocationCode","StrokesNumber","x__classname")
	QUIT }
%SaveData(id) public {
	try {
		set id=$listget(i%"%%OID") if id'="" { set insert=0,idassigned=1 } else { set insert=1,idassigned=0 }
		set lock=0,lockok=0,tSharedLock=0
		if 'idassigned { set id=$i(^CBChineseCharacterD) do ..%IdSet(id) set:$g(%objtxSTATUS)=2 %objtxOIDASSIGNED(+$this)="" }
		set zzc10v1=$s(i%WuBiCode'="":i%WuBiCode,1:-1E14)
		set zzc10v2=$s(i%PinyinSpelling'="":i%PinyinSpelling,1:-1E14)
		set zzc10v3=$s(i%PinyinFirstSpell'="":i%PinyinFirstSpell,1:-1E14)
		set zzc10v4=$s(i%Character'="":i%Character,1:-1E14)
		set zzc10v5=$s(i%ASCIICode'="":i%ASCIICode,1:-1E14)
		try {
			set tInnerException = ""
			;
			if 'insert {
				if (i%%Concurrency<4)&&(i%%Concurrency) { lock +(^CBChineseCharacterD(id)#"E"):$zu(115,4) set lockok=$s('$t:0,1:$case($SYSTEM.Lock.ReturnCode(),0:1,2:2,4:2,:0)) set:lockok=2&&($tlevel) %0CacheLock($classname(),"E")=1 if lockok { set lock=1 } else { Throw ##class(%Exception.StatusException).ThrowIfInterrupt($$Error^%apiOBJ(5803,$classname())) } }
				if ('$Data(^CBChineseCharacterD(id))) {
					set insert=1
					if lock { lock -(^CBChineseCharacterD(id)#"E") set (lock,lockok) = 0 }
				}
			}
			if insert {
				if ('lockok&&..%Concurrency&&$tlevel)||(i%%Concurrency=4) {  lock +(^CBChineseCharacterD(id)#"E"):$zu(115,4) set lockok=$s('$t:0,1:$case($SYSTEM.Lock.ReturnCode(),0:1,2:2,4:2,:0)) set:(lockok=2&&(i%%Concurrency'=4)) %0CacheLock($classname(),"E")=1 set:lockok lock=1 if 'lockok { Throw ##class(%Exception.StatusException).ThrowIfInterrupt($$Error^%apiOBJ(5803,$classname())) } }
				if i%%Concurrency=3 { lock +(^CBChineseCharacterD(id)#"ES") set tSharedLock=1 }
				set ^CBChineseCharacterD(id)=$lb("",i%ASCIICode,i%Character,i%PinyinSpelling,i%PinyinFirstSpell,i%FourCornersCode,i%WuBiCode,i%ZhengCode,i%LocationCode,i%StrokesNumber)
				set ^CBChineseCharacterI("ASCII",zzc10v5,id)=""
				set ^CBChineseCharacterI("Character",zzc10v4,id)=""
				set ^CBChineseCharacterI("PinyinFirstSpell",zzc10v3,id)=""
				set ^CBChineseCharacterI("PinyinSpelling",zzc10v2,id)=""
				set ^CBChineseCharacterI("WuBiCode",zzc10v1,id)=""
			}
			else {
				set zzc31v1=^CBChineseCharacterD(id)
				set zzc31v2=$listget(zzc31v1,7)
				set zzc31v3=$listget(zzc31v1,4)
				set zzc31v4=$listget(zzc31v1,5)
				set zzc31v5=$listget(zzc31v1,3)
				set zzc31v6=$listget(zzc31v1,2)
				if (i%ASCIICode'=zzc31v6) {
					kill ^CBChineseCharacterI("ASCII",$s(zzc31v6'="":zzc31v6,1:-1E14),id)
					set ^CBChineseCharacterI("ASCII",zzc10v5,id)=""
				}
				if (i%Character'=zzc31v5) {
					kill ^CBChineseCharacterI("Character",$s(zzc31v5'="":zzc31v5,1:-1E14),id)
					set ^CBChineseCharacterI("Character",zzc10v4,id)=""
				}
				if (i%PinyinFirstSpell'=zzc31v4) {
					kill ^CBChineseCharacterI("PinyinFirstSpell",$s(zzc31v4'="":zzc31v4,1:-1E14),id)
					set ^CBChineseCharacterI("PinyinFirstSpell",zzc10v3,id)=""
				}
				if (i%PinyinSpelling'=zzc31v3) {
					kill ^CBChineseCharacterI("PinyinSpelling",$s(zzc31v3'="":zzc31v3,1:-1E14),id)
					set ^CBChineseCharacterI("PinyinSpelling",zzc10v2,id)=""
				}
				if (i%WuBiCode'=zzc31v2) {
					kill ^CBChineseCharacterI("WuBiCode",$s(zzc31v2'="":zzc31v2,1:-1E14),id)
					set ^CBChineseCharacterI("WuBiCode",zzc10v1,id)=""
				}
				set ^CBChineseCharacterD(id)=$lb("",i%ASCIICode,i%Character,i%PinyinSpelling,i%PinyinFirstSpell,i%FourCornersCode,i%WuBiCode,i%ZhengCode,i%LocationCode,i%StrokesNumber)
			}
			set tStatus = 1
		}
		catch tInnerException {
			if ('idassigned) { Set $zobjoid("",$listget(i%"%%OID"))="",i%"%%OID"="" kill:$g(%objtxSTATUS)=2 %objtxOIDASSIGNED(+$this) }
			if (tSharedLock) {  lock -(^CBChineseCharacterD(id)#"ES") } elseif (lockok=1)&&(insert)&&(i%%Concurrency=4) {  lock -(^CBChineseCharacterD(id)) }
		}
		if lock lock -(^CBChineseCharacterD(id)#"E")
		if $Isobject(tInnerException) { throw tInnerException }
	}
	catch tException {
		set tStatus = tException.AsStatus()
	}
	quit tStatus }
%SaveDirect(id="",idList="",data,concurrency=-1) public {
	try {
		set zzc5v1=$li(idList,1)
		set zzc5v2=$listget(data,7)
		set zzc5v3=$listget(data,4)
		set zzc5v4=$listget(data,5)
		set zzc5v5=$listget(data,3)
		set zzc5v6=$listget(data,2)
		set zzc5v7=$listget(data,1)
		if concurrency=-1 { set concurrency=$zu(115,10) }
		if id'="" { set insert=0,idassigned=1 } else { set insert=1,idassigned=0 }
		set lock=0,tSharedLock=0
		if 'idassigned { set id=$i(^CBChineseCharacterD) }
		set zzc10v1=$s(zzc5v2'="":zzc5v2,1:-1E14)
		set zzc10v2=$s(zzc5v3'="":zzc5v3,1:-1E14)
		set zzc10v3=$s(zzc5v4'="":zzc5v4,1:-1E14)
		set zzc10v4=$s(zzc5v5'="":zzc5v5,1:-1E14)
		set zzc10v5=$s(zzc5v6'="":zzc5v6,1:-1E14)
		try {
			set tInnerException = ""
			;
			if 'insert {
				if concurrency { lock +(^CBChineseCharacterD(id)#"E"):$zu(115,4) set lock=$s('$t:0,1:$case($SYSTEM.Lock.ReturnCode(),0:1,2:2,4:2,:0)) set:lock=2&&($tlevel) %0CacheLock($classname(),"E")=1 if 'lock { Throw ##class(%Exception.StatusException).ThrowIfInterrupt($$Error^%apiOBJ(5803,$classname())) } }
				if ('$Data(^CBChineseCharacterD(id))) {
					set insert=1
					if lock { lock -(^CBChineseCharacterD(id)#"E") set (lock,lockok) = 0 }
				}
			}
			if insert {
				if concurrency { lock +(^CBChineseCharacterD(id)#"E"):$zu(115,4) set lock=$s('$t:0,1:$case($SYSTEM.Lock.ReturnCode(),0:1,2:2,4:2,:0)) set:lock=2&&($tlevel) %0CacheLock($classname(),"E")=1 if 'lock { Throw ##class(%Exception.StatusException).ThrowIfInterrupt($$Error^%apiOBJ(5803,$classname())) } }
				set ^CBChineseCharacterD(id)=data
				set ^CBChineseCharacterI("ASCII",zzc10v5,id)=zzc5v7
				set ^CBChineseCharacterI("Character",zzc10v4,id)=zzc5v7
				set ^CBChineseCharacterI("PinyinFirstSpell",zzc10v3,id)=zzc5v7
				set ^CBChineseCharacterI("PinyinSpelling",zzc10v2,id)=zzc5v7
				set ^CBChineseCharacterI("WuBiCode",zzc10v1,id)=zzc5v7
			}
			else {
				set zzc31v1=^CBChineseCharacterD(zzc5v1)
				set zzc31v2=$listget(zzc31v1,7)
				set zzc31v3=$listget(zzc31v1,4)
				set zzc31v4=$listget(zzc31v1,5)
				set zzc31v5=$listget(zzc31v1,3)
				set zzc31v6=$listget(zzc31v1,2)
				if (zzc5v6'=zzc31v6) {
					kill ^CBChineseCharacterI("ASCII",$s(zzc31v6'="":zzc31v6,1:-1E14),zzc5v1)
					set ^CBChineseCharacterI("ASCII",zzc10v5,id)=zzc5v7
				}
				if (zzc5v5'=zzc31v5) {
					kill ^CBChineseCharacterI("Character",$s(zzc31v5'="":zzc31v5,1:-1E14),zzc5v1)
					set ^CBChineseCharacterI("Character",zzc10v4,id)=zzc5v7
				}
				if (zzc5v4'=zzc31v4) {
					kill ^CBChineseCharacterI("PinyinFirstSpell",$s(zzc31v4'="":zzc31v4,1:-1E14),zzc5v1)
					set ^CBChineseCharacterI("PinyinFirstSpell",zzc10v3,id)=zzc5v7
				}
				if (zzc5v3'=zzc31v3) {
					kill ^CBChineseCharacterI("PinyinSpelling",$s(zzc31v3'="":zzc31v3,1:-1E14),zzc5v1)
					set ^CBChineseCharacterI("PinyinSpelling",zzc10v2,id)=zzc5v7
				}
				if (zzc5v2'=zzc31v2) {
					kill ^CBChineseCharacterI("WuBiCode",$s(zzc31v2'="":zzc31v2,1:-1E14),zzc5v1)
					set ^CBChineseCharacterI("WuBiCode",zzc10v1,id)=zzc5v7
				}
				set ^CBChineseCharacterD(id)=data
			}
			set tStatus = 1
		}
		catch tInnerException {
		}
		if lock lock -(^CBChineseCharacterD(id)#"E")
		if $Isobject(tInnerException) { throw tInnerException }
	}
	catch tException {
		set tStatus = tException.AsStatus()
	}
	quit tStatus }
%SaveIndices(pStartId="",pEndId="",lockExtent=0) public {
	If lockExtent {
		Set sc=..%LockExtent(0)
		Quit:('sc) sc
	}
	s id=$order(^CBChineseCharacterD(pStartId),-1),tEndId=$S(pEndId'="":pEndId,1:pStartId)
BSLoop	s id=$O(^CBChineseCharacterD(id)) g:(id="")||(id]]tEndId) BSLoopDun
	Set bsv0N1=$Get(^CBChineseCharacterD(id))
	Set bsv0N2=$listget(bsv0N1,2)
	Set bsv0N3=$s(bsv0N2'="":bsv0N2,1:-1E14)
	Set ^CBChineseCharacterI("ASCII",bsv0N3,id)=$listget(bsv0N1,1)
	Set bsv0N4=$listget(bsv0N1,3)
	Set bsv0N5=$s(bsv0N4'="":bsv0N4,1:-1E14)
	Set ^CBChineseCharacterI("Character",bsv0N5,id)=$listget(bsv0N1,1)
	Set bsv0N6=$listget(bsv0N1,5)
	Set bsv0N7=$s(bsv0N6'="":bsv0N6,1:-1E14)
	Set ^CBChineseCharacterI("PinyinFirstSpell",bsv0N7,id)=$listget(bsv0N1,1)
	Set bsv0N8=$listget(bsv0N1,4)
	Set bsv0N9=$s(bsv0N8'="":bsv0N8,1:-1E14)
	Set ^CBChineseCharacterI("PinyinSpelling",bsv0N9,id)=$listget(bsv0N1,1)
	Set bsv0N10=$listget(bsv0N1,7)
	Set bsv0N11=$s(bsv0N10'="":bsv0N10,1:-1E14)
	Set ^CBChineseCharacterI("WuBiCode",bsv0N11,id)=$listget(bsv0N1,1)
	g BSLoop
BSLoopDun
	If lockExtent { Do ..%UnlockExtent(0) }
	Quit 1
CatchError	Set $ZTrap=""
	If $ZE'="" {
		Set sc = $$Error^%apiOBJ(5002,$ZE)
	}
	If lockExtent { Do ..%UnlockExtent(0) }
	Quit sc }
%SortBegin(idxlist="",excludeunique=0)
	if $select(idxlist="":1,$listfind(idxlist,"ASCII"):1,1:0) If $SortBegin(^CBChineseCharacterI("ASCII"))
	if $select(idxlist="":1,$listfind(idxlist,"Character"):1,1:0) If $SortBegin(^CBChineseCharacterI("Character"))
	if $select(idxlist="":1,$listfind(idxlist,"PinyinFirstSpell"):1,1:0) If $SortBegin(^CBChineseCharacterI("PinyinFirstSpell"))
	if $select(idxlist="":1,$listfind(idxlist,"PinyinSpelling"):1,1:0) If $SortBegin(^CBChineseCharacterI("PinyinSpelling"))
	if $select(idxlist="":1,$listfind(idxlist,"WuBiCode"):1,1:0) If $SortBegin(^CBChineseCharacterI("WuBiCode"))
	Quit 1
%SortEnd(idxlist="",commit=1,excludeunique=0) public {
	if $select(idxlist="":1,$listfind(idxlist,"ASCII"):1,1:0) If $SortEnd(^CBChineseCharacterI("ASCII"),commit)
	if $select(idxlist="":1,$listfind(idxlist,"Character"):1,1:0) If $SortEnd(^CBChineseCharacterI("Character"),commit)
	if $select(idxlist="":1,$listfind(idxlist,"PinyinFirstSpell"):1,1:0) If $SortEnd(^CBChineseCharacterI("PinyinFirstSpell"),commit)
	if $select(idxlist="":1,$listfind(idxlist,"PinyinSpelling"):1,1:0) If $SortEnd(^CBChineseCharacterI("PinyinSpelling"),commit)
	if $select(idxlist="":1,$listfind(idxlist,"WuBiCode"):1,1:0) If $SortEnd(^CBChineseCharacterI("WuBiCode"),commit)
	Quit 1 }
%UnlockExtent(shared=0,immediate=0) public {
	If 'shared {
		If 'immediate {
			Lock -^CBChineseCharacterD
			 Quit 1
		}
		Lock -^CBChineseCharacterD#"I"
		Quit 1
	}
	If 'immediate {
		Lock -^CBChineseCharacterD#"S"
		Quit 1
	}
	Lock -^CBChineseCharacterD#"SI"
	Quit 1 }
%UnlockId(id,shared=0,immediate=0) public {
	If 'shared {
		If 'immediate {
			Lock -(^CBChineseCharacterD(id)#"E")
			Quit 1
		}
		Lock -(^CBChineseCharacterD(id)#"IE")
		Quit 1
	}
	If 'immediate {
		Lock -(^CBChineseCharacterD(id)#"SE")
		Quit 1
	}
	Lock -(^CBChineseCharacterD(id)#"SIE")
	Quit 1 }
%ValidateIndices(idxList="",autoCorrect=0,lockOption=1,multiProcess=1)
	if '$listvalid(idxList) { QUIT $$Error^%apiOBJ(5591,"##class(User.CBChineseCharacter).%ValidateIndices()","idxList",""""" or a $list of index names") }
	if $case(autoCorrect,1:0,0:0,:1) { QUIT $$Error^%apiOBJ(5591,"##class(User.CBChineseCharacter).%ValidateIndices()","autoCorrect","'0' or '1'") }
	if $case(lockOption,2:0,1:0,0:0,:1) { QUIT $$Error^%apiOBJ(5591,"##class(User.CBChineseCharacter).%ValidateIndices()","lockOption","'0', '1' or '2'") }
	if $case(multiProcess,1:0,0:0,:1) { QUIT $$Error^%apiOBJ(5591,"##class(User.CBChineseCharacter).%ValidateIndices()","multiProcess","'0' or '1'") }
	new mapList QUIT $$ValidateIndices^%SYS.SECURITY("User.CBChineseCharacter",idxList,autoCorrect,lockOption,multiProcess)
%ValidateObject(force=0,checkserial=1) public {
	set sc=1
	If '$system.CLS.GetModified() Quit sc
	If m%ASCIICode Set iv=..ASCIICode If iv'="" Set rc=(..ASCIICodeIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"ASCIICode",iv)
	If m%Character Set iv=..Character If iv'="" Set rc=(..CharacterIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"Character",iv)
	If m%FourCornersCode Set iv=..FourCornersCode If iv'="" Set rc=(..FourCornersCodeIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"FourCornersCode",iv)
	If m%LocationCode Set iv=..LocationCode If iv'="" Set rc=(..LocationCodeIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"LocationCode",iv)
	If m%PinyinFirstSpell Set iv=..PinyinFirstSpell If iv'="" Set rc=(..PinyinFirstSpellIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"PinyinFirstSpell",iv)
	If m%PinyinSpelling Set iv=..PinyinSpelling If iv'="" Set rc=(..PinyinSpellingIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"PinyinSpelling",iv)
	If m%StrokesNumber Set iv=..StrokesNumber If iv'="" Set rc=(..StrokesNumberIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"StrokesNumber",iv)
	If m%WuBiCode Set iv=..WuBiCode If iv'="" Set rc=(..WuBiCodeIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"WuBiCode",iv)
	If m%ZhengCode Set iv=..ZhengCode If iv'="" Set rc=(..ZhengCodeIsValid(iv)) If ('rc) Set sc=$$EmbedErr^%occSystem(sc,rc,5802,"ZhengCode",iv)
	Quit sc }
