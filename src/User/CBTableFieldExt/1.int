zCBTFEParRefGetObject(force=0) public {
	Quit $select(r%CBTFEParRef=""||(i%CBTFEParRef'=""):$select(i%CBTFEParRef="":"",1:$listbuild(i%CBTFEParRef_"")),(''..CBTFEParRef.%GetSwizzleObject(force,.oid)):oid,1:"") }
