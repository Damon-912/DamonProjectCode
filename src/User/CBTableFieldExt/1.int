	Quit $Select(id'="":$p(id,"||",1),1:"") }
zCBTFEParRefGetSwizzled(noswizzle=0) public {
	If r%CBTFEParRef'="" Quit r%CBTFEParRef
	If i%CBTFEParRef="" Quit ""
	Set oid=$select(i%CBTFEParRef="":"",1:$listbuild(i%CBTFEParRef_""))
	Set oref=##class("User.CBTableData").%Open(oid,,.sc) If ('sc)||(oref="") Do:$get(^%SYS("ThrowSwizzleError"),0) $zutil(96,3,19,1) Quit ""
	Set modstate=$system.CLS.GetModifiedBits() Set r%CBTFEParRef=oref Do $system.CLS.SetModifiedBits(modstate)
	Do oref.ChildCBTableFieldExtRelate($this)
	Quit oref }
zCBTFEParRefNewObject() public {
	Set newobject=##class("User.CBTableData").%New() If newobject="" Quit ""
	Set ..CBTFEParRef=newobject
	Do ..CBTFEParRef.ChildCBTableFieldExtRelate($this)
	Quit newobject }
zCBTFEParRefOnDelete(id="",concurrency=-1) public {
	new %updcas Set %updcas="%1"
	set sc=..CBTFEParRefRExec(.qh,id) quit:('sc) sc
	for  set sc=..CBTFEParRefRFetch(.qh,0,.robjs,.fc,.end) Do  Quit:('sc)||(end)
	. for ptr=1:1:fc set sc=..%Delete($select($list(robjs,ptr)="":"",1:$listbuild($list(robjs,ptr)_"")),concurrency) Quit:('sc)
	Do ..CBTFEParRefRClose(.qh)
	quit sc }
