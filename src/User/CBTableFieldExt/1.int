	If i%CBTFEParRef'="",$listget(oref."%%OID")=i%CBTFEParRef Set modstate=$system.CLS.GetModifiedBits() Set r%CBTFEParRef=oref Do $system.CLS.SetModifiedBits(modstate) Quit 1
