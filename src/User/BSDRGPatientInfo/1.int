%UnlockExtent(shared=0,immediate=0) public {
	If 'shared {
		If 'immediate {
			Lock -^BSDRGPatientInfoD
			 Quit 1
		}
		Lock -^BSDRGPatientInfoD#"I"
		Quit 1
	}
	If 'immediate {
		Lock -^BSDRGPatientInfoD#"S"
		Quit 1
	}
	Lock -^BSDRGPatientInfoD#"SI"
	Quit 1 }
%UnlockId(id,shared=0,immediate=0) public {
	If 'shared {
		If 'immediate {
			Lock -(^BSDRGPatientInfoD(id)#"E")
			Quit 1
		}
		Lock -(^BSDRGPatientInfoD(id)#"IE")
		Quit 1
	}
	If 'immediate {
		Lock -(^BSDRGPatientInfoD(id)#"SE")
		Quit 1
	}
	Lock -(^BSDRGPatientInfoD(id)#"SIE")
	Quit 1 }
%ValidateIndices(idxList="",autoCorrect=0,lockOption=1,multiProcess=1)
	if '$listvalid(idxList) { QUIT $$Error^%apiOBJ(5591,"##class(User.BSDRGPatientInfo).%ValidateIndices()","idxList",""""" or a $list of index names") }
	if $case(autoCorrect,1:0,0:0,:1) { QUIT $$Error^%apiOBJ(5591,"##class(User.BSDRGPatientInfo).%ValidateIndices()","autoCorrect","'0' or '1'") }
	if $case(lockOption,2:0,1:0,0:0,:1) { QUIT $$Error^%apiOBJ(5591,"##class(User.BSDRGPatientInfo).%ValidateIndices()","lockOption","'0', '1' or '2'") }
	if $case(multiProcess,1:0,0:0,:1) { QUIT $$Error^%apiOBJ(5591,"##class(User.BSDRGPatientInfo).%ValidateIndices()","multiProcess","'0' or '1'") }
	new mapList QUIT $$ValidateIndices^%SYS.SECURITY("User.BSDRGPatientInfo",idxList,autoCorrect,lockOption,multiProcess)
