		if seqNo="" set seqNo=9999
		set subJson={}
		set subJson.id=groupMenuID
		set subJson.title=menuDetailDrDesc
		set subJson.enDesc=enDesc
		set component=""
		if linkAddress["../"{
			set linkAddress=$p(linkAddress,"../",2)	
		}
		if image["../"{
			set image=$p(image,"../",2)	
		}
		set linkPath="/"_code
		set subJson.path=linkPath
		set subJson.component=linkAddress
		set subJson.image=image
		set breadCrumb=[]
		do breadCrumb.%Push(menuDetailDrDesc)
		set subJson.breadcrumbName=breadCrumb
		set menuGroupFlag=menuDetailobj.MenuGroup
		if menuGroupFlag="Y"{
			set retJson=##class(src.BasicData.Group).GetGroupChildRouter(groupMenuID,breadCrumb.%ToJSON(),.routerArr,linkPath)	
		}else{
			do routerArr.%Push(subJson)	
		}
	}
	set resultObj={}
