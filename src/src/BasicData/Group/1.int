	quit resultObj
zGetGroupSelect(jsonObj)
	new (jsonObj)
	set resultObj={"errorCode":"0","errorMessage":"","result":{}}
	set pageSize="",currentPage=1,count=0,dataArr=[]
	try{
		set params=jsonObj.params.%Get(0)
		set compareCode=params.code
		set compareDescripts=params.descripts
		set safeClassificat=1
		if (jsonObj.%IsDefined("session")'=0) {
			set sessionObj=jsonObj.session.%Get(0)
			set groupID=sessionObj.groupID
			if groupID'=""
			{
				set groupobj=##class(User.CBGroup).%OpenId(groupID)
				set safeClassificat=groupobj.SafeClassificat.SafeClassificat
			}
		}
		set:safeClassificat="" safeClassificat=1
		set tStatement = ##class(%SQL.Statement).%New(1)
		set sql="SELECT SafeClassificat->SafeClassificat,* FROM CB_Group"		
		if (compareCode'="")||(compareDescripts'="") 
		{
			set sql=sql_" WHERE 1=1"
			set:(compareCode'="") sql=" AND Code LIKE '%"_compareCode_"%'"
			set:(compareDescripts'="") sql=sql_" AND Descripts LIKE '%"_compareDescripts_"%'"
		}
		do tStatement.%Prepare(sql)
		set result=tStatement.%Execute()		
		while result.%Next(.sc){
			set groupSafeClassificat=result.%Get("SafeClassificat")
			set:groupSafeClassificat="" groupSafeClassificat=1
			continue:((+groupSafeClassificat)>safeClassificat)
			set dataObj={}
			set dataObj.id=result.%Get("ID")
			set dataObj.code=result.%Get("Code")
			set dataObj.descripts=result.%Get("Descripts")
			set dataObj.enDesc=result.%Get("ENDesc")			
			set dataObj.mainInterface=result.%Get("MainInterface")
			if result.%Get("MainInterface")'="" {
				if ($g(^CBMenuDetailD(result.%Get("MainInterface")))'=""){
					set dataObj.mainInterfaceTitle=$lg(^CBMenuDetailD(result.%Get("MainInterface")),3)
				}
			}
			set dataObj.operCodeTable=result.%Get("OperCodeTable")
			set dataObj.sendMsgToAllUser=result.%Get("SendMsgToAllUser")
			set dataObj.safeClassificat=result.%Get("SafeClassificat")
			set dataObj.columnEdit=result.%Get("ColumnEdit")
			set dataObj.layoutEdit=result.%Get("LayoutEdit")
			set dataObj.defaultMenuType=result.%Get("DefaultMenuType")
			set dataObj.tokenOverTime=result.%Get("OverTime")
			set dataObj.startDate=result.%Get("StartDate")
			set dataObj.endDate=result.%Get("StopDate")
			do dataArr.%Push(dataObj)
		}
		set resultObj.result=dataArr		
	}catch(e){
		set status=e.AsStatus()
		set resultObj.errorCode=$piece(##class(%SYSTEM.Status).GetErrorCodes(status),",")
	    set resultObj.errorMessage=$replace(##class(%SYSTEM.Status).GetErrorText(status,"cn"),"^"," ")
	}
	quit resultObj
