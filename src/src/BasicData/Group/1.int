	Quit resultObj
zGetUnaddData(inputobj)
	new (inputobj)
	set params=inputobj.params.%Get(0)
	set resultJson={"errorCode":0,"errorMessage":""}
	try{
		set type=params.type
		set groupID=params.groupID		
		if groupID=""{
			set resultJson.errorCode="01040001"
			set resultJson.errorMessage=##class(src.Interface.Message).GetErrorMessage("01040001")
			quit		
		}		
		set groupMenuID=""
		set menuDetailStr=""
		for{
			set groupMenuID=$o(^CBGroupMenuI("Group",groupID,groupMenuID))
			quit:groupMenuID=""
			set groupMenuInfo=$g(^CBGroupMenuD(groupMenuID))
			set menuType=$lg(groupMenuInfo,4)
			continue:type'=menuType
			set menuDetailID=$lg(groupMenuInfo,5)	
			if menuDetailStr="" set menuDetailStr=menuDetailID
			else  set menuDetailStr=menuDetailStr_"^"_menuDetailID
		}
		set menuDetail=[]
		set menuDetailID=""
		for{
			set menuDetailID=$o(^CBMenuDetailD(menuDetailID))
			quit:menuDetailID=""
			continue:("^"_menuDetailStr_"^")[("^"_menuDetailID_"^")
			set menuDetailObj={}
			set menuDetailObj.id=menuDetailID
			set menuDetailInfo=$g(^CBMenuDetailD(menuDetailID))
			set menuDetailObj.descripts=$lg(menuDetailInfo,3)	
			set menuGroupFlag=$lg(menuDetailInfo,8)	
			if menuGroupFlag="Y"{
				set menuDetailObj.menuGroup="是" 		
			}else{
				set menuDetailObj.menuGroup="" 		
			}
			do menuDetail.%Push(menuDetailObj)
		}
		set result={}
		set result.menuDetail=menuDetail
