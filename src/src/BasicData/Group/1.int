zGetGroupInitialize(postObj)
	new (postObj)
	set session=postObj.session.%Get(0)
	set hospID=session.hospID
	set groupID=session.groupID
	set hospital=[]
	set hospStr=##class(src.CBTable.CBTableData).GetHosptialAuth(groupID,hospID,"User.CBHospital")
	if hospStr="" set hospStr=hospID
	if hospStr'=""{
		for i=1:1:$l(hospStr,"^"){
			set hospId=$p(hospStr,"^",i)
			continue:hospId=""
			set hospObj=$CLASSMETHOD("User.CBHospital","%OpenId",hospId)
			set obj={}
			set obj.id=hospId
			set obj.code=hospObj.Code
			set obj.descripts=hospObj.Descripts
			do hospital.%Push(obj)
		}
	}
	set safeClassificat=1
	set groupobj=##class(User.CBGroup).%OpenId(groupID)
	set safeClassificat=groupobj.SafeClassificat.SafeClassificat
	set:safeClassificat="" safeClassificat=1
	set hospGroupAuthType=[]
	set sql="select * from SQLUSER.CB_DataAuthorityType"
	set sqlObj=##class(%SQL.Statement).%New()
	set sc=sqlObj.%Prepare(sql)
	set list=sqlObj.%Execute()
	while list.%Next(){
		set SafeClassificat=list.%Get("SafeClassificat")
		continue:SafeClassificat>safeClassificat
		set obj={}
		set obj.id=list.%Get("ID")
		set obj.code=list.%Get("Code")
		set obj.descripts=list.%Get("Descripts")
		do hospGroupAuthType.%Push(obj)
	}
	set resultJson={}
	set resultJson.errorCode="0"
	set resultJson.errorMessage="成功"
	set result={}
	set result.hospital=hospital
	set result.hospGroupAuthType=hospGroupAuthType
	set resultJson.result=result
	Return resultJson
	Quit
zGetGroupList(jsonObj)
	new (jsonObj)
	set resultObj={"errorCode":"0","errorMessage":"","result":{}}
	set pageSize="",currentPage=1,count=0,dataArr=[]
	try
	{
		if (jsonObj.%IsDefined("pagination")'=0) 
		{
			set pagationObj=jsonObj.pagination.%Get(0)
			set pageSize=pagationObj.pageSize
			set currentPage=pagationObj.currentPage
		}
		set params=jsonObj.params.%Get(0)
		set compareCode=params.code
		set compareDescripts=params.descripts
		set safeClassificat=1
		if (jsonObj.%IsDefined("session")'=0) {
			set sessionObj=jsonObj.session.%Get(0)
			set groupID=sessionObj.groupID
			if groupID'=""
			{
				set groupobj=##class(User.CBGroup).%OpenId(groupID)
				set safeClassificat=groupobj.SafeClassificat.SafeClassificat
			}
		}
		set:safeClassificat="" safeClassificat=1
		b 
		set tStatement = ##class(%SQL.Statement).%New(1)
		set sql="SELECT SafeClassificat->SafeClassificat,* FROM CB_Group"		
		if (compareCode'="")||(compareDescripts'="") 
		{
			set sql=sql_" WHERE 1=1"
			set:(compareCode'="") sql=" AND Code LIKE '%"_compareCode_"%'"
			set:(compareDescripts'="") sql=sql_" AND Descripts LIKE '%"_compareDescripts_"%'"
		}
		b	;111
		do tStatement.%Prepare(sql)
		set result=tStatement.%Execute()		
		while result.%Next(.sc){
			set groupSafeClassificat=result.%Get("SafeClassificat")
			set:groupSafeClassificat="" groupSafeClassificat=1
			continue:((+groupSafeClassificat)>safeClassificat)
			set dataObj={}
			set dataObj.id=result.%Get("ID")
			set dataObj.code=result.%Get("Code")
			set dataObj.descripts=result.%Get("Descripts")
			set dataObj.enDesc=result.%Get("ENDesc")			
			set dataObj.mainInterface=result.%Get("MainInterface")
			if result.%Get("MainInterface")'="" {
				if ($g(^CBMenuDetailD(result.%Get("MainInterface")))'=""){
					set dataObj.mainInterfaceTitle=$lg(^CBMenuDetailD(result.%Get("MainInterface")),3)
				}
			}
			set dataObj.operCodeTable=result.%Get("OperCodeTable")
			set dataObj.sendMsgToAllUser=result.%Get("SendMsgToAllUser")
			set dataObj.safeClassificat=result.%Get("SafeClassificat")
			if dataObj.safeClassificat'=""
			{
				set Authobj=##class(User.CBDataAuthorityType).%OpenId(dataObj.safeClassificat)
				set dataObj.safeClassificatCode=Authobj.Code
				set dataObj.safeClassificatDesc=Authobj.Descripts
			}
			set dataObj.columnEdit=result.%Get("ColumnEdit")
			set dataObj.layoutEdit=result.%Get("LayoutEdit")
			set dataObj.defaultMenuType=result.%Get("DefaultMenuType")
			set dataObj.tokenOverTime=result.%Get("OverTime")
			set dataObj.startDate=result.%Get("StartDate")
			set dataObj.endDate=result.%Get("StopDate")
			set count=count+1
			if pageSize'="" continue:(count<((currentPage-1)*pageSize+1))||(count>((currentPage)*pageSize))
			do dataArr.%Push(dataObj)
		}
		set resultObj.result.rows=dataArr
		set resultObj.result.total=count		
	}catch(e){
		set status=e.AsStatus()
		set resultObj.errorCode=$piece(##class(%SYSTEM.Status).GetErrorCodes(status),",")
	    set resultObj.errorMessage=$replace(##class(%SYSTEM.Status).GetErrorText(status,"cn"),"^"," ")
	}
	quit resultObj
zGetGroupMenuDetail(inputobj)
	new (inputobj)
	try{
		set resultObj={}
		set params=inputobj.params.%Get(0)
		set type=params.type
		set groupID=params.groupID
		set desc=params.descripts
		if groupID=""{
			set resultObj.errorCode="01040102"
			set resultObj.errorMessage=##class(src.Interface.Message).GetErrorMessage("01040102")
			quit		
		}
		set resultObj={}
		set dataArr=[]
		set totalCount=0
		set subJsonArr=[]
		kill menuSortArr
		// 使用索引遍历 CB_GroupMenu 表
		set groupMenuID=""
		for{
			set groupMenuID=$o(^CBGroupMenuI("Group",groupID,groupMenuID))
			quit:groupMenuID=""	
			continue:$g(^CBGroupMenuD(groupMenuID))=""
			set groupMenuobj=##class(User.CBGroupMenu).%OpenId(groupMenuID)
			set menuType=groupMenuobj.Type
			continue:(type'="")&&(menuType'=type)
			set preMenuGroupID=groupMenuobj.PreGroupMenuDr	
			continue:preMenuGroupID'=""
			// 使用 MenuDr 字段（指向 CB_Menu 表）
			set menuobj=groupMenuobj.MenuDr
			continue:menuobj=""
			set menuID=menuobj.%Id()
			set safeClassificatobj=groupMenuobj.SafeClassificat
			set seqNo=groupMenuobj.SeqNo
			set subJson={}
			set subJson.id=groupMenuID
			set subJson.key=groupMenuID
			set subJson.menuDetailDesc=menuobj.Descripts
			set subJson.menuDetailCode=menuobj.Code
			set subJson.menuDetailID=menuID              // CB_Menu 的 ID
			set subJson.seqNo=seqNo
			set subJson.safeClassificat=""
			set subJson.safeClassificatCode=""
			set subJson.safeClassificatDec=""
			if safeClassificatobj'=""
			{
				set subJson.safeClassificat=safeClassificatobj.%Id()
				set subJson.safeClassificatCode=safeClassificatobj.Code
				set subJson.safeClassificatDec=safeClassificatobj.Descripts
			}
			set menuGroupFlag=menuobj.MenuLevel
			if menuGroupFlag=1{
				set subJson.menuGroup="是"	
			}else{
				set subJson.menuGroup=""	
			}
			// 获取子菜单
			set retJson=..GetChildMenuByGroup(groupMenuID,menuID,desc)
			if menuGroupFlag=1{
				if retJson.%Size()>0{
					set subJson.children=retJson
				}else{
					set subJson.children=[]
				}	
			}
			set groupMenuAuthArr=[]
			set groupMenuAuthID=""
			for
			{
				set groupMenuAuthID=$o(^HBGroupMenuAuthI("GroupMenu",groupMenuID,groupMenuAuthID))
				quit:groupMenuAuthID=""
				set hospID=$lg(^HBGroupMenuAuthD(groupMenuAuthID),3)
				do groupMenuAuthArr.%Push(hospID)
			}
			set subJson.groupMenuAuthArr=groupMenuAuthArr
			kill groupMenuAuthArr
			set:seqNo="" seqNo=0
			set menuSortArr(seqNo,groupMenuID)=subJson
			set totalCount=totalCount+1
		}
		set seqNo=""
		for {
			set seqNo=$o(menuSortArr(seqNo))
			quit:seqNo=""
			set id=0
			for{
				set id=$o(menuSortArr(seqNo,id))
				quit:id=""
				do subJsonArr.%Push(menuSortArr(seqNo,id))		
			}
		}
		set resultObj.errorCode=0
		set resultObj.errorMessage=""
		set resultData={}
		set resultData.total=totalCount
		set resultData.rows=subJsonArr
		set resultObj.result=resultData
	}catch(e){
		set status=e.AsStatus()
		set resultObj.errorCode=$piece(##class(%SYSTEM.Status).GetErrorCodes(status),",")
	    set resultObj.errorMessage=$replace(##class(%SYSTEM.Status).GetErrorText(status,"cn"),"^"," ")
	}
	quit resultObj
