		set status=e.AsStatus()
		set resultJson.errorCode=$piece(##class(%SYSTEM.Status).GetErrorCodes(status),",")
	    set resultJson.errorMessage=$replace(##class(%SYSTEM.Status).GetErrorText(status,"cn"),"^"," ")
	}
	quit resultJson
zMenuSubUpgrade(inputobj)
	new (inputobj)
	set jsonObj=inputobj.params.%Get(0)
	set menuSubs=jsonObj.MenuSubs
	if menuSubs.%Size()<=0{
		s resultJson={}
		s resultJson.errorCode="-1"
		s resultJson.errorMessage="角色授权菜单不能为空"
		Quit resultJson		
	}
	set resultJson={}
	s resultJson.errorCode="0"
	s resultJson.errorMessage="" 
	TStart
	set errorCode=0,errorMessage=""
	for i=0:1:menuSubs.%Size()-1{
		quit:errorCode'=0
		set itemObj=menuSubs.%Get(i)
		set groupMenuID=itemObj.id
		set updateUser=itemObj.UpdateUser
		if groupMenuID=""{
			continue
		}
		set preMenuGroupID=$lg(^CBGroupMenuD(+GroupMenuID),6)
		if preMenuGroupID=""{
			s resultJson={}
			s resultJson.errorCode="-1"
			s resultJson.errorMessage="该菜单已经是顶级,不能再升级!"
			Quit 
		}
		set newPreMenuGroupID=$lg(^CBGroupMenuD(+preMenuGroupID),6)
		set groupMenuObj=##class(User.CBGroupMenu).%OpenId(groupMenuID)
		set groupMenuObj.PreGroupMenuDr=newPreMenuGroupID
		if newPreMenuGroupID'="" set groupMenuObj.PreGroupMenuDr=##class(User.CBGroupMenu).%OpenId(newPreMenuGroupID)
		set tSC = groupMenuObj.%Save() 
		if ($System.Status.IsError(tSC)) {
			set errorMessage=$replace(##class(%SYSTEM.Status).GetErrorText(tSC,"cn"),"^"," ")
			set errorCode=$piece(##class(%SYSTEM.Status).GetErrorCodes(tSC),",")
			set errorMessage="User.CBGroupMenu Save:"_errorMessage
		}
		else{
			set id=GroupMenuObj.%Id()
		}
		do GroupMenuObj.%Close()
	}
	if errorCode'=0{
		TRollback 1
	}
	else{
		TCommit
	}
	set resultJson={}
	set resultJson.errorCode=errorCode
	set resultJson.errorMessage=errorMessage
	Quit resultJson
zSaveGroup(jsonObj)
	new (jsonObj)
	set resultObj={"errorCode":"0","errorMessage":"","result":{}}
	try{
		set params=jsonObj.params.%Get(0)
		set session=jsonObj.session.%Get(0)
		set dataObj={},dataArr=[]
		set dataObj.ID=params.id
		// 如果code为空，自动生成6位数字编码
		if params.code=""
		{
			// 生成不重复的6位编码
			for i=1:1:100
			{
				set newCode=$random(900000)+100000
				set existID=$o(^CBGroupI("Code",newCode,0))
				if existID="" quit
			}
			set dataObj.Code=newCode
		}
		else
		{
			set dataObj.Code=params.code
			set groupID=$o(^CBGroupI("Code",$ZCVT(params.code,"U"),0)) 
			if (params.id="")&&(groupID'="")
			{
				set resultObj.errorCode="-118"
				set resultObj.errorMessage=##class(src.Interface.Message).GetErrorMessage("-118")
				quit
			}
		}
		set dataObj.Descripts=params.descripts
		set groupID=$o(^CBGroupI("Desc",$ZCVT(params.descripts,"U"),0)) 
		if (params.id="")&&(groupID'="")
		{
			set resultObj.errorCode="-118"
			set resultObj.errorMessage=##class(src.Interface.Message).GetErrorMessage("-118")
			quit
		}  
		set dataObj.MainInterface=params.mainInterface
		set dataObj.OperCodeTable=params.operCodeTable
		set dataObj.SendMsgToAllUser=params.sendMsgToAllUser
		set dataObj.SafeClassificat=params.safeClassificat
		set dataObj.ColumnEdit=params.columnEdit
		set dataObj.LayoutEdit=params.layoutEdit
		set dataObj.DefaultMenuType=params.defaultMenuType
		set dataObj.ENDesc=params.enDesc
		set dataObj.StartDate=$zdh(params.startDate,3)
		set:params.endDate'="" dataObj.StopDate=$zdh(params.endDate,3)
		if params.id=""
		{
			set dataObj.CreateDate=+$h
			set dataObj.CreateUserDr=session.userID
		}
		do dataArr.%Push(dataObj)
		set operateObj={}
		set operateObj.updateUserID=session.userID
		set operateObj.className="User.CBGroup"			
		set operateObj.data=dataArr		
		if params.id=""
		{
			set rtn=##class(src.util.operatetable).Insert(.operateObj) ;调用公共类方法记录修改日记
		}
		else
		{				
			set rtn=##class(src.util.operatetable).Update(.operateObj) ;调用公共类方法记录修改日记
		}
		set errorCode=rtn.errorCode
		set errorMessage=rtn.errorMessage
		if errorCode'="0"{
			set resultObj.errorCode=errorCode
			set resultObj.errorMessage=errorMessage
			quit
		}
		set resultObj.result.groupID=rtn.rowIDArr.%Get(0)
	}catch(e){
		set status=e.AsStatus()
		set resultObj.errorCode=$piece(##class(%SYSTEM.Status).GetErrorCodes(status),",")
	    set resultObj.errorMessage=$replace(##class(%SYSTEM.Status).GetErrorText(status,"cn"),"^"," ")
	}
	quit resultObj
zSaveGroupMenu(inputobj)
	new (inputobj)
	try{
		set errorCode=0,errorMessage=""
		set jsonObj=inputobj.params.%Get(0)
		set session=inputobj.session.%Get(0)
		set resultJson={}
		set resultJson.errorCode=0
		set type=jsonObj.type
		set groupID=jsonObj.groupID
		set preGroupMenuID=jsonObj.preMenuGroupID
		set userID=session.userID
		if type=""{
			set errorCode="01040008"
			set errorMessage=##class(src.Interface.Message).GetErrorMessage("01040008")
			quit
		}
		if groupID=""{
			set errorCode="01040001"
			set errorMessage=##class(src.Interface.Message).GetErrorMessage("01040001")
			quit
		}
		// 先删除该角色该类型的所有旧权限
		set delSql="DELETE FROM SQLUSER.CB_GroupMenu WHERE Group_Dr = "_groupID_" AND Type = '"_type_"'"
		set delRS=##class(%SQL.Statement).%ExecDirect(,delSql)
	    Tstart
		set menuDetailArr=jsonObj.menuDetail
		for i=0:1:menuDetailArr.%Size()-1{
			quit:errorCode'=0
			set itemDataObj=menuDetailArr.%Get(i)	
			set menuDetailID=itemDataObj.menuDetailID
			if menuDetailID=""{
				continue
			}
			// 使用SQL直接插入，避免对象引用问题
			set insertSql="INSERT INTO SQLUSER.CB_GroupMenu (SeqNo, Group_Dr, Type, Menu_Dr, PreGroupMenu_Dr, SafeClassificat, CreateDate, CreateUser_Dr) VALUES (?,?,?,?,?,?,?,?)"
			set seqNo=$s(itemDataObj.seqNo'="":itemDataObj.seqNo,1:"")
			set preMenuID=$s(preGroupMenuID'="":preGroupMenuID,1:"")
			set safeClassID=$o(^CBDataAuthorityTypeI("Code","USER",""))
			set createDate=+$h
			set rs=##class(%SQL.Statement).%ExecDirect(,insertSql,seqNo,groupID,type,menuDetailID,preMenuID,safeClassID,createDate,userID)
			if rs.%SQLCODE<0{
				set errorCode=rs.%SQLCODE
				set errorMessage=rs.%Message
				quit
			}
		}
		if errorCode'=0{
			Trollback 1
		}else{
			Tcommit
		}
	}catch(e){
		Trollback 1
		set status=e.AsStatus()
		set errorCode=$piece(##class(%SYSTEM.Status).GetErrorCodes(status),",")
	    set errorMessage=$replace(##class(%SYSTEM.Status).GetErrorText(status,"cn"),"^"," ")
	}
	set resultJson.errorCode=errorCode
	set resultJson.errorMessage=errorMessage
	Quit resultJson
zSaveMenuSort(jsonObj)
	new (jsonObj)
	set params=jsonObj.params.%Get(0)
	set data=params.data
	set sortStr=""
	set errorCode=0,errorMessage=""
	set len=data.%Size()
	for i=0:1:len-1{
		set item=data.%Get(i)
		set id=item.id
		set safeClassificat=item.safeClassificat
		if item.%IsDefined("children"){
			do ..SaveNextMenuSort(item)	
		}
		set obj=##class(User.CBGroupMenu).%OpenId(id)
		set obj.SeqNo=i+1
		if safeClassificat'=""
		{
			set obj.SafeClassificat=##class(User.CBDataAuthorityType).%OpenId(safeClassificat)
		}else{
			set obj.SafeClassificat=""
		}
		set sc=obj.%Save()
		If ($System.Status.IsError(sc)) {
			set errorCode="01040031"
			set errorMessage=##class(src.Interface.Message).GetErrorMessage("01040031")
			Quit  
		}
	}
	b ;12222	
	set resultObj={}
	set resultObj.errorCode=errorCode
	set resultObj.errorMessage=errorMessage
	Quit resultObj
zSaveNextMenuSort(menuData)
	new (menuData)
	set errorCode=0,errorMessage=""
	set menuSubId=menuData.id
	set childrens=menuData.children
	set len=childrens.%Size()
	set sortStr=""
	for i=0:1:len-1{
		set item=childrens.%Get(i)	
		set id=item.id
		set safeClassificat=item.safeClassificat
		if item.%IsDefined("children"){
			do ..SaveNextMenuSort(item)	
		}
		set obj=##class(User.CBGroupMenu).%OpenId(id)
		set obj.SeqNo=i+1
		if safeClassificat'=""
		{
			set obj.SafeClassificat=##class(User.CBDataAuthorityType).%OpenId(safeClassificat)
		}else{
			set obj.SafeClassificat=""
		}
		set sc=obj.%Save()
		If ($System.Status.IsError(sc)) {
			set errorCode="01040031"
			set errorMessage=##class(src.Interface.Message).GetErrorMessage("01040031")
			Quit  
		}
	}	
	set resultObj={}
	set resultObj.errorCode=errorCode
	set resultObj.errorMessage=errorMessage
	Quit resultObj
