		continue:(menuType'=type)&&(type'="")
		set preMenuGroupID=groupMenuobj.PreGroupMenuDr	
		continue:preMenuGroupID'=""
		set menuDetailobj=groupMenuobj.MenuDetailDr
		continue:menuDetailobj=""
		set code=menuDetailobj.Code
		set menuDetailDrDesc=menuDetailobj.Descripts
		set enDesc=menuDetailobj.ENDesc
		set linkAddress=menuDetailobj.LinkAddress
		set linkPath=menuDetailobj.LinkPath
		set image=menuDetailobj.Image
		set winPosition=menuDetailobj.WinPosition
		set backMethod=menuDetailobj.BackMethod
		set paras=menuDetailobj.Paras
		set condExpress=menuDetailobj.CondExpress
		set JSMethod=menuDetailobj.JSMethod
		set tooltip=menuDetailobj.Tooltip
