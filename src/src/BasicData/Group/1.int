zDataAuthorityType(postObj)
	new (postObj)
	set session=postObj.session.%Get(0)
	set hospID=session.hospID
	set groupID=session.groupID
	set hospGroupAuthType=[]
	set sql="select * from SQLUSER.CB_DataAuthorityType"
	set sqlObj=##class(%SQL.Statement).%New()
	set sc=sqlObj.%Prepare(sql)
	set list=sqlObj.%Execute()
	while list.%Next(){
		set obj={}
		set obj.id=list.%Get("ID")
		set obj.code=list.%Get("Code")
		set obj.descripts=list.%Get("Descripts")
		do hospGroupAuthType.%Push(obj)
	}
	set resultJson={}
	set resultJson.errorCode="0"
	set resultJson.errorMessage="成功"
	set resultJson.result=hospGroupAuthType
	Return resultJson
	Quit
zDeleteGroupMenu(inputobj)
	new (inputobj)
	try{
		set errorCode=0,errorMessage=""
		set jsonObj=inputobj.params.%Get(0)
		set userID=jsonObj.userID
		set IDArr=jsonObj.IDs
		if IDArr.%Size()<=0{
			set errorCode="05100128"
			set errorMessage=##class(src.Interface.Message).GetErrorMessage("05100128")
			quit
		}		
		TStart
		for i=0:1:(IDArr.%Size()-1){
			set rowId=IDArr.%Get(i)
			set errorCode=..DeleteGroupMenuAndSubMenu(rowId,userID,inputobj.session.%Get(0))		
			quit:errorCode'=0
		}		
		if errorCode'=0{
			TRollback 1
			set errorMessage="删除失败"
		}
		else{
			TCommit
			set errorMessage="删除成功"
		}
	}catch(e){
		Trollback 1
		set status=e.AsStatus()
		set errorCode=$piece(##class(%SYSTEM.Status).GetErrorCodes(status),",")
	    set errorMessage=$replace(##class(%SYSTEM.Status).GetErrorText(status,"cn"),"^"," ")
	}
	set resultJson={}
	set resultJson.errorCode=errorCode
	set resultJson.errorMessage=errorMessage
	quit resultJson
