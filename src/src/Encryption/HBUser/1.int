 Set loc=$lb($zlascii(@(tree)@(($zlascii(@(tree)@($piece(node,",",1)),$piece(node,",",2))\16)),21),$zlascii(@(tree)@(($zlascii(@(tree)@($piece(node,",",1)),$piece(node,",",2))\16)),25))
 If loc="" Quit ""
 Set msg=$get(^%qMsg("%ObjectErrors",$s(""'="":$zcvt("","L"),1:$s($mvv(58)="":"en",1:$mvv(58))),"XMLImportLocation")," (%1,%2)")
 Quit $$FormatText^%occMessages(msg,$listget(loc,1),$listget(loc,2))
XMLImportInternalTrap Set $ztrap=""
 Set loc=$select($ZE["<CLASS DOES NOT EXIST>":" for element "_tag_$$XMLImportLocation(child),1:"")
 Quit $$Error^%apiOBJ(5002,$ZE_loc)
XMLImportIdChild() Set inner=child,innerlist=childlist,tmp=$$XMLImportId(),child=inner,childlist=innerlist Quit tmp
XMLImportId() ;
 Do XMLImportAttrinner()
 If $data(attributeList("href")) {
   Set id=$case($data(@(tree)@("d",$zlascii(attributeList("href"),13))),1:@(tree)@("d",$zlascii(attributeList("href"),13)),0:"",:##class(%XML.ImportHandler).GetAttribute(tree,attributeList("href")))
   If $extract(id)="#" {
     Set tmp=$select($get(@(tree)@("i",$extract(id,2,*)))="":"",1:$piece(@(tree)@("i",$extract(id,2,*)),",",1)_","_$piece(@(tree)@("i",$extract(id,2,*)),",",2)) If tmp="" Goto XMLImportIdErr
     Set inner=tmp
     Set descriptor=$zlascii(@(tree)@($piece(inner,",",1)),$piece(inner,",",2)) Set innerlist=@(tree)@((descriptor\16))
   }
 } ElseIf $data(attributeList("ref")),($get(@(tree)@("n",$zwascii(attributeList("ref"),9)))="http://www.w3.org/2003/05/soap-encoding") {
   Set id=$case($data(@(tree)@("d",$zlascii(attributeList("ref"),13))),1:@(tree)@("d",$zlascii(attributeList("ref"),13)),0:"",:##class(%XML.ImportHandler).GetAttribute(tree,attributeList("ref")))
   Set tmp=$select($get(@(tree)@("i",id))="":"",1:$piece(@(tree)@("i",id),",",1)_","_$piece(@(tree)@("i",id),",",2)) If tmp="" Goto XMLImportIdErr
   Set inner=tmp
   Set descriptor=$zlascii(@(tree)@($piece(inner,",",1)),$piece(inner,",",2)) Set innerlist=@(tree)@((descriptor\16))
 } ElseIf '$data(attributeList("id")) {
   Quit 0
 }
 Quit $data(idlist(inner))
XMLImportAttrnode()
 If $get(attributeList)=node Quit
 Kill attributeList
 Set attributeList=node
 Set offset=29 While offset<$zwascii(nodelist,17) { Set attribute=$extract(nodelist,offset,offset+15)
    Set attrname=@(tree)@("d",$zlascii(attribute,1))
    Set attributeList(attrname)=attribute
 Set offset=offset+16 }
 Quit
XMLImportAttrchild()
 If $get(attributeList)=child Quit
 Kill attributeList
 Set attributeList=child
 Set offset=29 While offset<$zwascii(childlist,17) { Set attribute=$extract(childlist,offset,offset+15)
    Set attrname=@(tree)@("d",$zlascii(attribute,1))
    Set attributeList(attrname)=attribute
 Set offset=offset+16 }
 Quit
XMLImportAttrinner()
 If $get(attributeList)=inner Quit
 Kill attributeList
 Set attributeList=inner
 Set offset=29 While offset<$zwascii(innerlist,17) { Set attribute=$extract(innerlist,offset,offset+15)
    Set attrname=@(tree)@("d",$zlascii(attribute,1))
    Set attributeList(attrname)=attribute
 Set offset=offset+16 }
 Quit
zXMLNew(document,node,containerOref="")
	Quit (##class(src.Encryption.HBUser).%New())
zXMLSchema(top="",format="",namespacePrefix="",input=0,refOnly=0,schema)
 Quit ##class(%XML.Implementation).XMLSchema("src.Encryption.HBUser",top,format,namespacePrefix,input,refOnly,.schema)
zgetUserInfo(userID)
	new (userID)
	set (userCode,userName,locID,locDesc,groupID,groupDesc)=""
	set (hospID,hospDesc,langID,langDesc,changeFlag)=""
	set (changeDesc,lastLoginDate,lastLoginTime,directorAuth,titleDesc,userYBCode,hospYBCode)=""
	quit:userID="" "XYS1001^用户或密码错误"
	quit:$d(^HBUserD(userID))=0 "XYS1001^用户或密码错误"
	set userCode=$lg($g(^HBUserD(userID)),2)	; 工号
	set userName=$lg($g(^HBUserD(userID)),3)	; 姓名
	set locID=""	; 默认科室
	set groupID=""	; 默认角色
	set hospID=""	; 默认医院
	set titleID=""	; 职称
	set titleDesc="" ;职称
	set firstLocID=""	; 
	set firstGroupID=""	; 
	set firstHospID=""	; 
	;用户有无效
	set active=$lg($g(^HBUserD(userID)),6)
	quit:(active="N") "XYS1001^该用户已无效"
	//默认登录医院角色(默认)
	Set resultArray=##Class(src.Logon.Logon).GetLogonGroupByUserId({"params":[{"userID":(userID)}]}).result.rows
	quit:resultArray.%Size()=0 "XYS1001^无登录医院"
	set hospID=resultArray.%Get(0).logonHospID
	set groupID=resultArray.%Get(0).logonGroupID
	set locID=resultArray.%Get(0).userLogonLocID
	for i=0:1:(resultArray.%Size()-1) {
		Set groupObj=resultArray.%Get(i)
		if groupObj.isDefault="Y"{
			set hospID=groupObj.logonHospID
			set groupID=groupObj.logonGroupID
			set locID=groupObj.userLogonLocID
		}
	}
	b 
	quit:hospID="" "XYS1001^无登录医院"
	quit:groupID="" "XYS1001^无登录角色"
	quit:locID="" "XYS1001^无登录科室"
	set (locDesc,groupDesc,hospDesc,langDesc,lastPwdUserName)=""
	set:locID'="" locDesc="HCRM" //$lg($g(^HBLocD(locID)),6)
	set:groupID'="" groupDesc=$lg($g(^CBGroupD(groupID)),3)
	set:hospID'="" hospDesc=$lg($g(^CBHospitalD(hospID)),3)
	set changeFlag="N",changeDesc=""
	//如果存在多个登录角色的话changeFlag这个标识为Y
	Set sqlString="SELECT count(1) total FROM SQLUser.HB_UserLogonLoc Where User_Dr=?"
	Set st = ##class(%SQL.Statement).%New(1)
	Set sc = st.%Prepare(sqlString)
	Set rs = st.%Execute(userID)
	Set total=0
	While rs.%Next(){
		Set total=rs.%Get("total")
	}
	Set:(total>1) changeFlag="Y",changeDesc="存在多个登录角色"
	set output="0^"_userID_"^"_userCode_"^"_userName_"^"_locID_"^"_locDesc_"^"_groupID_"^"_groupDesc
	set output=output_"^"_hospID_"^"_hospDesc_"^"_langID_"^"_langDesc_"^"_changeFlag
	set output=output_"^"_changeDesc_"^"_lastLoginDate_"^"_lastLoginTime_"^"_directorAuth_"^"_titleDesc_"^"_userYBCode_"^"_hospYBCode
	quit output