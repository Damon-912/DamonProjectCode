			s MenuDetailDr=$lg(^CBGroupD(GroupId,"O",GroupChild,"M",sub),3)
			s MenuDetailDrDesc=""
			if MenuDetailDr'=""{
				s MenuDetailDrDesc=$lg(^CBMenuDetailD(MenuDetailDr),3)
			}
