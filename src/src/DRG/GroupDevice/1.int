zIsCodeMatch(code1,code2)
	if (code1 = "") || (code2 = "")
	{
		quit 0
	}
	// 精确相等直接匹配
	if (code1 = code2)
	{
		quit 1
	}
	// 双向包含判断：一方是另一方的子串
	// code1包含code2 → code2是code1的前缀（如code1=H25.900, code2=H25）
	if ($FIND(code1, code2) = ($LENGTH(code2) + 1))
	{
		quit 1
	}
	// code2包含code1 → code1是code2的前缀（如code1=H25, code2=H25.9）
	if ($FIND(code2, code1) = ($LENGTH(code1) + 1))
	{
		quit 1
	}
	quit 0
zLogCheckInfo(logType,logContent)
    // 此处可扩展：写入日志表/文件
    // 示例：do ##class(src.Interface.Log).InsertLog("DRG分组", "PreMDC", logType, logContent)
    w $ZDATETIME($HOROLOG,3) _ " | " _ logType _ " | " _ logContent _ $C(13,10)
	Quit
zQueryDRGGroupRecord(postObj)
    try
    {
    	new (postObj)
	    set resultObj={"errorCode":"0","errorMessage":"","result":{}}
	    set pageSize="",currentPage=1,count=0,dataArr=[]
		if (postObj.%IsDefined("pagination")'=0) 
		{
	        set pagationObj=postObj.pagination.%Get(0)
			set pageSize=pagationObj.pageSize
		    set currentPage=pagationObj.currentPage
		}
        // 3. 获取查询条件
        set params=postObj.params.%Get(0)
        set admID = params.admID
        set medcasNo = params.medcasNo
        set patientName = params.patientName
        set psnNo = params.psnNo
        set drg = params.drg
        set mainDiagnosisCode = params.mainDiagnosisCode
        set startDate = params.startDate
        set endDate = params.endDate
        set department = params.department
        set groupStage = params.groupStage
        // 就诊时间范围查询条件
        set admStartDate = params.admStartDate
        set admEndDate = params.admEndDate
        set discgStartDate = params.discgStartDate
        set discgEndDate = params.discgEndDate
        set settleStartDate = params.settleStartDate
        set settleEndDate = params.settleEndDate
        // 4. 构建SQL条件（使用参数化查询防止SQL注入）
        set sqlWhere = " WHERE ActiveFlag = '1'"
        set sqlParams = []
        if (admID '= "")
        {
            set sqlWhere = sqlWhere _ " AND AdmID = ?"
            do sqlParams.%Push(admID)
        }
        if (medcasNo '= "")
        {
            set sqlWhere = sqlWhere _ " AND MedcasNo = ?"
            do sqlParams.%Push(medcasNo)
        }
        if (patientName '= "")
        {
            set sqlWhere = sqlWhere _ " AND PatientName LIKE ?"
            do sqlParams.%Push("%"_patientName_"%")
        }
        if (psnNo '= "")
        {
            set sqlWhere = sqlWhere _ " AND PsnNo LIKE ?"
            do sqlParams.%Push("%"_psnNo_"%")
        }
        if (drg '= "")
        {
            set sqlWhere = sqlWhere _ " AND DRG = ?"
            do sqlParams.%Push(drg)
        }
        if (mainDiagnosisCode '= "")
        {
            set sqlWhere = sqlWhere _ " AND MainDiagnosisCode = ?"
            do sqlParams.%Push(mainDiagnosisCode)
        }
        if (department '= "")
        {
            set sqlWhere = sqlWhere _ " AND Department = ?"
            do sqlParams.%Push(department)
        }
        if (groupStage '= "")
        {
            set sqlWhere = sqlWhere _ " AND GroupStage = ?"
            do sqlParams.%Push(groupStage)
        }
        if (startDate '= "")
        {
            set sqlWhere = sqlWhere _ " AND CreateDate >= ?"
            do sqlParams.%Push($ZDATEH(startDate, 3))
        }
        if (endDate '= "")
        {
            set sqlWhere = sqlWhere _ " AND CreateDate <= ?"
            do sqlParams.%Push($ZDATEH(endDate, 3))
        }
        // 入院时间范围查询
        if (admStartDate '= "")
        {
            set sqlWhere = sqlWhere _ " AND AdmDateTime >= ?"
            do sqlParams.%Push($ZDATEH(admStartDate, 3))
        }
        if (admEndDate '= "")
        {
            set sqlWhere = sqlWhere _ " AND AdmDateTime <= ?"
            do sqlParams.%Push($ZDATEH(admEndDate, 3))
        }
        // 出院时间范围查询
        if (discgStartDate '= "")
        {
            set sqlWhere = sqlWhere _ " AND DiscgDateTime >= ?"
            do sqlParams.%Push($ZDATEH(discgStartDate, 3))
        }
        if (discgEndDate '= "")
        {
            set sqlWhere = sqlWhere _ " AND DiscgDateTime <= ?"
            do sqlParams.%Push($ZDATEH(discgEndDate, 3))
        }
        // 结算时间范围查询
        if (settleStartDate '= "")
        {
            set sqlWhere = sqlWhere _ " AND SettleDateTime >= ?"
            do sqlParams.%Push($ZDATEH(settleStartDate, 3))
        }
        if (settleEndDate '= "")
        {
            set sqlWhere = sqlWhere _ " AND SettleDateTime <= ?"
            do sqlParams.%Push($ZDATEH(settleEndDate, 3))
        }
        // 5. 查询总记录数
        set totalSql = "SELECT COUNT(*) AS total FROM BS_DRGGroupRecord " _ sqlWhere
        set stmt = ##class(%SQL.Statement).%New()
        set sc = stmt.%Prepare(totalSql)
        set total = 0
        if ((''sc))
        {
            set rs = stmt.%Execute(sqlParams...)
            if (rs.%Next())
            {
                set total = rs.total
            }
        }
        set resultObj.result.total = total
        // 6. 如果没有记录，直接返回
        if (total = 0)
        {
            return resultObj
        }
        // 7. 计算分页参数
        set page = currentPage
        set limit = pageSize
        set startRow = (page - 1) * limit
        // 8. 查询数据列表（使用对象方式构建返回结构）
        set dataSql = "SELECT ID FROM BS_DRGGroupRecord " _ sqlWhere _ " ORDER BY CreateDate DESC, CreateTime DESC"
        set stmt = ##class(%SQL.Statement).%New()
        set sc = stmt.%Prepare(dataSql)
        set rows = []
        set rowIndex = 0
        set skipCount = 0
        if ((''sc))
        {
            set rs = stmt.%Execute(sqlParams...)
            while (rs.%Next())
            {
                set rowIndex = rowIndex + 1
                // 分页处理：跳过前面的记录
                if (rowIndex <= startRow)
                {
                    continue
                }
                // 限制返回数量
                if (rows.%Size() >= limit)
                {
                    quit
                }
                // 使用对象方式获取完整数据
                set record = ##class(User.BSDRGGroupRecord).%OpenId(rs.ID)
                if (record '= "")
                {
                    set row = {}
                    set row.id = record.%Id()
                    set row.admID = record.AdmID
                    set row.medcasNo = record.MedcasNo
                    set row.patientName = record.PatientName
                    set row.psnNo = record.PsnNo
                    set row.insuranceAreaCode = record.InsuranceAreaCode
                    set row.insuType = record.InsuType
                    set row.sex = record.Sex
                    set row.age = record.Age
                    // 诊断信息
                    set row.mainDiagnosisCode = record.MainDiagnosisCode
                    set row.mainDiagnosisName = record.MainDiagnosisName
                    set row.diaTypeCode = record.DiaTypeCode
                    set row.diagnosisCode = record.DiagnosisCode
                    set row.diagnosisName = record.DiagnosisName
                    set row.mainOperationCode = record.MainOperationCode
                    set row.mainOperationName = record.MainOperationName
                    // DRG分组结果
                    set row.drg = record.DRG
                    set row.drgDesc = record.DRGDesc
                    set row.weight = record.Weight
                    set row.benchmarkCost = record.BenchmarkCost
                    set row.ccFlag = record.CCFlag
                    set row.mccFlag = record.MCCFlag                    
                    set row.groupTime = $ZDATETIME(record.GroupTime, 3)
                    set row.groupStage = record.GroupStage
                    set row.remark = record.Remark
                    // 科室信息
                    set row.department = record.Department
                    set row.departmentDesc = record.DepartmentDesc
                    // 机构信息
                    set row.fixmedinsCode = record.FixmedinsCode
                    set row.fixmedinsName = record.FixmedinsName
                    // 时间信息
                    set row.createDate = $ZD(record.CreateDate, 3)
                    set row.createTime = $ZT(record.CreateTime, 1)
                    set row.updateDate = $ZD(record.UpdateDate, 3)
                    set row.updateTime = $ZT(record.UpdateTime, 1)
                    // 就诊时间信息
                    set row.admDateTime = ""
                    set row.discgDateTime = ""
                    set row.settleDateTime = ""
                    if (record.AdmDateTime '= "") set row.admDateTime = $ZDATETIME(record.AdmDateTime, 3)
                    if (record.DiscgDateTime '= "") set row.discgDateTime = $ZDATETIME(record.DiscgDateTime, 3)
                    if (record.SettleDateTime '= "") set row.settleDateTime = $ZDATETIME(record.SettleDateTime, 3)
                    set count=count+1
                    if pageSize'="" continue:(count<((currentPage-1)*pageSize+1))||(count>((currentPage)*pageSize))
                    do rows.%Push(row)
                }
            }
        }
		set resultObj.result.rows=rows
		set resultObj.result.total=total
    }
    catch(e)
    {
        set status = e.AsStatus()
        set errorCode = $piece(##class(%SYSTEM.Status).GetErrorCodes(status), ",")
        set errorMsg = $replace(##class(%SYSTEM.Status).GetErrorText(status,"cn"), "^", " ")
        set errorInfo = "查询DRG分组记录异常：类=" _ $ClassName() _ "，错误：" _ errorMsg
        // 记录错误日志
        set errorLogID = ##class(src.Interface.Message).InsErrRecord("02010036", errorInfo, errorMsg)
        set resultObj.errorCode = "-99"
        set resultObj.errorMessage = "查询DRG分组记录异常（日志ID："_errorLogID_"）："_errorMsg
    }
    quit resultObj
zSaveDRGGroupRecord(jsonObj)
	new (jsonObj)
	set params = ##class(%Library.DynamicArray).%New()	
    try
    {
        // 1. 初始化返回对象（标准化结构）
        set resultObj = ..SetSuccessResult("0","")
        // 2. 参数合法性校验（核心前置检查）
        if (jsonObj = "") || (jsonObj.params = "") 
        {
            set resultObj = ..SetErrorResult("-1", "入参异常：缺少params参数或参数为空")
            quit 
        } 	    	    	    
        // 3. 获取入参
        set params = jsonObj.params.%Get(0)
        set hisAdmId = params.hisAdmId
        set medcasNo = params.medcasNo
        set patientName = params.patientName
        set psnNo = params.psnNo
        set insuranceAreaCode = params.insuranceAreaCode
        set mdtrtareaAreaCode = params.mdtrtareaAreaCode
        set insuType = params.insuType
        set sex = params.sex
        set age = params.age
        set mainDiagnosisCode = params.mainDiagnosisCode
        set mainDiagnosisName = params.mainDiagnosisName
        set diaTypeCode = params.diaTypeCode
        set diagnosisCode = params.diagnosisCode
        set diagnosisName = params.diagnosisName
        set mainOperationCode = params.mainOperationCode
        set mainOperationName = params.mainOperationName
        set deptCode = params.deptCode
        set deptName = params.deptName
        set drg = params.drg
        set drgDesc = params.drgDesc
        set weight = params.weight
        set benchmarkCost = params.benchmarkCost
        set ccFlag = params.ccFlag
        set mccFlag = params.mccFlag
        set riskLevel = params.riskLevel
        set groupTime = params.groupTime
        set fixmedinsCode = params.fixmedinsCode
        set fixmedinsName = params.fixmedinsName
        set groupStage = params.groupStage
        set admDateTime = params.admDateTime
        set discgDateTime = params.discgDateTime
        set settleDateTime = params.settleDateTime
        set unionOprnFlag = params.unionOprnFlag
        set remark = params.remark
        // 4. 必填项校验
        if (hisAdmId = "")
        {
            set resultObj = ..SetErrorResult("-1", "hisAdmId：HIS唯一就诊ID不能为空")
            quit 
        }
        if (drg = "")
        {            
            set resultObj = ..SetErrorResult("-1", "DRG：DRG编码不能为空")
            quit 
        }
        // 5. 构建数据对象（属性名需严格匹配 User.BSDRGGroupRecord 类定义，大小写敏感）
        set dynObj = {}
        // 患者基本信息
        set dynObj.AdmID = hisAdmId
        set dynObj.MedcasNo = medcasNo
        set dynObj.PatientName = patientName
        set dynObj.PsnNo = psnNo
        set dynObj.InsuranceAreaCode = insuranceAreaCode
        set dynObj.mdtrtareaAreaCode = mdtrtareaAreaCode
        set dynObj.InsuType = insuType
        set dynObj.Sex = sex
        set dynObj.Age = age
        // 诊断信息
        set dynObj.MainDiagnosisCode = mainDiagnosisCode
        set dynObj.MainDiagnosisName = mainDiagnosisName
        set dynObj.DiaTypeCode = diaTypeCode
        set dynObj.DiagnosisCode = diagnosisCode
        set dynObj.DiagnosisName = diagnosisName
        set dynObj.MainOperationCode = mainOperationCode
        set dynObj.MainOperationName = mainOperationName
        set dynObj.Department = deptCode
        set dynObj.DepartmentDesc = deptName
        // DRG分组结果
        set dynObj.DRG = drg
        set dynObj.DRGDesc = drgDesc
        set dynObj.CCFlag = ccFlag
        set dynObj.MCCFlag = mccFlag
        set dynObj.RiskLevel = riskLevel
        set dynObj.UnionOprnFlag = unionOprnFlag
        // 数值型字段
        if (weight '= "") set dynObj.Weight = +weight
        if (benchmarkCost '= "") set dynObj.BenchmarkCost = +benchmarkCost
        // 分组时间解析
        set dynObj.GroupTime = $zd($h,3)_" "_$zt($p($h,",",2),1)
        // 机构信息
        set dynObj.FixmedinsCode = fixmedinsCode
        set dynObj.FixmedinsName = fixmedinsName
        // 分组阶段和备注
        set dynObj.GroupStage = groupStage
        set dynObj.Remark = remark
        // 就诊时间信息
        if (admDateTime '= "")
        {
            try { set dynObj.AdmDateTime = $ZDATETIMEH(admDateTime, 3) } catch { set dynObj.AdmDateTime = admDateTime }
        }
        if (discgDateTime '= "")
        {
            try { set dynObj.DiscgDateTime = $ZDATETIMEH(discgDateTime, 3) } catch { set dynObj.DiscgDateTime = discgDateTime }
        }
        if (settleDateTime '= "")
        {
            try { set dynObj.SettleDateTime = $ZDATETIMEH(settleDateTime, 3) } catch { set dynObj.SettleDateTime = settleDateTime }
        }
        // 6. 查询DRG指向（HB_DRGCoreAlgorithmData表）
        if (drg '= "")&&(mdtrtareaAreaCode '="")&&(fixmedinsCode '="")
        {
            set drgDr = ""
             ;---&sql(SELECT ID INTO :drgDr FROM HB_DRGCoreAlgorithmData WHERE DRG = :drg and FixmedinsCode=:fixmedinsCode and MdtrtArea=:mdtrtareaAreaCode)
              ;--- ** SQL PUBLIC Variables: %ROWCOUNT, %ROWID, %msg, SQLCODE, drg, drgDr, fixmedinsCode, mdtrtareaAreaCode
            do %0A9o
            if (drgDr '= "") set dynObj.DRGDr = drgDr
        }
        // 7. 获取当前用户信息（从session）
        set userId = ""
        if (jsonObj.%IsDefined("session") && (jsonObj.session.%Size() > 0))
        {
            set session = jsonObj.session.%Get(0)
            if (session.%IsDefined("userID") && (session.userID '= "")) set userId = session.userID
        }
        // 8. 查询是否已存在记录
        set id = ""
         ;---&sql(select ID into :id from BS_DRGGroupRecord where DRG=:drg and AdmID=:hisAdmId)
          ;--- ** SQL PUBLIC Variables: %ROWCOUNT, %ROWID, %msg, SQLCODE, drg, hisAdmId, id
        do %0Abo
        // 9. 设置新增/更新标识
        if (id '= "")
        {
            set dynObj.ID = id
            set dynObj.UpdateDate = $zd($h,3)
            set dynObj.UpdateTime = $zt($p($h,",",2),1)
            if (userId '= "") set dynObj.UpdateUserDr = userId
        }
        else
        {
            set dynObj.CreateDate = $zd($h,3)
            set dynObj.CreateTime = $zt($p($h,",",2),1)
            set dynObj.ActiveFlag = "1"
            if (userId '= "") set dynObj.CreateUserDr = userId
        }
        // 10. 通过 operatetable 通用方法保存
        set data = []
        do data.%Push(dynObj)
        set insObj = {}
        set insObj.className = "User.BSDRGGroupRecord"
        set insObj.data = data
        if (id '= "")
        {
            set rtn = ##class(src.util.operatetable).Update(.insObj)
        }
        else
        {
            set rtn = ##class(src.util.operatetable).Insert(.insObj)
        }
        // 11. 处理保存结果
        if (rtn.errorCode '= "0")
        {
            set resultObj = ..SetErrorResult("-1", "保存记录失败："_rtn.errorMessage)
            quit 
        }
        set resultObj = ..SetSuccessResult("","保存成功")
    }
    catch(e)
    {
        set status = e.AsStatus()
        set errorCode = $piece(##class(%SYSTEM.Status).GetErrorCodes(status), ",")
        set errorMsg = $replace(##class(%SYSTEM.Status).GetErrorText(status,"cn"), "^", " ")
        set errorInfo = "保存DRG分组记录异常：类=" _ $ClassName() _ "，错误：" _ errorMsg
        // 记录错误日志
        set errorLogID = ##class(src.Interface.Message).InsErrRecord("02010035", errorInfo, errorMsg)
        set resultObj.errorCode = "-99"
        set resultObj.errorMessage = "保存DRG分组记录异常（日志ID："_errorLogID_"）："_errorMsg
    }
    quit resultObj
 q
