 S $lg(,,,,,,provID,cityID,,,sqldata5d)=sqldata21d
 s sqldata8d=$zu(28,sqldata5d,5)
 s sqldata12d=$zlist(sqldata8d)
 g:sqldata11d'=sqldata12d %0imCdun
%0imBuncommitted ;
 s SQLCODE=0 g %0ic
%0imCdun if $g(sqldata13d)=1 { if $g(sqldata14d)=1 { l -@sqldata15d s sqldata14d=0 } elseif $g(sqldata14d)=2 { do $classmethod($li(sqldata15d),"%UnlockId",$li(sqldata15d,2),1,1)  s sqldata14d=0 }}
 g %0imBk1
%0imBdun 
%0imAdun 
%0ic set %ROWCOUNT='SQLCODE
 if $g(sqldata13d)=1 {
 	if $g(sqldata14d)=1 { l -@sqldata15d s sqldata14d=0 } elseif $g(sqldata14d)=2 { do $classmethod($li(sqldata15d),"%UnlockId",$li(sqldata15d,2),1,1)  s sqldata14d=0 }
 }
 n context,tmp,count,total,mean s context=$system.Context.SQL()
 if $d(%sqltime) { s %sqltime=$g(sqldata22d)+$zh-%sqltime
 if $g(context.Stats)<$zu(99) { d AggregateStats^%SYS.SQLSRV() }
 s tmp=$g(context.Stats($namespace,"Cle8d3BBG1wjz4ScEMlm5nAWP4M="))
 s count=$lg(tmp,1),total=$lg(tmp,2),mean=total+%sqltime/(count+1)
 s context.Stats($namespace,"Cle8d3BBG1wjz4ScEMlm5nAWP4M=")=$lb(count+1,total+%sqltime,$s(+count=0:0,1:(%sqltime-mean)**2+(count*((total/count-mean)**2+$lg(tmp,3)))/(count+1))) }
 q
%0ierr s $zt=""
 d SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg)
 g %0ic
%0kmCs1(s,e) [] PUBLIC { QUIT:s="" "0E" s p="",u="",q=1_$c(34,34) f n=1:1 { s c=$e(s,n) q:c=""  i "_%"[c { s:"_"=c u=u+1 s:q'["." q=$e(".","%"=c)_"E1"_$c(34,34) } else { s:c=e n=n+1,c=$e(s,n) s:c=$c(34) c=$c(34,34) s p=p_u_q,u="",q="",$e(p,$l(p))=c_$c(34) } } QUIT p_u_$p(q,1) }
%0ko n sqldata22d,sqldata23d,sqldata24d,sqldata26d,sqldata30d,sqldata31d,sqldata8d,sqldata21d,sqldata18d,sqldata6d,sqldata15d,sqldata12d,sqldata16d,sqldata19d,sqldata20d,sqldata9d
