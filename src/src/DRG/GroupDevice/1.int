 ; asl MOD# 5
 s SQLCODE=0 g %0Oc
%0OmEdun 
%0OmAdun 
%0Oc set %ROWCOUNT='SQLCODE
 if $g(sqldata26d)'="" kill ^||%t(sqldata26d)
 n context,tmp,count,total,mean s context=$system.Context.SQL()
 if $d(%sqltime) { s %sqltime=$g(sqldata31d)+$zh-%sqltime
 if $g(context.Stats)<$zu(99) { d AggregateStats^%SYS.SQLSRV() }
 s tmp=$g(context.Stats($namespace,"8A5YSiyImbmKgBj0uxW2z+QNpW8="))
 s count=$lg(tmp,1),total=$lg(tmp,2),mean=total+%sqltime/(count+1)
 s context.Stats($namespace,"8A5YSiyImbmKgBj0uxW2z+QNpW8=")=$lb(count+1,total+%sqltime,$s(+count=0:0,1:(%sqltime-mean)**2+(count*((total/count-mean)**2+$lg(tmp,3)))/(count+1))) }
 q
%0Oerr s $zt=""
 d SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg)
 g %0Oc
%0OmBMod ; asl MOD# 2
 s sqldata24d=""
%0OmBk1 s sqldata28d="" s sqldata24d=$o(^CBDRGCoreGroupsListD(sqldata24d),1,sqldata28d)
 i sqldata24d="" g %0OmBdun
 S sqldata4d=$lg(sqldata28d,24)
 s sqldata15d=$zu(28,sqldata4d,7)
 g:'(sqldata15d=sqldata16d) %0OmBk1
 g:'(sqldata15d'=" ") %0OmBk1
 S sqldata1d=$lg(sqldata28d,2)
 s sqldata14d=$zu(28,sqldata1d,5)
 g:'(sqldata14d=sqldata17d) %0OmBk1
 S $lg(,,,,,,,sqldata7d,,sqldata9d,,,,,,,,,,,,sqldata11d)=sqldata28d
 s sqldata18d=$zu(28,sqldata7d,7)
 s sqldata20d=$zu(28,sqldata9d,7)
 s sqldata22d=$zu(28,sqldata11d,7)
 g:'((((sqldata18d'=" ")&&(sqldata18d=sqldata19d))||((sqldata20d'=" ")&&(sqldata20d=sqldata21d)))||((sqldata22d'=" ")&&(sqldata22d=sqldata23d))) %0OmBk1
 ; asl MOD# 3
%0OmCdun ; asl MOD# 4
 s sqldata30d=sqldata14d g:$d(^||%t(sqldata26d,sqldata30d)) %0OmDdun s ^(sqldata30d)=""
 d $i(iCount,sqldata1d'="")
%0OmDdun g %0OmBk1
%0OmBdun q
%0Qo n sqldata21d,sqldata22d,sqldata24d,sqldata26d,sqldata27d,sqldata6d,sqldata8d,sqldata10d,sqldata20d,sqldata4d,sqldata13d,sqldata14d,sqldata7d,sqldata16d,sqldata17d,sqldata9d,sqldata18d,sqldata19d,sqldata1d,sqldata12d,sqldata15d
 s $zt="%0Qerr"
 n %sqltime s %sqltime=$zh
 s sqldata21d=$zu(115,2)
 d:$zu(115,15) $system.ECP.Sync()
 s sqldata6d=$g(adrgCode),sqldata8d=$g(secOperationCode),sqldata10d=$g(thirdOperationCode)
