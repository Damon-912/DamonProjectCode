 S sqldata6d=$lg(sqldata26d,3)
 s sqldata15d=$zu(28,sqldata6d,5)
 g:'(sqldata15d?@(sqldata12d)) %0kmBk1
 g:'(($c(0)[sqldata16d)||(sqldata16d=$c(32,0)&&($e(sqldata15d)=$c(32)))||(sqldata16d=$e(sqldata15d,1,$l(sqldata16d)))) %0kmBk1
 S provID=$lg(sqldata26d,7),cityID=$lg(sqldata26d,8)
 goto:sqldata22d'=1 %0kmBuncommitted
 if sqldata22d=1 {
 	lock +^CBHospitalD($p(sqldata18d,"||",1))#"S":$zu(115,4)
 	if $t { set sqldata24d=$name(^CBHospitalD($p(sqldata18d,"||",1)))_"#""SI""",sqldata23d=1 }
 	else { s SQLCODE=-114,%msg="Unable to acquire shared lock on table SQLUser.CB_Hospital for RowID value: "_sqldata18d ztrap "LOCK"  }
 }
 ; asl MOD# 3
 s sqldata19d=$zlist(sqldata15d)
 i sqldata18d'="" s sqldata30d="" i $d(^CBHospitalD(sqldata18d),sqldata30d)
 e  g %0kmCdun
 S $lg(,,sqldata6d,,,,provID,cityID)=sqldata30d
 s sqldata15d=$zu(28,sqldata6d,5)
 s sqldata20d=$zlist(sqldata15d)
 g:sqldata19d'=sqldata20d %0kmCdun
%0kmBuncommitted ;
 s sqldata21d=sqldata21d+1
