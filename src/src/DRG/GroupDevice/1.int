 s sqldata22d=$zu(28,sqldata11d,7)
 g:'((((sqldata18d'=" ")&&(sqldata18d=sqldata19d))||((sqldata20d'=" ")&&(sqldata20d=sqldata21d)))||((sqldata22d'=" ")&&(sqldata22d=sqldata23d))) %0pmBk1
 ; asl MOD# 3
%0pmCdun ; asl MOD# 4
 s sqldata30d=sqldata14d g:$d(^||%t(sqldata26d,sqldata30d)) %0pmDdun s ^(sqldata30d)=""
 d $i(iCount,sqldata1d'="")
%0pmDdun g %0pmBk1
%0pmBdun q
