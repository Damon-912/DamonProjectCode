 s SQLCODE=100
 s sqldata9d=$s("%"="":"",sqldata8d="":"","%"=$c(0):sqldata8d,sqldata8d=$c(0):"%",1:"%"_sqldata8d)
 s sqldata16d=$zu(28,$p($p($s(sqldata9d="":"","%"="":"",sqldata9d=$c(0):"%","%"=$c(0):sqldata9d,1:sqldata9d_"%"),"%"),"_"),5)
 s sqldata12d=$$%0kmCs1($zu(28,$s(sqldata9d="":"","%"="":"",sqldata9d=$c(0):"%","%"=$c(0):sqldata9d,1:sqldata9d_"%"),5),"")
 s sqldata21d=0
 i '(sqldata8d'="") g %0kmAdun
 ; asl MOD# 2
 s sqldata18d=""
