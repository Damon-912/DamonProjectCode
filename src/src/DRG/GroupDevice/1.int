 }
 n context,tmp,count,total,mean s context=$system.Context.SQL()
 if $d(%sqltime) { s %sqltime=$g(sqldata31d)+$zh-%sqltime
 if $g(context.Stats)<$zu(99) { d AggregateStats^%SYS.SQLSRV() }
 s tmp=$g(context.Stats($namespace,"Yy4jTH/ck+yREFntG7ekfRi/yhs="))
 s count=$lg(tmp,1),total=$lg(tmp,2),mean=total+%sqltime/(count+1)
 s context.Stats($namespace,"Yy4jTH/ck+yREFntG7ekfRi/yhs=")=$lb(count+1,total+%sqltime,$s(+count=0:0,1:(%sqltime-mean)**2+(count*((total/count-mean)**2+$lg(tmp,3)))/(count+1))) }
