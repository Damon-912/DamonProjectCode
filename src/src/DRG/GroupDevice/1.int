 s context.Stats($namespace,"UIMx3Rkr6rrL1RvCmoqyZO1l6Jw=")=$lb(count+1,total+%sqltime,$s(+count=0:0,1:(%sqltime-mean)**2+(count*((total/count-mean)**2+$lg(tmp,3)))/(count+1))) }
