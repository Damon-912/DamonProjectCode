zDeviceFeeWarning(jsonObj)
	new (jsonObj)
	set params = ##class(%Library.DynamicArray).%New()	
	try
	{
        // 1. 初始化返回对象（标准化结构）
        set resultObj = ..SetSuccessResult("0","")
        // 2. 参数合法性校验（核心前置检查）
        if (jsonObj = "") || (jsonObj.params = "") 
        {
            set resultObj = ..SetErrorResult("-1", "入参异常：缺少params参数或参数为空")
            quit 
        }         
        //先获取分组结果
        set joDRGObj=..Device(jsonObj)
        if (joDRGObj.errorCode '=0)
        {
            set resultObj = ..SetErrorResult("-1", "DRG分组失败："_joDRGObj.errorMessage)
            quit   
	    }
	    else
	    {
		    set params = jsonObj.params.%Get(0)
		    //取DRG信息
            set drgParams = joDRGObj.result.drgInfo.%Get(0)
            set drgCode = drgParams.code
		    set drgDesc = drgParams.desc
		    //取DRG算法信息
		    set payParams = joDRGObj.result.hospAlgorithmInfo.%Get(0)
		    set drgPayStandard=payParams.payStandard
		    //组织入参调用02010107费用预警接口服务
		    set jsonObj.params.%Get(0).hisAdmId=params.hisAdmId
		    set jsonObj.params.%Get(0).patientName=params.patientName
		    set jsonObj.params.%Get(0).deptCode=params.deptCode
		    set jsonObj.params.%Get(0).deptName=params.deptName
		    set jsonObj.params.%Get(0).doctorCode=params.doctorCode
		    set jsonObj.params.%Get(0).doctorName=params.doctorName
		    set jsonObj.params.%Get(0).totalFee=params.totalFee
		    set jsonObj.params.%Get(0).drgCode=drgCode
		    set jsonObj.params.%Get(0).drgName=drgDesc
		    set jsonObj.params.%Get(0).drgPayStandard=drgPayStandard
		    set jsonObj.params.%Get(0).medicalRecordDr=params.medicalRecordDr
		    set jsonObj.params.%Get(0).insuranceFee=params.insuranceFee
		    set jsonObj.params.%Get(0).fixmedinsCode=params.fixmedinsCode		    
		    set jsonObj.params.%Get(0).fixmedinsName=params.fixmedinsName
		    set jsonObj.params.%Get(0).ruleType=params.ruleType		    
		    set joRtn=##class(src.DRG.Warning).AddWarningRecord(jsonObj)	
		    if (joRtn.errorCode '=0) 
		    {
                set resultObj = ..SetErrorResult("-1", "DRG分组结果费用预警失败：DRG分组【"_drgCode_"："_drgDesc_"】"_joRtn.errorMessage)
                quit   
			}   
			else
			{
			    set joWarningFee= []
			    set joWarningFee= joRtn.result
			    set joDRGObj.result.feeWarningInfo=joWarningFee
			    // 费用预警成功，插入DRG分组记录
			    set saveParams = {}
			    set saveParams.hisAdmId = params.hisAdmId
			    set saveParams.medcasNo = params.medicalRecordDr
			    set saveParams.patientName = params.patientName
			    set saveParams.psnNo = params.psnNo
			    set saveParams.insuranceAreaCode = params.insuranceAreaCode
			    set saveParams.mdtrtareaAreaCode = params.mdtrtareaAreaCode
			    set saveParams.insuType = params.insuType
			    set saveParams.sex = params.sex
			    set saveParams.age = params.age
			    set saveParams.mainDiagnosisCode = params.mainDiagnosisCode
			    set saveParams.mainDiagnosisName = params.diagnosisName
			    set saveParams.diaTypeCode = params.diaTypeCode
			    set saveParams.diagnosisCode = params.diagnosisCode
			    set saveParams.diagnosisName = params.diagnosisName
			    set saveParams.mainOperationCode = params.mainOperationCode
			    set saveParams.mainOperationName = ""
			    set saveParams.deptCode = params.deptCode
			    set saveParams.deptName = params.deptName
			    set saveParams.drg = drgCode
			    set saveParams.drgDesc = drgDesc
			    set saveParams.benchmarkCost = drgPayStandard
			    set saveParams.groupTime = ""
			    set saveParams.fixmedinsCode = params.fixmedinsCode
			    set saveParams.fixmedinsName = params.fixmedinsName
			    set saveParams.groupStage = params.groupStage
			    set saveParams.admDateTime = params.admDateTime
			    set saveParams.discgDateTime = params.discgDateTime
			    set saveParams.settleDateTime = params.settleDateTime
			    set saveParams.unionOprnFlag = params.unionOprnFlag
			    set saveParams.remark = params.%ToJSON()
			    // 从diseInfo中获取主诊断名称（mainFlag=1 且 diagSn=1）
			    if (params.mainDiagnosisCode '= "") && ($ISOBJECT(params.diseInfo)) && (params.diseInfo.%Size() > 0)
			    {
			        for i=0:1:params.diseInfo.%Size()-1
			        {
			            set diagItem = params.diseInfo.%Get(i)
			            if (diagItem.mainFlag = "1") && (diagItem.diagSn = "1")
			            {
			                set saveParams.mainDiagnosisName = diagItem.diagName
			                quit
			            }
			        }
			    }
			    // 从oprnInfo中获取主手术名称（mainFlag=1 且 oprnSn=1）
			    if (params.mainOperationCode '= "") && ($ISOBJECT(params.oprnInfo)) && (params.oprnInfo.%Size() > 0)
			    {
			        for j=0:1:params.oprnInfo.%Size()-1
			        {
			            set oprnItem = params.oprnInfo.%Get(j)
			            if (oprnItem.mainFlag = "1") && (oprnItem.oprnSn = "1")
			            {
			                set saveParams.mainOperationName = oprnItem.oprnName
			                quit
			            }
			        }
			    }
			    // 从complicationInfo提取ccFlag/mccFlag/riskLevel
			    set saveParams.ccFlag = "0"
			    set saveParams.mccFlag = "0"
			    set saveParams.riskLevel = "低"
			    if ($ISOBJECT(joDRGObj.result.complicationInfo)) && (joDRGObj.result.complicationInfo.%Size() > 0)
			    {
			        set hasMCC = 0
			        set hasCC = 0
			        for k=0:1:joDRGObj.result.complicationInfo.%Size()-1
			        {
			            set compItem = joDRGObj.result.complicationInfo.%Get(k)
			            if (compItem.complication = "MCC") { set hasMCC = 1 }
			            elseif (compItem.complication = "CC") { set hasCC = 1 }
			        }
			        if (hasMCC = 1)
			        {
			            set saveParams.mccFlag = "1"
			            set saveParams.riskLevel = "高"
			        }
			        elseif (hasCC = 1)
			        {
			            set saveParams.ccFlag = "1"
			            set saveParams.riskLevel = "中"
			        }
			    }
			    // 从hospAlgorithmInfo提取weight（points/100）
			    if ($ISOBJECT(joDRGObj.result.hospAlgorithmInfo)) && (joDRGObj.result.hospAlgorithmInfo.%Size() > 0)
			    {
			        set algoItem = joDRGObj.result.hospAlgorithmInfo.%Get(0)
			        set pointsVal = algoItem.points
		        if (pointsVal '= "") && (pointsVal '= "0.00") && (+pointsVal > 0) { set saveParams.weight = +pointsVal / 100 }
			    }
			    // 构造SaveDRGGroupRecord接口入参
			    set paramsArr = ##class(%Library.DynamicArray).%New()
			    do paramsArr.%Push(saveParams)
			    set saveJsonObj = ##class(%Library.DynamicObject).%New()
			    set saveJsonObj.params = paramsArr
			    // 传递session信息（保持原调用链session）
			    if (jsonObj.%IsDefined("session")) { set saveJsonObj.session = jsonObj.session }
			    // 调用保存方法
			    set saveRtn = ##class(src.DRG.GroupDevice).SaveDRGGroupRecord(saveJsonObj)
			    if (saveRtn.errorCode '= "0")
			    {
				    set resultObj = ..SetErrorResult("-1", "DRG分组结果费用预警成功，但保存分组记录失败："_saveRtn.errorMessage)
				    quit
			    }
	            set resultObj = joDRGObj			    	    
			}	    		    		    
		}				
	}
    catch(e)
    {
        set status = e.AsStatus()
        set errorCode = $piece(##class(%SYSTEM.Status).GetErrorCodes(status), ",")
        set errorMsg = $replace(##class(%SYSTEM.Status).GetErrorText(status,"cn"), "^", " ")
        set errorInfo = "DRG分组结果费用预警异常：类=" _ $ClassName() _ "，错误：" _ errorMsg
        // 记录错误日志
        set errorLogID = ##class(src.Interface.Message).InsErrRecord("02010035", errorInfo, errorMsg)
        set resultObj.errorCode = "-99"
        set resultObj.errorMessage = "DRG分组结果费用预警异常（日志ID："_errorLogID_"）："_errorMsg
    }
    quit resultObj
zDeviceNew(jsonObj)
	///病例实际费用 ÷ 该病组标准费用（次均费用 / 支付标准）」算出倍率，再按当地医保阈值划分为：高倍率、正常倍率、低倍率。
	///DRG 权重RW与基准点数本质是同一个 “相对资源值”，只是单位与叫法不同：权重是小数（比值）基准点数 = DRG 权重 × 100（或 ×1000，各地不同）
	try
	{
        // 初始化返回对象（标准化结构）
        set resultObj = ..SetSuccessResult("0","")
        // 参数合法性校验（核心前置检查）
        if (jsonObj = "") || (jsonObj.params = "") 
        {
            set resultObj = ..SetErrorResult("-1", "入参异常：缺少params参数或参数为空")
            quit 
        }
        // 提取入参并设置默认值（避免空值报错）
        set params = jsonObj.params.%Get(0)
        set mainDiagCode = params.mainDiagnosisCode  
        set diseinfo = params.diseInfo  // 疾病诊断-数组对象   
		set mainOperationCode = params.mainOperationCode    // 主手术代码
    	set oprninfo = params.oprnInfo  // 手术操作-数组对象（兼容空数组）  
    	set hospinfo = params.hospInfo  // 医疗机构-数组对象   	
        set sex = params.sex                       // 性别
        set age = params.age                         // 年龄（默认0）
        set ageGroupDays = params.ageGroupDays        // 新生儿出生天数（默认0）
        set newbornFlag = params.newbornFlag        // 新生儿标志（默认0）
        set respiratorTime = params.respiratorTime    // 有创呼吸机时长（默认0）
        set ecmoFlag = params.ecmoFlag             // ECMO标志（默认0）
        set transplantFlag = params.transplantFlag  // 器官移植标志（默认0）
        set marrowTransplantFlag = params.marrowTransplantFlag // 骨髓移植标志
        set hivFlag = params.hivFlag                // HIV标志（默认0）
        set traumaLevel = params.traumaLevel          // 多发创伤等级（默认0）
		set department = params.department           // 科室编码
		set departmentDesc = params.departmentDesc   // 科室名称
		set dischargeType = params.dischargeType // 离院方式 1医嘱离院;2医嘱转院;3医嘱转社区卫生服务机构/乡镇卫生院;4非医嘱离院;5死亡;9其他 代码 2（医嘱转院） 和 4（非医嘱离院） 在DRG分组中会被特别标记
		set hospitalDays = params.hospitalDays   //住院天数 	
		set totalCost = params.totalCost             //住院已发生费用合计
		set patientName=params.patientName //患者姓名
		set deptCode=params.deptCode //HIS科室编码
		set deptName=params.deptName //HIS科室名称	
		set doctorCode=params.doctorCode //HIS医生编码
		set doctorName=params.doctorName //HIS医生名称
		set medicalRecordID=params.medicalRecordDr //病案号	
		set hisAdmID=params.hisAdmID //HIS就诊号				
		//增加HIS患者就诊信息
		set psnNo=params.psnNo //医保个人编号
		set insuranceAreaCode=params.insuranceAreaCode //参保地区划代码 
		set mdtrtareaAreaCode=params.mdtrtareaAreaCode //就医地区划代码
		set insuType=params.insuType //险种类型								
		set diagnosisCode=params.diagnosisCode //病种编码
		set diagnosisName=params.diagnosisName //病种名称
		set groupStage=params.groupStage  //分组阶段 1.事前 2.事中 3.事后
		set diaTypeCode=params.diaTypeCode //诊断类型编码 ADD入院 OPD门诊 DIS出院		
		set admDateTime=params.admDateTime //入院时间
		set discgDateTime=params.discgDateTime //出院时间
		set settleDateTime=params.settleDateTime //结算时间
		set unionOprnFlag=params.unionOprnFlag //联合手术标志 
		//分组方案年份（由前端传入，默认当前年份）
		set groupYear = params.groupYear
		if (groupYear = "") set groupYear = $PIECE($ZDATE($HOROLOG,3),"-",1)
    	// 如果为空字符串或非数组，设置为空数组
    	if (diseinfo = "") || ('$ISOBJECT(diseinfo)) set diseinfo = []
    	if (oprninfo = "") || ('$ISOBJECT(oprninfo)) set oprninfo = []		
    	if (hospinfo = "") || ('$ISOBJECT(hospinfo)) set hospinfo = []    	    		  	                    
		set (MDC,MDCDesc,ADRG,ADRGDesc,DRG,DRGDesc,Complication,ComplicationDesc)=""		
		//1.分组流程前 校验入参 
		set joRtn=..CheckRules(jsonObj)
		if (joRtn.errorCode '= "0")
		{
            set resultObj = ..SetErrorResult("-1", "进入分组流程前CheckRules校验失败："_joRtn.errorMessage)
            quit
		}
		//2.第一步：MDC先期分组      
		set joRtn=..GroupPreMDC(jsonObj)
		if (joRtn.errorCode '= "0")
		{
            set resultObj = ..SetErrorResult("-2", "2.MDC先期分组失败："_joRtn.errorMessage)
            quit
		}
		else
		{
			set MDC=joRtn.result.code
			set MDCDesc=joRtn.result.desc
		}
		//3.第二步：判断QY歧义组
        set params.mdc = MDC
        set params.mdcDesc = MDCDesc
		set joRtn=..CheckGroupQY(jsonObj)
		if (joRtn.errorCode '= "0")
		{	
		    //返回不为0表示 进入歧义组		
            set resultObj = ..SetErrorResult("-3", "3.QY歧义组判断："_joRtn.errorMessage)
            quit
		}
		//4.第三步：ADRG分组        
        set params.mdc = MDC
        set params.mdcDesc = MDCDesc
		set joRtn=..GroupADRG(jsonObj)
		//set resultObj=joRtn
		//quit
		if (joRtn.errorCode '= "0")
		{
            set resultObj = ..SetErrorResult("-4", "4.1 ADRG分组失败："_joRtn.errorMessage)
            quit
		}
		else
		{
			//返回结果是数组对象,可能存在多个ADRG分组结果
			set totalCount = joRtn.totalCount //返回记录数
			set jaADRG= joRtn.result
			if (totalCount = 0)
			{
			    set resultObj=..SetErrorResult("-4","4.2 ADRG分组失败,请检查主诊断大类【"_MDC_"："_MDCDesc_"】的分组规则是否维护！0000组入组条件：主要诊断大类(MDC),或者未入任何ADRG分组！")	
			    quit
			}	
			set ADRG=jaADRG.%Get(0).code		
		}
		//第四步B：特异化分组匹配（直接调用独立引擎 SpecialGroupEngine，引擎内部循环匹配各家医院所在地区）
		// 命中特异化分组后跳过CC/MCC和标准DRG细分，直接进入算法配置查询
		set skipToAlgorithm = 0
		if ($ISOBJECT(hospinfo)) && (hospinfo.%Size() > 0) 
		{
			; 构建 patientInfo
			set patientInfo = ##class(%Library.DynamicObject).%New()
			set patientInfo.mainDiagnosisCode = jsonObj.params.%Get(0).mainDiagnosisCode
			set patientInfo.mainOperationCode = jsonObj.params.%Get(0).mainOperationCode
			set patientInfo.diseInfo = jsonObj.params.%Get(0).diseInfo
			set patientInfo.oprnInfo = jsonObj.params.%Get(0).oprnInfo
			set patientInfo.adrg = ADRG
			if ('$ISOBJECT(patientInfo.diseInfo)) set patientInfo.diseInfo = ##class(%Library.DynamicArray).%New()
			if ('$ISOBJECT(patientInfo.oprnInfo)) set patientInfo.oprnInfo = ##class(%Library.DynamicArray).%New()
			; 直接调用引擎的 hospInfo 循环匹配方法（自动遍历每家医院查询地区并匹配）
			set joSpecialRtn = ##class(src.DRG.SpecialGroupEngine).MatchByHospInfo(patientInfo, hospinfo, "")
			if (joSpecialRtn.errorCode = "0") 
			{
				// 命中特异化分组，直接使用特异化DRG编码
				if ($ISOBJECT(joSpecialRtn.result)) 
				{
					set DRG = joSpecialRtn.result.drgCode
					set DRGDesc = joSpecialRtn.result.drgDesc
				} 
				else 
				{
					set DRG = ""
					set DRGDesc = ""
				}
				// 构造jaDRG数组（后续算法查询和返回值封装需要）
				set jaDRG = ##class(%Library.DynamicArray).%New()
				set drgItem = {}
				set drgItem.code = DRG
				set drgItem.desc = DRGDesc
				do jaDRG.%Push(drgItem)
				// 并发症信息设为空（特异化分组不考虑CC/MCC）
				set jaComplication = ##class(%Library.DynamicArray).%New()
				set skipToAlgorithm = 1
			}
		}
		// hospinfo为空或未命中特异化分组，继续标准流程（Step 5 Complication → Step 6 GroupDRG）
		if (skipToAlgorithm = 0) 
		{
	    	//第四步：并发症确认CC/MCC
		    set params.adrgInfo = jaADRG
		    set joRtn=..GroupComplication(jsonObj)	
		    if (joRtn.errorCode '= "0")
		    {
                set resultObj = ..SetErrorResult("-5", "5.1 并发症确认CC/MCC失败："_joRtn.errorMessage)
                quit
	    	}
	    	else
		    {
			    //返回结果是数组对象,可能存在多个ADRG分组结果
			    set totalCount = joRtn.totalCount //返回记录数
		    	set jaComplication= joRtn.result
    		}
	    	//第五步：DRG分组
            set params.complicationInfo= jaComplication                       
		    set joRtn=..GroupDRG(jsonObj)								
		    if (joRtn.errorCode '= "0")
		    {
                set resultObj = ..SetErrorResult("-7", "7.1 DRG分组失败："_joRtn.errorMessage)
                quit
		    }
	    	else
		    {
			    //返回数组对象,可能存在多个DRG分组结果
			    set totalCount = joRtn.totalCount 
			    set jaDRG= joRtn.result	
			    if (totalCount =0)
		    	{
			        set resultObj=..SetErrorResult("-7","7.2 DRG分组失败："_joRtn.errorMessage)	
			        quit
			    }
                set itemObj = jaDRG.%Get(0)
                set DRG = itemObj.code
                set DRGDesc = itemObj.desc									
	    	}
		}  // end of skipToAlgorithm check
		//第六步：查询DRG对应医疗机构算法配置信息		
        //循环医疗机构信息数组
        set jaAlgorithm=[]
        for i = 0:1:hospinfo.%Size()-1 
        {
            set itemObj = hospinfo.%Get(i)
            set hisHospCode=itemObj.hisHospCode            
            set hospCode = itemObj.code
            set hospName = itemObj.name
            set mdtrtArea="",policyType=""
            set iCount=0
            set (points,pipValue,dgdov,payStandard)="0.00"
            //根据医院信息获取对应的就医地区划代码 - 医疗机构信息表数据确保完善
             ;---&sql(SELECT CityID_Dr->Code,PolicyType_Dr->Descripts into :mdtrtareaAreaCode,:policyType FROM CB_Hospital WHERE OrganizationCode=:hospCode)
              ;--- ** SQL PUBLIC Variables: %ROWCOUNT, %ROWID, %msg, SQLCODE, hospCode, mdtrtareaAreaCode, policyType
            do %02o
            //根据参保地和就医地区划，解析获取 市本级/省直/异地	   
            set insuAreaDesc=..GetSettlementType(insuranceAreaCode,mdtrtareaAreaCode)	        
            //按年份查询算法配置：优先查询当前年份，无数据时回退到上一年
            set queryYear = groupYear
             ;---&sql(SELECT Count(*) into :iCount FROM HB_DRGCoreAlgorithmData WHERE FixmedinsCode=:hospCode AND DRG=:DRG AND (Year=:groupYear OR Year IS NULL OR Year=''))
              ;--- ** SQL PUBLIC Variables: %ROWCOUNT, %ROWID, %msg, DRG, SQLCODE, groupYear, hospCode, iCount
            do %04o
            if (iCount = 0)&&(groupYear '= "") 
            {
                set queryYear = groupYear - 1
                 ;---&sql(SELECT Count(*) into :iCount FROM HB_DRGCoreAlgorithmData WHERE FixmedinsCode=:hospCode AND DRG=:DRG AND (Year=:queryYear OR Year IS NULL OR Year=''))
                  ;--- ** SQL PUBLIC Variables: %ROWCOUNT, %ROWID, %msg, DRG, SQLCODE, hospCode, iCount, queryYear
                do %06o
                if (iCount = 0) 
                {
                    //上一年也无数据，回退到原查询模式（不过滤年份）
                    set queryYear = ""
                     ;---&sql(SELECT Count(*) into :iCount FROM HB_DRGCoreAlgorithmData WHERE FixmedinsCode=:hospCode AND DRG=:DRG)
                      ;--- ** SQL PUBLIC Variables: %ROWCOUNT, %ROWID, %msg, DRG, SQLCODE, hospCode, iCount
                    do %08o
                }
            }
	        //如果存在多条数据表示,当前医院存在多个算法配置,DRG医疗机构算法配置表数据确保完善 
	        if (iCount>1)
	        {
		        if (insuAreaDesc="市本级")
		        {
			        set mdtrtArea=$E(mdtrtareaAreaCode,1,4)_"00"     
			    }
			    elseif (insuAreaDesc="省直")
		        {
			        set mdtrtArea=$E(mdtrtareaAreaCode,1,2)_"9900"     
			    }
			    elseif (insuAreaDesc="异地")
		        {
			        set mdtrtArea=$E(mdtrtareaAreaCode,1,2)_"0000"     
			    }
                if (queryYear '= "") 
                {
                     ;---&sql(SELECT Points, PipValue, DGDOV, PayStandard into :points,:pipValue,:dgdov,:payStandard FROM HB_DRGCoreAlgorithmData 
                      ;---                         WHERE FixmedinsCode=:hospCode AND DRG=:DRG AND MdtrtArea=:mdtrtArea AND (Year=:queryYear OR Year IS NULL OR Year=''))
                      ;--- ** SQL PUBLIC Variables: %ROWCOUNT, %ROWID, %msg, DRG, SQLCODE, dgdov, hospCode, mdtrtArea, payStandard, pipValue, points, queryYear
                    do %0ao
                } 
                else 
                {
                     ;---&sql(SELECT Points, PipValue, DGDOV, PayStandard into :points,:pipValue,:dgdov,:payStandard FROM HB_DRGCoreAlgorithmData 
                      ;---                         WHERE FixmedinsCode=:hospCode AND DRG=:DRG AND MdtrtArea=:mdtrtArea)
                      ;--- ** SQL PUBLIC Variables: %ROWCOUNT, %ROWID, %msg, DRG, SQLCODE, dgdov, hospCode, mdtrtArea, payStandard, pipValue, points
                    do %0co
                }    			    
		    }
		    elseif (iCount=1) //只存在一条记录，表示当前医院市本级、省直、异地算法配置都一样,直接取市本级数据
		    {
			    set insuAreaDesc="市本级"
                if (queryYear '= "") 
                {
                     ;---&sql(SELECT Points, PipValue, DGDOV, PayStandard into :points,:pipValue,:dgdov,:payStandard FROM HB_DRGCoreAlgorithmData 
                      ;---                         WHERE FixmedinsCode=:hospCode AND DRG=:DRG AND (Year=:queryYear OR Year IS NULL OR Year=''))
                      ;--- ** SQL PUBLIC Variables: %ROWCOUNT, %ROWID, %msg, DRG, SQLCODE, dgdov, hospCode, payStandard, pipValue, points, queryYear
                    do %0eo
                } 
                else 
                {
                     ;---&sql(SELECT Points, PipValue, DGDOV, PayStandard into :points,:pipValue,:dgdov,:payStandard FROM HB_DRGCoreAlgorithmData 
                      ;---                         WHERE FixmedinsCode=:hospCode AND DRG=:DRG)
                      ;--- ** SQL PUBLIC Variables: %ROWCOUNT, %ROWID, %msg, DRG, SQLCODE, dgdov, hospCode, payStandard, pipValue, points
                    do %0go
                }
			}
			else //iCount=0 当前年份/上一年份均无匹配数据
			{
				set (points,pipValue,dgdov,payStandard)="0.00"
				set insuAreaDesc=""
				if (groupYear '= "") 
				{
					set insuAreaDesc="未维护【"_groupYear_"年】DRG分组数据"
				}
			}	        
		    if (payStandard="0.00")||(payStandard="")		    
		    {
			    set (points,pipValue,dgdov,payStandard)="0.00"
			}
			//continue:(payStandard ="0.00")||(payStandard ="")
            set jo={}
            set jo.hisHospCode = hisHospCode
            set jo.hospCode = hospCode
            set jo.hospName = hospName_"["_queryYear_"年"_insuAreaDesc_"DRG分组方案]"
            set jo.algorithm= insuAreaDesc
            set jo.policyType= policyType
            set jo.drg = DRG 
            set jo.drgDesc = DRGDesc                       
            set jo.points = points
            set jo.pipValue = pipValue
            set jo.dgdov = dgdov
            set jo.payStandard = payStandard                        
            set jo.totalCost = totalCost
            //差异率（相对差异） = （实际费用 - 预估费用） / 预估费用 × 100%                           
            if (payStandard="0.00")||(payStandard="")
            {
                set discrepancyRate = 100                    
                set discrepancyAmt = payStandard - totalCost
	        }
	        else
	        {
                set discrepancyRate = $FNUMBER(($ZABS(totalCost - payStandard)/payStandard)*100,"L",2)                       
                set discrepancyAmt = payStandard - totalCost   
		    }
            if (discrepancyAmt > 0)
            {
	            set jo.preProfit = $FNUMBER(discrepancyAmt,"L",2) //盈利
                set jo.preLoss = "0.00" //亏损
                set jo.profitLoss = "盈利"  
	        }
	        elseif (discrepancyAmt < 0)
	        {
	            set jo.preProfit = "0.00" //盈利
	            set jo.preLoss = $FNUMBER(discrepancyAmt,"L",2) //亏损 
	            set jo.profitLoss = "亏损"  
		    }
	        elseif (discrepancyAmt = 0)
	        {
	            set jo.preProfit = "0.00" //盈利
	            set jo.preLoss = "0.00" //亏损 
	            set jo.profitLoss = ""  
		    }
		    set jo.discrepancyRate = discrepancyRate //差异率%
		    set jo.groupPlanYear = queryYear //实际使用的分组方案年份
			do jaAlgorithm.%Push(jo)     	                                                                     
        }
        //第七步：封装返回值
		set DRG=joRtn.result.code
		set DRGDesc=joRtn.result.desc
		set resultObj = ..SetSuccessResult(DRG,DRGDesc)
		set joRtn={}
		set joRtn.mdc=MDC
		set joRtn.mdcDesc=MDCDesc
		set joRtn.complicationInfo=jaComplication
		set joRtn.drgInfo=jaDRG
		set joRtn.hospAlgorithmInfo=jaAlgorithm
		set joRtn.checkTime = $ZDATETIME($HOROLOG,3)
    	set resultObj={}
	    set resultObj.errorCode = "0"
	    set resultObj.errorMessage = ""
	    set resultObj.result = joRtn    
	    set resultObj.params = params
	    //第八步：分组成功插入分组记录表（已迁移至DeviceFeeWarning方法中处理）
	    //
	    // 注：原DeviceNew方法中直接插入分组记录的代码已废弃，
	    // 现在统一在DeviceFeeWarning(02010002)费用预警成功后调用SaveDRGGroupRecord(02010035)插入记录。
	    //
	}
    catch(e) 
    {
        // 7. 异常处理（增强：包含错误码+详细信息）
        set status = e.AsStatus()
        set errorCode = $piece(##class(%SYSTEM.Status).GetErrorCodes(status), ",")
        set errorMsg = $replace(##class(%SYSTEM.Status).GetErrorText(status,"cn"), "^", " ")
        set errorInfo = "DRG分组异常：类=" _ $ClassName() _ "，入参=" _ jsonObj.%ToJSON() _ "，错误：" _ errorMsg
        // 记录错误日志到数据库
        set errorLogID = ##class(src.Interface.Message).InsErrRecord("04000007", errorInfo, errorMsg)
        set resultObj = ..SetErrorResult("-99", "DRG分组异常(日志ID："_errorLogID_")："_errorMsg)
    }
    quit resultObj
 q
%02o n sqldata17d,sqldata18d,sqldata19d,sqldata20d,sqldata21d,sqldata22d,sqldata23d,sqldata25d,%sqltmp,%sqlpos,sqldata29d,sqldata30d,sqldata33d,sqldata36d,sqldata37d,sqldata40d,sqldata43d,sqldata44d,sqldata10d,sqldata14d,sqldata9d,sqldata12d,sqldata13d,sqldata1d,sqldata4d,sqldata15d,sqldata16d,sqldata2d,sqldata5d
 s $zt="%02err"
 n %sqltime s %sqltime=$zh
 s sqldata17d=$zu(115,2)
 s sqldata18d=0,sqldata19d="",sqldata20d=0,sqldata21d="",sqldata22d=0,sqldata23d=""
 d:$zu(115,15) $system.ECP.Sync()
 s sqldata10d=$g(hospCode)
 s SQLCODE=100
 s sqldata13d=$zu(28,sqldata10d,5)
 ; asl MOD# 2
 s sqldata14d=""
%02mBk1 s sqldata25d="" s sqldata14d=$o(^CBHospitalD(sqldata14d),1,sqldata25d)
 i sqldata14d="" g %02mBdun
 S sqldata9d=$lg(sqldata25d,11)
 s sqldata12d=$zu(28,sqldata9d,5)
 g:'(sqldata12d=sqldata13d) %02mBk1
 S sqldata1d=$lg(sqldata25d,8)
 S sqldata4d=$lg(sqldata25d,19)
 goto:sqldata17d'=1 %02mBuncommitted
 if sqldata17d=1 {
 	lock +^CBHospitalD($p(sqldata14d,"||",1))#"S":$zu(115,4)
 	if $t { set sqldata19d=$name(^CBHospitalD($p(sqldata14d,"||",1)))_"#""SI""",sqldata18d=1 }
 	else { s SQLCODE=-114,%msg="Unable to acquire shared lock on table SQLUser.CB_Hospital for RowID value: "_sqldata14d ztrap "LOCK"  }
 }
 ; asl MOD# 3
 s sqldata15d=$zlist(sqldata12d)
 i sqldata14d'="" s sqldata29d="" i $d(^CBHospitalD(sqldata14d),sqldata29d)
 e  g %02mCdun
 S $lg(,,,,,,,sqldata1d,,,sqldata9d,,,,,,,,sqldata4d)=sqldata29d
 s sqldata12d=$zu(28,sqldata9d,5)
 s sqldata16d=$zlist(sqldata12d)
 g:sqldata15d'=sqldata16d %02mCdun
%02mBuncommitted ;
 ; asl MOD# 4
 s sqldata30d=1
 s sqldata2d=sqldata1d
 i sqldata2d'="" s sqldata33d="" i $d(^CBCityD(sqldata2d),sqldata33d)
 e  g %02mDdun
 S mdtrtareaAreaCode=$lg(sqldata33d,3)
 i '(sqldata2d'="") g %02mDdun
 goto:sqldata17d'=1 %02mDuncommitted
 if sqldata17d=1 {
 	lock +^CBCityD($p(sqldata2d,"||",1))#"S":$zu(115,4)
 	if $t { set sqldata21d=$name(^CBCityD($p(sqldata2d,"||",1)))_"#""SI""",sqldata20d=1 }
 	else { s SQLCODE=-114,%msg="Unable to acquire shared lock on table SQLUser.CB_City for RowID value: "_sqldata2d ztrap "LOCK"  }
 }
 ; asl MOD# 5
 i sqldata2d'="" s sqldata36d="" i $d(^CBCityD(sqldata2d),sqldata36d)
 e  g %02mEdun
 S mdtrtareaAreaCode=$lg(sqldata36d,3)
%02mDuncommitted ;
 s sqldata30d=0
%02mEpdm ; asl MOD# 6
 s sqldata37d=1
 s sqldata5d=sqldata4d
 i sqldata5d'="" s sqldata40d="" i $d(^CBPolicyTypeD(sqldata5d),sqldata40d)
 e  g %02mFdun
 S policyType=$lg(sqldata40d,3)
 i '(sqldata5d'="") g %02mFdun
 goto:sqldata17d'=1 %02mFuncommitted
 if sqldata17d=1 {
 	lock +^CBPolicyTypeD($p(sqldata5d,"||",1))#"S":$zu(115,4)
 	if $t { set sqldata23d=$name(^CBPolicyTypeD($p(sqldata5d,"||",1)))_"#""SI""",sqldata22d=1 }
 	else { s SQLCODE=-114,%msg="Unable to acquire shared lock on table SQLUser.CB_PolicyType for RowID value: "_sqldata5d ztrap "LOCK"  }
 }
 ; asl MOD# 7
 i sqldata5d'="" s sqldata43d="" i $d(^CBPolicyTypeD(sqldata5d),sqldata43d)
 e  g %02mGdun
 S policyType=$lg(sqldata43d,3)
%02mFuncommitted ;
 s sqldata37d=0
%02mGpdm ; asl MOD# 8
 s SQLCODE=0 g %02c
%02mHdun g:sqldata37d %02mFpadun
%02mGdun if $g(sqldata17d)=1 { if $g(sqldata22d)=1 { l -@sqldata23d s sqldata22d=0 } elseif $g(sqldata22d)=2 { do $classmethod($li(sqldata23d),"%UnlockId",$li(sqldata23d,2),1,1)  s sqldata22d=0 }}
%02mFdun i sqldata37d {
 s policyType="",sqldata5d=""
 g %02mGpdm }
%02mFpadun g:sqldata30d %02mDpadun
%02mEdun if $g(sqldata17d)=1 { if $g(sqldata20d)=1 { l -@sqldata21d s sqldata20d=0 } elseif $g(sqldata20d)=2 { do $classmethod($li(sqldata21d),"%UnlockId",$li(sqldata21d,2),1,1)  s sqldata20d=0 }}
%02mDdun i sqldata30d {
 s mdtrtareaAreaCode="",sqldata2d=""
 g %02mEpdm }
%02mDpadun 
%02mCdun if $g(sqldata17d)=1 { if $g(sqldata18d)=1 { l -@sqldata19d s sqldata18d=0 } elseif $g(sqldata18d)=2 { do $classmethod($li(sqldata19d),"%UnlockId",$li(sqldata19d,2),1,1)  s sqldata18d=0 }}
 g %02mBk1
%02mBdun 
%02mAdun 
%02c set %ROWCOUNT='SQLCODE
 if $g(sqldata17d)=1 {
 	if $g(sqldata18d)=1 { l -@sqldata19d s sqldata18d=0 } elseif $g(sqldata18d)=2 { do $classmethod($li(sqldata19d),"%UnlockId",$li(sqldata19d,2),1,1)  s sqldata18d=0 }
 	if $g(sqldata20d)=1 { l -@sqldata21d s sqldata20d=0 } elseif $g(sqldata20d)=2 { do $classmethod($li(sqldata21d),"%UnlockId",$li(sqldata21d,2),1,1)  s sqldata20d=0 }
 	if $g(sqldata22d)=1 { l -@sqldata23d s sqldata22d=0 } elseif $g(sqldata22d)=2 { do $classmethod($li(sqldata23d),"%UnlockId",$li(sqldata23d,2),1,1)  s sqldata22d=0 }
 }
 n context,tmp,count,total,mean s context=$system.Context.SQL()
 if $d(%sqltime) { s %sqltime=$g(sqldata44d)+$zh-%sqltime
 if $g(context.Stats)<$zu(99) { d AggregateStats^%SYS.SQLSRV() }
 s tmp=$g(context.Stats($namespace,"idOu0Z8vWni7yMXv3yqtw6DsuaY="))
 s count=$lg(tmp,1),total=$lg(tmp,2),mean=total+%sqltime/(count+1)
 s context.Stats($namespace,"idOu0Z8vWni7yMXv3yqtw6DsuaY=")=$lb(count+1,total+%sqltime,$s(+count=0:0,1:(%sqltime-mean)**2+(count*((total/count-mean)**2+$lg(tmp,3)))/(count+1))) }
 q
%02err s $zt=""
 d SQLRunTimeError^%apiSQL($ze,.SQLCODE,.%msg)
 g %02c
%04o n sqldata23d,sqldata31d,sqldata34d,sqldata4d,sqldata6d,sqldata8d,sqldata13d,sqldata14d,sqldata11d,sqldata12d,sqldata21d,sqldata22d,sqldata19d,sqldata15d,sqldata20d
 s $zt="%04err"
 n %sqltime s %sqltime=$zh
 s sqldata23d=$zu(115,2)
 d:$zu(115,15) $system.ECP.Sync()
 s sqldata4d=$g(hospCode),sqldata6d=$g(DRG),sqldata8d=$g(groupYear)
 s SQLCODE=100
 k sqldata19d s:$zu(28,sqldata8d,7)'="" sqldata19d($zu(28,sqldata8d,7))="" s:$zu(28,$c(0),7)'="" sqldata19d($zu(28,$c(0),7))=""
 s sqldata12d=$zu(28,sqldata4d,7)
 s sqldata14d=$zu(28,sqldata6d,7)
