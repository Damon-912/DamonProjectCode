 d:$zu(115,15) $system.ECP.Sync()
 s sqldata6d=$g(adrgCode),sqldata8d=$g(oprnCode),sqldata10d=$g(oprnCode),sqldata12d=$g(oprnCode)
 s SQLCODE=100
 s sqldata26d=$i(^||%t)
