 goto:sqldata13d'=1 %0imBuncommitted
 if sqldata13d=1 {
 	lock +^CBHospitalD($p(sqldata10d,"||",1))#"S":$zu(115,4)
 	if $t { set sqldata15d=$name(^CBHospitalD($p(sqldata10d,"||",1)))_"#""SI""",sqldata14d=1 }
