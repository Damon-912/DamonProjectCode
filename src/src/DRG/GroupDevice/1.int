zSetErrorResult(errorCode,errorMsg)
	set resultObj={}
	set resultObj.errorCode= errorCode
	set resultObj.errorMessage= errorMsg
	set result={}
	set result.code=""
	set result.desc=""
	set result.checkTime= $ZDATETIME($HOROLOG,3)
    set resultObj.result= result
    quit resultObj
zSetJarraySuccessResult(jsonObj,iCount)
	set resultObj={}
	set resultObj.errorCode="0"
	set resultObj.errorMessage=""
    set resultObj.result=jsonObj
    set resultObj.totalCount=iCount
	//set resultObj.result.checkTime=$ZDATETIME($HOROLOG,3)
    quit resultObj
zSetSuccessResult(code,message)
	set resultObj={}
	set resultObj.errorCode="0"
	set resultObj.errorMessage=message
	set result={}
	set result.code=code
	set result.desc=message
	set result.checkTime=$ZDATETIME($HOROLOG,3)
    set resultObj.result=result
    quit resultObj
zSpecialGroupMatch(jsonObj)
	new (jsonObj)
	try {
		if (jsonObj = "") || (jsonObj.params = "") {
			set resultObj = ##class(%Library.DynamicObject).%New()
			set resultObj.errorCode = "-1"
			set resultObj.errorMessage = "入参异常：缺少params参数"
			quit
		}
		set params = jsonObj.params.%Get(0)
		; 构建 patientInfo
		set patientInfo = ##class(%Library.DynamicObject).%New()
		set patientInfo.mainDiagnosisCode = params.mainDiagnosisCode
		set patientInfo.diseInfo = params.diseInfo
		set patientInfo.oprnInfo = params.oprnInfo
		if ('$ISOBJECT(patientInfo.diseInfo)) set patientInfo.diseInfo = ##class(%Library.DynamicArray).%New()
		if ('$ISOBJECT(patientInfo.oprnInfo)) set patientInfo.oprnInfo = ##class(%Library.DynamicArray).%New()
		; 获取 hospInfo 数组
		set hospInfo = params.hospInfo
		if ('$ISOBJECT(hospInfo)) set hospInfo = ##class(%Library.DynamicArray).%New()
		set groupYear = params.groupYear
		; 调用引擎的循环匹配方法（自动遍历每家医院查询地区并匹配）
		set resultObj = ##class(src.DRG.SpecialGroupEngine).MatchByHospInfo(patientInfo, hospInfo, groupYear)
	} catch(e) {
		set status = e.AsStatus()
		set errorMsg = $replace(##class(%SYSTEM.Status).GetErrorText(status,"cn"), "^", " ")
		set resultObj = ##class(%Library.DynamicObject).%New()
		set resultObj.errorCode = "-99"
		set resultObj.errorMessage = "特异化分组匹配异常：" _ errorMsg
	}
	quit resultObj
zSplitCodes(codeStr)
	if (codeStr = "")
	{
		quit ""
	}
	// 将所有分隔符统一替换为英文逗号
	set normalized = $TRANSLATE(codeStr, "，;/+ ", ",,,,,,")
	set list = ""
	set count = $LENGTH(normalized, ",")
	for i = 1:1:count
	{
		set oneCode = $ZSTRIP($PIECE(normalized, ",", i), "<>W")
		if (oneCode '= "")
		{
			set list = list _ $LISTBUILD(oneCode)
		}
	}
	quit list
