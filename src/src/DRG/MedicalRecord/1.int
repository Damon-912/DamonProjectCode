		set dataObj.UpdateDate=$zd($h,3)
		set dataObj.HISReturn=paramsObj.%ToJSON()		
	    //diseinfo.疾病诊断信息
	    if (paramsObj.diseinfo '="")
	    {		    
		    set dataObj.DiseInfo=paramsObj.diseinfo.%ToJSON()
		    //保存患者疾病诊断信息表
	    	set diseInfoObj={}
