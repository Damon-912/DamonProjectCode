 }
 Quit $data(idlist(inner))
XMLImportAttrnode()
 If attributeList=node Quit
 Kill attributeList
 Set attributeList=node
 Set offset=29 While offset<$zwascii(nodelist,17) { Set attribute=$extract(nodelist,offset,offset+15)
