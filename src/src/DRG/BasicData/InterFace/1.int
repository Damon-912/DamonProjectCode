   If $extract(id)="#" {
     Set tmp=$select(@(tree)@("i",$extract(id,2,*))="":"",1:$piece(@(tree)@("i",$extract(id,2,*)),",",1)_","_$piece(@(tree)@("i",$extract(id,2,*)),",",2)) If tmp="" Goto XMLImportIdErr
     Set inner=tmp
