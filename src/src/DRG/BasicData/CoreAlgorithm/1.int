 }
 ; asl MOD# 3
 s sqldata20d=$zlist(sqldata7d,sqldata5d,sqldata14d,sqldata16d,sqldata18d)
 i existingID'="" s sqldata36d="" i $d(^HBDRGCoreAlgorithmDataD(existingID),sqldata36d)
 e  g %0CmCdun
 S $lg(,sqldata3d,,,,,,sqldata5d,sqldata7d,,,,,,,sqldata9d,,,,,,sqldata11d)=sqldata36d
