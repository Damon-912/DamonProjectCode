 g:sqldata20d'=sqldata21d %0CmCdun
%0CmBuncommitted ;
 s SQLCODE=0 g %0Cc
%0CmCdun if $g(sqldata22d)=1 { if $g(sqldata23d)=1 { l -@sqldata24d s sqldata23d=0 } elseif $g(sqldata23d)=2 { do $classmethod($li(sqldata24d),"%UnlockId",$li(sqldata24d,2),1,1)  s sqldata23d=0 }}
 g %0CmBk1
%0CmBdun 
%0CmAdun 
