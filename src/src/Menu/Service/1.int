 i 'SQLCODE { i $i(sqldata6d)'<sqldata7d { d:sqldata17d=1 ##class(User.CBGroupMenu).%SQLReleaseLock(sqldata3d) g %0kc }}
%0kmCdun d:sqldata17d=1 ##class(User.CBGroupMenu).%SQLReleaseLock(sqldata3d) g:SQLCODE<0 %0kc
