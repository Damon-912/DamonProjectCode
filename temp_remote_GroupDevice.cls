= \"1\") && ($GET(oprnItem.oprnSn) = \"1\")","\t\t\t\t    {","\t\t\t\t\t    set saveParams.mainOperationName = $GET(oprnItem.oprnName, \"\")","\t\t\t\t\t    quit","\t\t\t\t    }","\t\t\t    }","\t\t    }","\t\t    ","\t\t    // 构造SaveDRGGroupRecord接口入参","\t\t    set paramsArr = ##class(%DynamicArray).%New()","\t\t    do paramsArr.%Push(saveParams)","\t\t    set saveJsonObj = ##class(%DynamicObject).%New()","\t\t    set saveJsonObj.params = paramsArr","\t\t    ","\t\t    // 调用保存方法（不阻塞主流程）","\t\t    do ##class(src.DRG.GroupDevice).SaveDRGGroupRecord(saveJsonObj)","\t    }","\t    */","\t    \t","\t}","    catch(e) ","    {","        // 7. 异常处理（增强：包含错误码+详细信息）","        set status = e.AsStatus()","        set errorCode = $piece(##class(%SYSTEM.Status).GetErrorCodes(status), \",\")","        set errorMsg = $replace(##class(%SYSTEM.Status).GetErrorText(status,\"cn\"), \"^\", \" \")","        set errorInfo = \"DRG分组异常：类=\" _ $ClassName() _ \"，入参=\" _ jsonObj.%ToJSON() _ \"，错误：\" _ errorMsg","        ","        // 记录错误日志到数据库","        set errorLogID = ##class(src.Interface.Message).InsErrRecord(\"04000007\", errorInfo, errorMsg)","        set resultObj = ..SetErrorResult(\"-99\", \"DRG分组异常(日志ID：\"_errorLogID_\")：\"_errorMsg)","    }","","    quit resultObj","}","","/// Creator:     CM","/// CreatDate:   2026-01-01","/// Description: DRG分组器+费用预警","/// code:\t\t ","/// Input:{\"params\":[{\"\":\"\"}]}","/// Debug","ClassMethod DeviceFeeWarning(jsonObj As %Library.DynamicObject) As %Library.DynamicObject","{","\tnew (jsonObj)","\tset params = ##class(%DynamicArray).%New()\t","\ttry","\t{","        // 1. 初始化返回对象（标准化结构）","        set resultObj = ..SetSuccessResult(\"0\",\"\")","        ","        // 2. 参数合法性校验（核心前置检查）","        if (jsonObj = \"\") || (jsonObj.params = \"\") ","        {","            set resultObj = ..SetErrorResult(\"-1\", \"入参异常：缺少params参数或参数为空\")","            quit ","        }         ","        ","        //先获取分组结果","        set joDRGObj=..Device(jsonObj)","        if (joDRGObj.errorCode '=0)","        {","            set resultObj = ..SetErrorResult(\"-1\", \"DRG分组失败：\"_joDRGObj.errorMessage)","            quit   ","\t    }","\t    else","\t    {","\t\t    set params = jsonObj.params.%Get(0)","\t\t    //取DRG信息","            set drgParams = joDRGObj.result.drgInfo.%Get(0)","            set drgCode = drgParams.code","\t\t    set drgDesc = drgParams.desc","\t\t    ","\t\t    //取DRG算法信息","\t\t    set payParams = joDRGObj.result.hospAlgorithmInfo.%Get(0)","\t\t    set drgPayStandard=payParams.payStandard","\t\t    ","\t\t    //组织入参调用02010107费用预警接口服务","\t\t    set jsonObj.params.%Get(0).hisAdmId=params.hisAdmId","\t\t    set jsonObj.params.%Get(0).patientName=params.patientName","\t\t    set jsonObj.params.%Get(0).deptCode=params.deptCode","\t\t    set jsonObj.params.%Get(0).deptName=params.deptName","\t\t    set jsonObj.params.%Get(0).doctorCode=params.doctorCode","\t\t    set jsonObj.params.%Get(0).doctorName=params.doctorName","\t\t    set jsonObj.params.%Get(0).totalFee=params.totalFee","\t\t    set jsonObj.params.%Get(0).drgCode=drgCode","\t\t    set jsonObj.params.%Get(0).drgName=drgDesc","\t\t    set jsonObj.params.%Get(0).drgPayStandard=drgPayStandard","\t\t    set jsonObj.params.%Get(0).medicalRecordDr=params.medicalRecordDr","\t\t    set jsonObj.params.%Get(0).insuranceFee=params.insuranceFee","\t\t    set jsonObj.params.%Get(0).fixmedinsCode=params.fixmedinsCode\t\t    ","\t\t    set jsonObj.params.%Get(0).fixmedinsName=params.fixmedinsName","\t\t    set jsonObj.params.%Get(0).ruleType=params.ruleType\t\t    ","\t\t    \t\t    ","\t\t    set joRtn=##class(src.DRG.Warning).AddWarningRecord(jsonObj)\t","\t\t    if (joRtn.errorCode '=0) ","\t\t    {","                set resultObj = ..SetErrorResult(\"-1\", \"DRG分组结果费用预警失败：DRG分组【\"_drgCode_\"：\"_drgDesc_\"】\"_joRtn.errorMessage)","                quit   ","\t\t\t}   ","\t\t\telse","\t\t\t{","\t\t\t    set joWarningFee= []","\t\t\t    set joWarningFee= joRtn.result","\t\t\t    set joDRGObj.result.feeWarningInfo=joWarningFee\t\t\t\t\t   ","\t            set resultObj = joDRGObj\t\t\t    \t    ","\t\t\t}\t    \t\t    \t\t    ","\t\t}\t\t\t\t","\t}","    catch(e)","    {","        set status = e.AsStatus()","        set errorCode = $piece(##class(%SYSTEM.Status).GetErrorCodes(status), \",\")","        set errorMsg = $replace(##class(%SYSTEM.Status).GetErrorText(status,\"cn\"), \"^\", \" \")","        set errorInfo = \"DRG分组结果费用预警异常：类=\" _ $ClassName() _ \"，错误：\" _ errorMsg","        ","        // 记录错误日志","        set errorLogID = ##class(src.Interface.Message).InsErrRecord(\"02010035\", errorInfo, errorMsg)","        set resultObj.errorCode = \"-99\"","        set resultObj.errorMessage = \"DRG分组结果费用预警异常（日志ID：\"_errorLogID_\"）：\"_errorMsg","    }","    ","    quit resultObj","}","","/// Creator:     CM","/// CreatDate:   2026-01-01","/// Description: DIP分组分值查询 - 通过主诊断和主手术模糊匹配DIP算法配置表，支持行政区划代码和医疗机构关联省市筛选","/// code:\t\t 02010003","/// Input:{\"params\":[{\"mainDiagnosisCode\":\"\",\"mainOperationCode\":\"\",\"mdtrtArea\":\"\",\"fixmedinsCode\":\"\",\"fixmedinsName\":\"\"}]}","/// Debug","ClassMethod GetDIPGroupScore(jsonObj As %Library.DynamicObject) As %Library.DynamicObject","{","\tnew (jsonObj)","\tset params = ##class(%DynamicArray).%New()","\ttry","\t{","\t    // 1. 初始化返回对象","\t    set resultObj = ..SetSuccessResult(\"0\",\"\")","\t    ","\t    // 2. 参数合法性校验","\t    if (jsonObj = \"\") || (jsonObj.params = \"\")","\t    {","\t        set resultObj = ..SetErrorResult(\"-1\", \"入参异常：缺少params参数或参数为空\")","\t        quit","\t    }","\t    ","\t    // 3. 提取入参","\t    set params = jsonObj.params.%Get(0)","\t    set mainDiagCode = params.mainDiagnosisCode   // 主诊断代码（必填）","\t    set mainDiagName = params.mainDiagnosisName   // 主诊断名称\t    \t    \t    ","\t    set mainOpCode = params.mainOperationCode     // 主手术代码（选填）","\t    set mainOpName = params.mainOperationName     // 主手术名称\t    ","\t    set secOpCode = params.secondOperationCode     // 次要手术代码（选填）","\t    set secOpName = params.secondOperationName     // 次要手术名称\t \t   \t       \t    ","\t    set mdtrtArea = params.mdtrtArea              // 行政区划代码（选填）\t   ","\t    set fixmedinsCode = params.fixmedinsCode      // 医疗机构代码（选填）","\t    set fixmedinsName = params.fixmedinsName      // 医疗机构名称（选填）","\t    set groupYear = params.groupYear             // 分组方案年份（选填，默认当前年份）","\t    if (groupYear = \"\") set groupYear = $PIECE($ZDATE($HOROLOG,3),\"-\",1)","\t    ","\t    // 4. 必填项校验","\t    if (mainDiagCode = \"\")","\t    {","\t        set resultObj = ..SetErrorResult(\"-1\", \"主诊断不能为空！\")","\t        quit","\t    }","\t    ","\t    // 5. 行政区划代码和医疗机构代码/名称不能同时为空","\t    if (mdtrtArea = \"\") && (fixmedinsCode = \"\") && (fixmedinsName = \"\")","\t    {","\t        set resultObj = ..SetErrorResult(\"-1\", \"行政区划代码和医疗机构代码/名称不能同时为空！\")","\t        quit","\t    }","\t    ","\t    // 6. 医疗机构关联查询：通过CB_Hospital获取省市ID","\t    set (provID, cityID) = \"\"","\t    if (fixmedinsCode '= \"\")","\t    {","\t        // 优先使用医疗机构代码精确查询","\t        &sql(SELECT ProvID_Dr, CityID_Dr INTO :provID, :cityID FROM CB_Hospital WHERE OrganizationCode = :fixmedinsCode)","\t        if (SQLCODE '= 0) || (provID = \"\")","\t        {","\t            set resultObj = ..SetErrorResult(\"-1\", \"未找到对应医疗机构信息！\")","\t            quit","\t        }","\t    }","\t    elseif (fixmedinsName '= \"\")","\t    {","\t        // 医疗机构代码为空时，通过名称模糊查询（取第一条）","\t        &sql(SELECT TOP 1 ProvID_Dr, CityID_Dr INTO :provID, :cityID FROM CB_Hospital WHERE Descripts LIKE '%'_:fixmedinsName_'%')","\t        if (SQLCODE '= 0) || (provID = \"\")","\t        {","\t            set resultObj = ..SetErrorResult(\"-1\", \"未找到对应医疗机构信息！\")","\t            quit","\t        }","\t    }","\t    ","\t    // 7. 将入参编码拆分为列表（用于后续匹配）","\t    set diagCodeList = ..SplitCodes(mainDiagCode)","\t    set mainOpCodeList = \"\"","\t    set secOpCodeList = \"\"","\t    if (mainOpCode '= \"\")","\t    {","\t        set mainOpCodeList = ..SplitCodes(mainOpCode)","\t    }","\t    if (secOpCode '= \"\")","\t    {","\t        set secOpCodeList = ..SplitCodes(secOpCode)","\t    }","\t    ","\t    // 8. 构建动态SQL查询DIP算法配置数据","\t    //    使用宽松筛选：只要表中字段包含任意一个入参编码即可命中","\t    set sql = \" SELECT ID, PrincipalDiagnosis, PrincipalDiagnosisName,\"","\t            _ \" MajorProcedure, MajorProcedureName,\"","\t            _ \" SecondaryProcedure, SecondaryProcedureName,\"","\t            _ \" Province_Dr AS ProvinceID, Province_Dr->Descripts AS ProvinceDesc,\"","\t            _ \" City_Dr AS CityID, City_Dr->Descripts AS CityDesc,\"","\t            _ \" MdtrtArea, MedinsLv,\"","\t            _ \" ScoreValue, AdjustCoefficient,\"","\t            _ \" PrimaryAdjustCoefficient, SecondaryAdjustCoefficient, ThirdAdjustCoefficient,\"","\t            _ \" AverageCost\"","\t            _ \" FROM HB_DIPCoreAlgorithmData WHERE 1=1\"","\t    ","\t    // 主诊断匹配 - 每个输入编码独立做 INSTR 匹配，OR 组合（宽松筛选）","\t    set sql = sql _ ..BuildMultiCodeWhere(\"PrincipalDiagnosis\", diagCodeList)","\t    ","\t    // 主手术匹配 - 选填","\t    if (mainOpCodeList '= \"\")","\t    {","\t        set sql = sql _ ..BuildMultiCodeWhere(\"MajorProcedure\", mainOpCodeList)","\t    }","\t    ","\t    // 次要手术匹配 - 选填","\t    if (secOpCodeList '= \"\")","\t    {","\t        set sql = sql _ ..BuildMultiCodeWhere(\"SecondaryProcedure\", secOpCodeList)","\t    }","","\t    // 行政区划代码 - 等值匹配","\t    if (mdtrtArea '= \"\")","\t    {","\t        set sql = sql _ \" AND MdtrtArea = \"_mdtrtArea","\t    }","\t    ","    // 省市条件 - 通过医疗机构关联获取","    if (provID '= \"\")","    {","        set sql = sql _ \" AND Province_Dr = \"_provID","    }","    if (cityID '= \"\")","    {","        set sql = sql _ \" AND City_Dr = \"_cityID","    }","    ","    // 年份过滤：优先查当前年份，无数据回退上一年（兼容Year为空的存量数据）","    set queryYear = groupYear","    set yearCondition = \" AND (Year='\"_queryYear_\"' OR Year IS NULL OR Year='')\"","    set sqlYear = sql _ yearCondition _ \" ORDER BY ID DESC\"","    ","    //先查当前年份","    set sqlObj=##class(%SQL.Statement).%New(1)","    set sc=sqlObj.%Prepare(sqlYear)","    set rs=sqlObj.%Execute()","    ","    // 如果当前年份无数据，尝试回退到上一年","    if ('rs.%Next(sc))","    {","        set queryYear = groupYear - 1","        set yearCondition = \" AND (Year='\"_queryYear_\"' OR Year IS NULL OR Year='')\"","        set sqlYear = sql _ yearCondition _ \" ORDER BY ID DESC\"","        set sc=sqlObj.%Prepare(sqlYear)","        set rs=sqlObj.%Execute()","        ","        // 上一年也无数据，回退到不过滤年份","        if ('rs.%Next(sc))","        {","            set sqlYear = sql _ \" ORDER BY ID DESC\"","            set sc=sqlObj.%Prepare(sqlYear)","            set rs=sqlObj.%Execute()","        }","        else","        {","            // 回退到上一年的第一条数据，重置游标","            set sc=sqlObj.%Prepare(sqlYear)","            set rs=sqlObj.%Execute()","        }","    }","    ","    // 9. 执行查询并对每条候选记录进行匹配度评分，保留最高分记录","    set rows = ##class(%DynamicArray).%New()","    set bestScore = -1","    set bestRow = \"\"","    set (dipCode,dipDesc)=\"\"","\t\twhile rs.%Next(sc)","\t    {","\t        set storedDiag = rs.%Get(\"PrincipalDiagnosis\")","\t        set storedMajorProc = rs.%Get(\"MajorProcedure\")","\t        set storedSecProc = rs.%Get(\"SecondaryProcedure\")","\t        ","\t        // 计算匹配得分（权重：主诊断 > 主手术 > 次要手术）","\t        set (diagMatch, opMatch, secMatch) = 0","\t        set diagMatch = ..CountCodeMatches(diagCodeList, storedDiag)","\t        set score = diagMatch * 100","\t        ","\t        if (mainOpCodeList '= \"\")","\t        {","\t            set opMatch = ..CountCodeMatches(mainOpCodeList, storedMajorProc)","\t            set score = score + opMatch * 50","\t        }","\t        ","\t        if (secOpCodeList '= \"\")","\t        {","\t            set secMatch = ..CountCodeMatches(secOpCodeList, storedSecProc)","\t            set score = score + secMatch * 30","\t        }","\t        ","\t        // 精度惩罚：存储字段中多余的编码数（优先返回与入参最贴近的记录）","\t        set extraPenalty = 0","\t        if (diagMatch > 0)","\t        {","\t            set storedDiagCount = $LISTLENGTH(..SplitCodes(storedDiag))","\t            if (storedDiagCount > diagMatch)","\t            {","\t                set extraPenalty = extraPenalty + (storedDiagCount - diagMatch) * 5","\t            }","\t        }","\t        if (opMatch > 0)","\t        {","\t            set storedOpCount = $LISTLENGTH(..SplitCodes(storedMajorProc))","\t            if (storedOpCount > opMatch)","\t            {","\t                set extraPenalty = extraPenalty + (storedOpCount - opMatch) * 3","\t            }","\t        }","\t        if (secMatch > 0)","\t        {","\t            set storedSecCount = $LISTLENGTH(..SplitCodes(storedSecProc))","\t            if (storedSecCount > secMatch)","\t            {","\t                set extraPenalty = extraPenalty + (storedSecCount - secMatch) * 2","\t            }","\t        }","\t        set score = score - extraPenalty","\t        ","\t        // 只保留得分最高的记录","\t        if (score > bestScore)","\t        {","\t\t        set dipCode = storedDiag_\"+\"_storedMajorProc","\t\t        set dipDesc = rs.%Get(\"PrincipalDiagnosisName\")_\"+\"_rs.%Get(\"MajorProcedureName\")","\t\t        ","\t            set bestScore = score","\t            set dataObj = {}","\t            set dataObj.id = rs.%Get(\"ID\")","\t            set dataObj.dipCode = dipCode","\t            set dataObj.dipDesc = dipDesc","\t            set dataObj.principalDiagnosis = storedDiag","\t            set dataObj.principalDiagnosisName = rs.%Get(\"PrincipalDiagnosisName\")","\t            set dataObj.majorProcedure = storedMajorProc","\t            set dataObj.majorProcedureName = rs.%Get(\"MajorProcedureName\")","\t            set dataObj.secondaryProcedure = storedSecProc","\t            set dataObj.secondaryProcedureName = rs.%Get(\"SecondaryProcedureName\")","\t            set dataObj.provinceID = rs.%Get(\"ProvinceID\")","\t            set dataObj.provinceDesc = rs.%Get(\"ProvinceDesc\")","\t            set dataObj.cityID = rs.%Get(\"CityID\")","\t            set dataObj.cityDesc = rs.%Get(\"CityDesc\")","\t            set dataObj.mdtrtArea = rs.%Get(\"MdtrtArea\")","\t            set dataObj.medinsLv = rs.%Get(\"MedinsLv\")","\t            set dataObj.scoreValue = rs.%Get(\"ScoreValue\")","\t            set dataObj.adjustCoefficient = rs.%Get(\"AdjustCoefficient\")","\t            set dataObj.primaryAdjustCoefficient = rs.%Get(\"PrimaryAdjustCoefficient\")","\t            set dataObj.secondaryAdjustCoefficient = rs.%Get(\"SecondaryAdjustCoefficient\")","\t            set dataObj.thirdAdjustCoefficient = rs.%Get(\"ThirdAdjustCoefficient\")","\t            set dataObj.averageCost = rs.%Get(\"AverageCost\")","\t            set dataObj.groupPlanYear = queryYear //实际使用的分组方案年份","\t            set dataObj.checkTime = $ZDATETIME($HOROLOG,3)","\t            set bestRow = dataObj","\t        }","\t    }","\t    ","\t    // 10. 封装返回结果 - 仅返回最佳匹配的一条记录","\t    if (bestRow '= \"\")","\t    {","\t        do rows.%Push(bestRow)","\t        set totalCount = 1","\t    }","\t    else","\t    {","\t        set totalCount = 0","\t    }\t   ","\t    ","\t    set jo={}","\t    set jo.dipCode = dipCode","\t    set jo.dipDesc = dipDesc","\t    set jo.checkTime=$ZDATETIME($HOROLOG,3)\t","\t    set jo.dipInfo=rows","\t","\t    set resultObj={}","\t    set resultObj.errorCode=\"0\"","\t    set resultObj.errorMessage=\"\"","        set resultObj.result=jo","        set resultObj.totalCount=totalCount","        ","        // set resultObj = ..SetJarraySuccessResult(rows, totalCount)","\t}","\tcatch(e)","\t{","\t    // 异常处理","\t    set status = e.AsStatus()","\t    set errorCode = $piece(##class(%SYSTEM.Status).GetErrorCodes(status), \",\")","\t    set errorMsg = $replace(##class(%SYSTEM.Status).GetErrorText(status, \"cn\"), \"^\", \" \")","\t    set errorInfo = \"DIP分组分值查询异常：类=\" _ $ClassName() _ \"，入参=\" _ jsonObj.%ToJSON() _ \"，错误：\" _ errorMsg","\t    ","\t    // 记录错误日志","\t    set errorLogID = ##class(src.Interface.Message).InsErrRecord(\"04000007\", errorInfo, errorMsg)","\t    set resultObj = ..SetErrorResult(\"-99\", \"DIP分组分值查询异常（日志ID：\"_errorLogID_\"）：\"_errorMsg)","\t}","\t","\tquit resultObj","}","","/// Creator:     System","/// CreatDate:   2026-03-22","/// Description: 保存DRG分组记录（优化版 - 使用独立字段存储）","/// Table:       BS_DRGGroupRecord (User.BSDRGGroupRecord)","/// Code:        02010035","/// Input:       {\"params\":[{\"admID\":\"\",\"medcasNo\":\"\",\"patientName\":\"\",\"psnNo\":\"\",\"insuranceAreaCode\":\"\",\"insuType\":\"\",\"sex\":\"\",\"age\":\"\",\"mainDiagnosisCode\":\"\",\"mainDiagnosisName\":\"\",\"diaTypeCode\":\"\",\"diagnosisCode\":\"\",\"diagnosisName\":\"\",\"mainOperationCode\":\"\",\"mainOperationName\":\"\",\"department\":\"\",\"departmentDesc\":\"\",\"drg\":\"\",\"drgDesc\":\"\",\"weight\":\"\",\"benchmarkCost\":\"\",\"ccFlag\":\"\",\"mccFlag\":\"\",\"riskLevel\":\"\",\"groupTime\":\"\",\"fixmedinsCode\":\"\",\"fixmedinsName\":\"\",\"groupStage\":\"\",\"admDateTime\":\"\",\"discgDateTime\":\"\",\"settleDateTime\":\"\",\"remark\":\"\"}]}","/// Output:      {\"errorCode\":\"0\",\"errorMessage\":\"\",\"result\":{\"id\":123}}","ClassMethod SaveDRGGroupRecord(jsonObj As %Library.DynamicObject) As %Library.DynamicObject","{","\tnew (jsonObj)","\tset params = ##class(%DynamicArray).%New()\t","    try","    {","        // 1. 初始化返回对象（标准化结构）","        set resultObj = ..SetSuccessResult(\"0\",\"\")","        ","        // 2. 参数合法性校验（核心前置检查）","        if (jsonObj = \"\") || (jsonObj.params = \"\") ","        {","            set resultObj = ..SetErrorResult(\"-1\", \"入参异常：缺少params参数或参数为空\")","            quit ","        } \t    \t    \t    ","        ","        // 3. 获取入参","        set params = jsonObj.params.%Get(0)","        set admID = $GET(params.admID, \"\")","        set medcasNo = $GET(params.medcasNo, \"\")           // 病案号","        set patientName = $GET(params.patientName, \"\")","        set psnNo = $GET(params.psnNo, \"\")                 // 医保个人编号","        set insuranceAreaCode = $GET(params.insuranceAreaCode, \"\")  // 参保地","        set mdtrtareaAreaCode = $GET(params.mdtrtareaAreaCode, \"\")  // 就医地","        ","        set insuType = $GET(params.insuType, \"\")            // 医保险种","        set sex = $GET(params.sex, \"\")","        set age = $GET(params.age, \"\")","        set mainDiagnosisCode = $GET(params.mainDiagnosisCode, \"\")","        set mainDiagnosisName = $GET(params.mainDiagnosisName, \"\")","        set diaTypeCode = $GET(params.diaTypeCode, \"\")      // 主诊断类型编码","        set diagnosisCode = $GET(params.diagnosisCode, \"\")  // 病种编码","        set diagnosisName = $GET(params.diagnosisName, \"\")  // 病种名称","        set mainOperationCode = $GET(params.mainOperationCode, \"\")","        set mainOperationName = $GET(params.mainOperationName, \"\")","        set department = $GET(params.department, \"\")","        set departmentDesc = $GET(params.departmentDesc, \"\")  // 科室名称","        set drg = $GET(params.drg, \"\")","        set drgDesc = $GET(params.drgDesc, \"\")","        set weight = $GET(params.weight, \"\")","        set benchmarkCost = $GET(params.benchmarkCost, \"\")","        set ccFlag = $GET(params.ccFlag, \"0\")","        set mccFlag = $GET(params.mccFlag, \"0\")","        set riskLevel = $GET(params.riskLevel, \"低\")","        set groupTime = $GET(params.groupTime, \"\")","        set fixmedinsCode = $GET(params.fixmedinsCode, \"\")","        set fixmedinsName = $GET(params.fixmedinsName, \"\")","        set groupStage = $GET(params.groupStage, \"1\")      // 分组阶段 默认事前","        set admDateTime = $GET(params.admDateTime, \"\")        // 入院时间","        set discgDateTime = $GET(params.discgDateTime, \"\")    // 出院时间","        set settleDateTime = $GET(params.settleDateTime, \"\")  // 结算时间","        set remark = $GET(params.remark, \"\")                // 备注","        ","        // 4. 必填项校验","        if (admID = \"\")","  