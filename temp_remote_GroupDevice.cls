uccessResult(rows,1)                \t                      ","    } ","    catch(e) ","    {","        // 7. 异常处理（增强：包含错误码+详细信息）","        set status = e.AsStatus()","        set errorCode = $piece(##class(%SYSTEM.Status).GetErrorCodes(status), \",\")","        set errorMsg = $replace(##class(%SYSTEM.Status).GetErrorText(status,\"cn\"), \"^\", \" \")","        set errorInfo = \"ADRG核心诊断相关分组异常：类=\" _ $ClassName() _ \"，入参=\" _ jsonObj.%ToJSON() _ \"，错误：\" _ errorMsg","        ","        // 记录错误日志到数据库","        set errorLogID = ##class(src.Interface.Message).InsErrRecord(\"04000007\", errorInfo, errorMsg)","        set resultObj = ..SetErrorResult(\"-99\", \"ADRG核心诊断相关分组异常(日志ID：\"_errorLogID_\")：\"_errorMsg)","    }","","    quit resultObj","}","","/// Creator:     CM","/// CreatDate:   2026-01-01","/// Description: 第三步：并发症确认CC/MCC","/// code:\t\t ","/// Input:{\"params\":[{\"\":\"\"}]}","/// Debug：","ClassMethod GroupComplication(jsonObj As %Library.DynamicObject) As %Library.DynamicObject","{","    //DRG分组器的核心逻辑是：如果患者同时患有多个次要诊断（其他诊断），其中只要存在一个被定义为MCC的诊断，那么该病例在“并发症与合并症”的层级上，","    //就直接被归类为 MCC层。即使病历中同时包含10个CC和1个MCC，分组结果依然是 MCC。","    //只有当一个MCC都没有，但存在至少一个CC时，才会被归为 CC层\t","","\ttry","\t{","        // 1. 初始化返回对象（标准化结构）","        set resultObj = ..SetSuccessResult(\"0\",\"\")","        ","        // 2. 参数合法性校验（核心前置检查）","        if (jsonObj = \"\") || (jsonObj.params = \"\") ","        {","            set resultObj = ..SetErrorResult(\"-1\", \"入参异常：缺少params参数或参数为空\")","            quit ","        }\t    ","        // 3. 提取入参并设置默认值（避免空值报错）","        set params = jsonObj.params.%Get(0)","        set mainDiagCode = params.mainDiagnosisCode  //主诊断代码         ","        set diseinfo = params.diseInfo //诊断数组对象","        ","        set rows=[],iCount=0","        ","        //其他诊断 + 手术或操作2\t\t        \t","        for j=0:1:diseinfo.%Size()-1 ","        {","            // 获取诊断编码和名称                  ","            set item = diseinfo.%Get(j)","            set mainFlag = item.mainFlag","            set diagSn = item.diagSn","            set diagCode = item.diagCode","            set diagName = item.diagName","                        \t                    \t                                                       ","            if (mainFlag '=\"1\") //其他诊断","            {","                //存在不作为分组规则疾病诊断表中","                if (..CheckNoRulesList(diagCode)>0)","                {","\t                 continue","\t            }","\t            //存在合并症或并发症排除列表中","\t            elseif (..CheckNoComplicationList(diagCode)>0)","                {","\t                 continue","\t            }","\t            else","\t            {","\t                set (levelA,levelB)=0\t\t\t        \t    ","\t                set (complication,complicationDesc)=\"\"","\t                &sql(SELECT SUM(CASE WHEN HBDictionaries_Dr->InsuCode = 'MCC' THEN 1 ELSE 0 END),","                                SUM(CASE WHEN HBDictionaries_Dr->InsuCode = 'CC' THEN 1 ELSE 0 END)","                         INTO :levelA, :levelB FROM HB_DRGBasicDataSub ","                         WHERE Code = :diagCode)\t","                                ","                    // 如果SQL执行成功且有结果","                    if (SQLCODE = 0)","                    {\t\t\t\t\t\t                ","                        // 确定并发症等级（MCC 优先级高于 CC）","                        If (levelA > 0) ","                        {","                            Set complication = \"MCC\"","                            Set complicationDesc = \"严重并发症\"","                        } ","                        elseIf (levelB > 0) ","                        {","                            Set complication = \"CC\"","                            Set complicationDesc = \"并发症\"","                        }","                        ","                        //存在MCC情况下直接抛出","                        if (complication = \"MCC\")","                        {","                            set row={}","                            set row.diagCode = diagCode","                            set row.diagName = diagName  ","                            set row.complication= complication","                            set row.complicationDesc= complicationDesc                 ","                            do rows.%Push(row)                             ","                            set iCount =1   ","                            ","                            quit","\t                    }","\t                    //说明每一个其他诊断是否存在CC/MCC","\t                    elseif (complication = \"CC\")","\t                    {","                            set row={}","                            set row.diagCode = diagCode","                            set row.diagName = diagName  ","                            set row.complication= complication","                            set row.complicationDesc= complicationDesc                 ","                            do rows.%Push(row)","            ","                            set iCount = iCount+1       ","\t\t                }                                                                                   \t\t\t\t          ","                    }    ","\t\t         }\t                        \t                        ","\t        }                                                \t                    \t                                              ","        }        ","        ","        set resultObj=..SetJarraySuccessResult(rows,iCount)\t                                                                               ","\t}","    catch(e) ","    {","        // 7. 异常处理（增强：包含错误码+详细信息）","        set status = e.AsStatus()","        set errorCode = $piece(##class(%SYSTEM.Status).GetErrorCodes(status), \",\")","        set errorMsg = $replace(##class(%SYSTEM.Status).GetErrorText(status,\"cn\"), \"^\", \" \")","        set errorInfo = \"确认并发症CC/MCC异常：类=\" _ $ClassName() _ \"，入参=\" _ jsonObj.%ToJSON() _ \"，错误：\" _ errorMsg","        ","        // 记录错误日志到数据库","        set errorLogID = ##class(src.Interface.Message).InsErrRecord(\"04000007\", errorInfo, errorMsg)","        set resultObj = ..SetErrorResult(\"-99\", \"确认并发症CC/MCC异常（日志ID：\"_errorLogID_\")：\"_errorMsg)","    }","","    quit resultObj","}","","/// Creator:     CM","/// CreatDate:   2026-01-01","/// Description: 第四步：DRG分组","/// code:\t\t ","/// Input:{\"params\":[{\"\":\"\"}]}","/// Debug：","ClassMethod GroupDRG(jsonObj As %Library.DynamicObject) As %Library.DynamicObject","{","    ///第4位：表示并发症或其他信息，使用阿拉伯数字（0-9），标记病情复杂程度：","    ///1=表示伴有严重并发症与合并症","    ///3=表示伴有一般并发症与合并症","    ///5=表示不伴有并发症与合并症","    ///7=表示死亡或转院","    ///0=表示小于 17 岁组，儿童病例（<17岁）","    ///9=表示未作区分的情况","    ///QY=歧义（QY）组，指与主要诊断无关的手术病例组，可在多个MDC中出现，检查病例的主要诊断和主要手术/操作是否匹配，如果二者在临床逻辑上不匹配，或者不在同一个主要诊断大类（MDC）里，这个病例就会被判定为“歧义”，送入QY组","    ///0000=指由于疾病诊断编码不规范等原因导致的不能正常入组的病例进入的组。","    ///其他数字表示其他需单独分组的情况。","    ","    //离院方式 1医嘱离院;2医嘱转院;3医嘱转社区卫生服务机构/乡镇卫生院;4非医嘱离院;5死亡;9其他。","    //具体作用节点：","    //分组器逻辑节点：分组器在完成MDC(主要诊断大类)和ADRG(核心组)划分后，在根据年龄、并发症/合并症(CC/MCC)进行细分的同时或之后，读取“离院方式”字段。","    //特定分组干预：代码2(医嘱转院)和4(非医嘱离院)在DRG分组中会被特别标记","    //如果离院方式为“医嘱转院”或“医嘱转社区卫生服务机构”，部分地区或特定分组器会将其划入“转院组”或影响费用消耗指数的计算。","    //如果离院方式为“非医嘱离院”，在计算时间消耗指数或费用消耗指数时，该病例可能被标记为“非正常离院”，在绩效评价或支付调整中予以区分。","    //如果离院方式为“死亡”，在分组时会进入特定的“死亡组”（通常权重较高），且会触发“低风险死亡率”的质控指标计算。    ","                ","\tnew (jsonObj)","\tset params = ##class(%DynamicArray).%New()     \t","\ttry","\t{","        // 1. 初始化返回对象（标准化结构）","        set resultObj = ..SetSuccessResult(\"0\",\"\")","        ","        // 2. 参数合法性校验（核心前置检查）","        if (jsonObj = \"\") || (jsonObj.params = \"\") ","        {","            set resultObj = ..SetErrorResult(\"-1\", \"入参异常：缺少params参数或参数为空\")","            quit ","        }\t    ","        // 3. 提取入参并设置默认值（避免空值报错）","        set params = jsonObj.params.%Get(0)","        set adrgCode = params.adrg  // ADRG代码","        set adrgInfo = params.adrgInfo // ADRG数组对象","        set hospInfo = params.hospInfo  // 医疗机构-数组对象  ","        set complication = params.complication  // 并发症 CC/MCC        ","        set complicationInfo = params.complicationInfo  // 并发症 CC/MCC        ","\t\tset mainDiagCode = params.mainDiagnosisCode  // 主诊断代码","\t\tset mainOpCode = params.mainOperationCode    // 主手术代码","        set diseinfo = params.diseInfo  // 疾病诊断-数组对象   ","    \tset oprninfo = params.oprnInfo  // 手术操作-数组对象\t\t","\t\t","        set age = params.age                         // 年龄(默认0)\t","        set dischargeType = params.dischargeType     //离院方式\t","        ","\t\t//分组方案年份（由前端传入，默认当前年份）","\t\tset groupYear = params.groupYear","\t\tif (groupYear = \"\") set groupYear = $PIECE($ZDATE($HOROLOG,3),\"-\",1)","","    \t// 如果为空字符串或非数组，设置为空数组","    \tif (diseinfo = \"\") || ('$ISOBJECT(diseinfo)) set diseinfo = []","    \tif (oprninfo = \"\") || ('$ISOBJECT(oprninfo)) set oprninfo = []                ","        if (hospInfo = \"\") || ('$ISOBJECT(hospInfo)) set hospInfo = []","\t\t\t\t\t\t","\t\t//遍历并发症信息-MCC覆盖CC","\t\tfor i = 0:1:complicationInfo.%Size()-1 ","\t\t{","            set item = complicationInfo.%Get(i)","            set diagCode = item.diagCode","            set diagName = item.diagName                 ","            set complicationDesc = item.complicationDesc","            set complication=item.complication  ","                ","            quit:(complication=\"MCC\")\t\t","\t\t}","\t\t","        set rows = []","        set iCount=0","        // 遍历 result 数组","        for i = 0:1:adrgInfo.%Size()-1 ","        {","            set item = adrgInfo.%Get(i)","            set adrgCode = item.code","            set adrgDesc = item.desc"," ","\t\t    set num=\"9\"","\t\t    if (age>=17)","\t\t    {","\t\t        if (complication=\"CC\")","\t\t        {","\t\t            set num=\"3\"\t\t    \t","\t    \t    }","\t\t        elseif (complication=\"MCC\")","\t    \t    {","\t\t            set num=\"1\"    \t","\t    \t    }","\t    \t    elseif (complication=\"\")&&(iCount>0)","\t\t        {","\t\t            set num=\"9\"\t","\t\t        }\t    \t    ","\t    \t    elseif (complication=\"\")","\t\t        {","\t\t            set num=\"5\"\t\t    \t","\t\t        }\t","\t    \t}","\t\t    else","\t\t    {","\t\t        set num=\"0\"\t\t\t","\t\t    }","\t\t    \t\t    ","\t\t    //判断离院方式","\t\t    if (dischargeType=\"2\")||(dischargeType=\"5\")","\t\t    {","\t\t\t    set num=\"7\"\t","\t\t\t}","\t\t\t","\t\t\tset drg =adrgCode_num","\t\t\tset desc=..GetComplicationDesc(num)\t","\t\t\tset drgDesc= adrgDesc_\"：\"_desc\t\t","\t\t","\t\t    //最高优先查找地方的DRG特异化分组方案","\t\t    if (hospInfo.%Size()>0) ","\t\t    {\t\t\t    ","                for i = 0:1:hospInfo.%Size()-1 ","                {","                    set itemObj = hospInfo.%Get(i)           ","                    set hospCode = itemObj.code","                    set hospArea = itemObj.areaAdmvs                                        ","                                       ","                    set (provID,cityID)=\"\"","                    &sql(SELECT ProvID_Dr,CityID_Dr into :provID,:cityID FROM CB_Hospital where OrganizationCode=:hospCode)","                    ","                    ","                    ","                    ","                    ","                    ","                    set m=0","                    //优先找地方特异化DRG分组方案，都不匹配后再根据国家医保局发布的基础版去匹配","                    &sql(SELECT COUNT(*) into :m FROM HB_DRGSpecialGroup WHERE LEFT(DRGCode,3)=:adrgCode ","                         AND Province_Dr=:provID AND City_Dr=:cityID AND Year=:groupYear)","                    if (m>0)","                    {","\t                      ","\t                }","                    ","                    ","                    ","                \t\t    ","                \t\t    ","                ","\t\t            set iCount=0","                    &sql(SELECT Count(*) into :iCount FROM HB_DRGCoreAlgorithmData Where DRG=:drg and Province_Dr=:provID AND City_Dr=:cityID)","                    if (iCount = 0)","\t                {","\t\t                //地方DRG目录没有这个DRGs编码,参考CHS-DRG国家医保局DRGs目录","                        //先根据细分规则判断第四位编码","                        set segFlag=0","                        &sql(SELECT SegmentationFlag into :segFlag FROM HB_DRGSegmentationRules Where ADRG=:adrgCode)\t\t    ","\t\t                if (segFlag=0)","\t\t                {","\t\t                    set drg =adrgCode_\"9\" ","\t\t                    set desc=..GetComplicationDesc(\"9\")\t\t","\t\t                    set drgDesc= adrgDesc_\"：\"_desc\t  \t\t\t    \t\t\t    ","\t\t                }\t\t                ","\t\t            }","\t\t            ","\t                //安徽省：当主手术是 后入路玻璃体切割及玻璃体硅油取出术 直接判定入组","                    if (adrgCode=\"CB4\")&&(mainOpCode=\"14.7401\")&&($E(hospArea,1,2)=\"34\")","                    {","\t                    set drg = \"CB46\"","\t                    set drgDesc = \"后入路玻璃体切割及玻璃体硅油取出术\"","\t                }","                }   ","\t\t\t}","\t\t\telse //没有传医疗机构信息，按CHS-DRG国家医保局DRGs目录处理","\t\t\t{   ","\t\t        //地方DRG目录没有这个DRGs编码,参考CHS-DRG国家医保局DRGs目录 ","                //先根据细分规则判断第四位编码","                set segFlag=0","                &sql(SELECT SegmentationFlag into :segFlag FROM HB_DRGSegmentationRules Where ADRG=:adrgCode)\t\t    ","\t\t        if (segFlag=\"0\")","\t\t        {","\t\t            set drg =adrgCode_\"9\" ","\t\t            set desc=..GetComplicationDesc(\"9\")\t\t","\t\t            set drgDesc= adrgDesc_\"：\"_desc\t  \t\t\t    \t\t\t    ","\t\t        }","\t\t    }","\t\t    ","\t\t\tif (complication=\"CC\")||(complication=\"MCC\")","\t\t\t{","\t\t\t    set drgDesc = drgDesc_\"【\"_diagCode_\"：\"_diagName_\"】\"\t","\t\t\t}","                \t\t                \t\t \t\t      ","            set row={}","            set row.code = drg","            set row.desc = drgDesc                  ","            do rows.%Push(row)","            ","            set iCount = iCount+1\t\t    \t\t                                                            ","        }\t\t","\t\t\t\t","\t\tset resultObj=..SetJarraySuccessResult(rows,iCount)\t\t","\t}","    catch(e) ","    {","        // 7. 异常处理（增强：包含错误码+详细信息）","        set status = e.AsStatus()","        set errorCode = $piece(##class(%SYSTEM.Status).GetErrorCodes(status), \",\")","        set errorMsg = $replace(##class(%SYSTEM.Status).GetErrorText(status,\"cn\"), \"^\", \" \")","        set errorInfo = \"DRG分组异常：类=\" _ $ClassName() _ \"，入参=\" _ jsonObj.%ToJSON() _ \"，错误：\" _ errorMsg","        ","        // 记录错误日志到数据库","        set errorLogID = ##class(src.Interface.Message).InsErrRecord(\"04000007\", errorInfo, errorMsg)","        set resultObj = ..SetErrorResult(\"-99\", \"DRG分组异常（日志ID：\"_errorLogID_\")：\"_errorMsg)","    }","","    quit resultObj","}","","/// Creator:     系统","/// CreatDate:   2026-05-26","/// Description: 分组器（改动前原始版本备案）","///              此方法为Device方法改动前的完整备份，用于紧急回退","///              对应原Device方法的全部逻辑，无特异化分组步骤","ClassMethod Device(jsonObj As %Library.DynamicObject) As %Library.DynamicObject","{","\t///病例实际费用 ÷ 该病组标准费用（次均费用 / 支付标准）」算出倍率，再按当地医保阈值划分为：高倍率、正常倍率、低倍率。","\t///DRG 权重RW与基准点数本质是同一个 \"相对资源值\"，只是单位与叫法不同：权重是小数（比值）基准点数 = DRG 权重 × 100（或 ×1000，各地不同）","\ttry","\t{","        // 初始化返回对象（标准化结构）","        set resultObj = ..SetSuccessResult(\"0\",\"\")","        ","        // 参数合法性校验（核心前置检查）","        if (jsonObj = \"\") || (jsonObj.params = \"\") ","        {","            set resultObj = ..SetErrorResult(\"-1\", \"入参异常：缺少params参数或参数为空\")","            quit ","        }","        \t    ","        // 提取入参并设置默认值（避免空值报错）","        set params = jsonObj.params.%Get(0)","        set mainDiagCode = params.mainDiagnosisCode  ","        set diseinfo = params.diseInfo  // 疾病诊断-数组对象   ","\t\tset mainOperationCode = params.mainOperationCode    // 主手术代码","    \tset oprninfo = params.oprnInfo  // 手术操作-数组对象（兼容空数组）  ","    \tset hospinfo = params.hospInfo  // 医疗机构-数组对象   \t","        set sex = params.sex                       // 性别","        set age = params.age                         // 年龄（默认0）","        set ageGroupDays = params.ageGroupDays        // 新生儿出生天数（默认0）","        set newbornFlag = params.newbornFlag        // 新生儿标志（默认0）","        set respiratorTime = params.respiratorTime    // 有创呼吸机时长（默认0）","        set ecmoFlag = params.ecmoFlag             // ECMO标志（默认0）","        set transplantFlag = params.transplantFlag  // 器官移植标志（默认0）","        set marrowTransplantFlag = params.marrowTransplantFlag // 骨髓移植标志","        set hivFlag = params.hivFlag                // HIV标志（默认0）","        set traumaLevel = params.traumaLevel          // 多发创伤等级（默认0）","\t\tset department = params.department           // 科室编码","\t\tset departmentDesc = params.departmentDesc   // 科室名称","\t\tset dischargeType = params.dischargeType // 离院方式 1医嘱离院;2医嘱转院;3医嘱转社区卫生服务机构/乡镇卫生院;4非医嘱离院;5死亡;9其他 代码 2（医嘱转院） 和 4（非医嘱离院） 在DRG分组中会被特别标记","\t\tset hospitalDays = params.hospitalDays   //住院天数 \t","\t\tset totalCost = params.totalCost             //住院已发生费用合计","\t\t","\t\tset patientName=params.patientName //患者姓名","\t\tset deptCode=params.deptCode //HIS科室编码","\t\tset deptName=params.deptName //HIS科室名称\t\t\t","\t\tset doctorCode=params.doctorCode //HIS医生编码","\t\tset doctorName=params.doctorName //HIS医生名称","\t\tset medicalRecordID=params.medicalRecordDr //病案号\t","\t\tset hisAdmID=params.hisAdmID //HIS就诊号\t\t\t\t","","\t\t//增加HIS患者就诊信息","\t\tset psnNo=params.psnNo //医保个人编号","\t\tset insuranceAreaCode=params.insuranceAreaCode //参保地区划代码 ","\t\tset mdtrtareaAreaCode=params.mdtrtareaAreaCode //就医地区划代码","\t\tset insuType=params.insuType //险种类型\t\t\t\t\t\t\t\t","\t\tset diagnosisCode=params.diagnosisCode //病种编码","\t\tset diagnosisName=params.diagnosisName //病种名称","\t\tset groupStage=params.groupStage  //分组阶段 1.事前 2.事中 3.事后","\t\tset diaTypeCode=params.diaTypeCode //诊断类型编码 ADD入院 OPD门诊 DIS出院\t\t","\t\tset admDateTime=params.admDateTime //入院时间","\t\tset discgDateTime=params.discgDateTime //出院时间","\t\tset settleDateTime=params.settleDateTime //结算时间","\t\tset unionOprnFlag=params.unionOprnFlag //联合手术标志 ","","\t\t//分组方案年份（由前端传入，默认当前年份）","\t\tset groupYear = params.groupYear","\t\tif (groupYear = \"\") set groupYear = $PIECE($ZDATE($HOROLOG,3),\"-\",1)","","    \t// 如果为空字符串或非数组，设置为空数组","    \tif (diseinfo = \"\") || ('$ISOBJECT(diseinfo)) set diseinfo = []","    \tif (oprninfo = \"\") || ('$ISOBJECT(oprninfo)) set oprninfo = []\t\t","    \tif (hospinfo = \"\") || ('$ISOBJECT(hospinfo)) set hospinfo = []    \t    \t\t  \t                    ","\t\t\t\t\t\t\t","\t\tset (MDC,MDCDesc,ADRG,ADRGDesc,DRG,DRGDesc,Complication,ComplicationDesc)=\"\"\t\t","\t\t         \t","\t\t//1.分组流程前 校验入参 ","\t\tset joRtn=..CheckRules(jsonObj)","\t\tif (joRtn.errorCode '= \"0\")","\t\t{","            set resultObj = ..SetErrorResult(\"-1\", \"进入分组流程前CheckRules校验失败：\"_joRtn.errorMessage)","            quit","\t\t}","","\t\t//2.第一步：MDC先期分组      ","\t\tset joRtn=..GroupPreMDC(jsonObj)","\t\tif (joRtn.errorCode '= \"0\")","\t\t{","            set resultObj = ..SetErrorResult(\"-2\", \"2.MDC先期分组失败：\"_joRtn.errorMessage)","            quit","\t\t}","\t\telse","\t\t{","\t\t\tset MDC=joRtn.result.code","\t\t\tset MDCDesc=joRtn.result.desc","\t\t}","\t\t","\t\t//3.第二步：判断QY歧义组","        set params.mdc = MDC","        set params.mdcDesc = MDCDesc","\t\tset joRtn=..CheckGroupQY(jsonObj)","\t\tif (joRtn.errorCode '= \"0\")","\t\t{\t","\t\t    //返回不为0表示 进入歧义组\t\t","            set resultObj = ..SetErrorResult(\"-3\", \"3.QY歧义组判断：\"_joRtn.errorMessage)","            quit","\t\t}","","\t\t//4.第三步：ADRG分组        ","        set params.mdc = MDC","        set params.mdcDesc = MDCDesc","\t\tset joRtn=..GroupADRG(jsonObj)","\t\t","\t\tif (joRtn.errorCode '= \"0\")","\t\t{","            set resultObj = ..SetErrorResult(\"-4\", \"4.1 ADRG分组失败：\"_joRtn.errorMessage)","            quit","\t\t}","\t\telse","\t\t{","\t\t\tset totalCount = joRtn.totalCount //返回记录数","\t\t\tset jaADRG= joRtn.result","\t\t\tif (totalCount = 0)","\t\t\t{","\t\t\t    set resultObj=..SetErrorResult(\"-4\",\"4.2 ADRG分组失败,请检查主诊断大类【\"_MDC_\"：\"_MDCDesc_\"】的分组规则是否维护！0000组入组条件：主要诊断大类(MDC),或者未入任何ADRG分组！\")\t","\t\t\t    quit","\t\t\t}\t\t\t\t","\t\t}","","\t\t//第四步：并发症确认CC/MCC","\t\tset params.adrgInfo = jaADRG","\t\tset joRtn=..GroupComplication(jsonObj)\t","","\t\tif (joRtn.errorCode '= \"0\")","\t\t{","            set resultObj = ..SetErrorResult(\"-5\", \"5.1 并发症确认CC/MCC失败：\"_joRtn.errorMessage)","            quit","\t\t}","\t\telse","\t\t{","\t\t\tset totalCount = joRtn.totalCount //返回记录数","\t\t\tset jaComplication= joRtn.result","\t\t}","","\t\t//第五步：DRG分组","        set params.complicationInfo= jaComplication                       ","\t\tset joRtn=..GroupDRG(jsonObj)\t\t\t\t\t\t\t\t","\t\tif (joRtn.errorCode '= \"0\")","\t\t{","            set resultObj = ..SetErrorResult(\"-7\", \"7.1 DRG分组失败：\"_joRtn.errorMessage)","            quit","\t\t}","\t\telse","\t\t{","\t\t\t//返回数组对象,可能存在多个DRG分组结果","\t\t\tset totalCount = joRtn.totalCount ","\t\t\tset jaDRG= joRtn.result\t","\t\t\tif (totalCount =0)","\t\t\t{","\t\t\t    set resultObj=..SetErrorResult(\"-7\",\"7.2 DRG分组失败：\"_joRtn.errorMessage)\t","\t\t\t    quit","\t\t\t}","\t\t\t","            set itemObj = jaDRG.%Get(0)","            set DRG = itemObj.code","            set DRGDesc = itemObj.desc\t\t\t\t\t\t\t\t\t","\t\t}","\t\t","\t\t//第六步：查询DRG对应医疗机构算法配置信息\t\t","        //循环医疗机构信息数组","        set jaAlgorithm=[]","        for i = 0:1:hospinfo.%Size()-1 ","        {","            set itemObj = hospinfo.%Get(i)","            set hisHospCode=itemObj.hisHospCode            ","            set hospCode = itemObj.code","            set hospName = itemObj.name","            set mdtrtArea=\"\",policyType=\"\"","            set iCount=0","            set (points,pipValue,dgdov,payStandard)=\"0.00\"","            ","            //根据医院信息获取对应的就医地区划代码","            &sql(SELECT CityID_Dr->Code,PolicyType_Dr->Descripts into :mdtrtareaAreaCode,:policyType FROM CB_Hospital WHERE OrganizationCode=:hospCode)","            set insuAreaDesc=..GetSettlementType(insuranceAreaCode,mdtrtareaAreaCode)\t        ","","            //按年份查询算法配置","            set queryYear = groupYear","            &sql(SELECT Count(*) into :iCount FROM HB_DRGCoreAlgorithmData WHERE FixmedinsCode=:hospCode AND DRG=:DRG AND (Year=:groupYear OR Year IS NULL OR Year=''))","            if (iCount = 0)&&(groupYear '= \"\") ","            {","                set queryYear = groupYear - 1","                &sql(SELECT Count(*) into :iCount FROM HB_DRGCoreAlgorithmData WHERE FixmedinsCode=:hospCode AND DRG=:DRG AND (Year=:queryYear OR Year IS NULL OR Year=''))","                if (iCount = 0) {","                    set queryYear = \"\"","                    &sql(SELECT Count(*) into :iCount FROM HB_DRGCoreAlgorithmData WHERE FixmedinsCode=:hospCode AND DRG=:DRG)","                }","            }","            ","\t        if (iCount>1)","\t        {","\t\t        if (insuAreaDesc=\"市本级\") { set mdtrtArea=$E(mdtrtareaAreaCode,1,4)_\"00\" }","\t\t\t    elseif (insuAreaDesc=\"省直\") { set mdtrtArea=$E(mdtrtareaAreaCode,1,2)_\"9900\" }","\t\t\t    elseif (insuAreaDesc=\"异地\") { set mdtrtArea=$E(mdtrtareaAreaCode,1,2)_\"0000\" }","","                if (queryYear '= \"\") ","                {","                    &sql(SELECT Points, PipValue, DGDOV, PayStandard into :points,:pipValue,:dgdov,:payStandard FROM HB_DRGCoreAlgorithmData ","                         WHERE FixmedinsCode=:hospCode AND DRG=:DRG AND MdtrtArea=:mdtrtArea AND (Year=:queryYear OR Year IS NULL OR Year=''))","                } ","                else ","                {","                    &sql(SELECT Points, PipValue, DGDOV, PayStandard into :points,:pipValue,:dgdov,:payStandard FROM HB_DRGCoreAlgorithmData ","                         WHERE FixmedinsCode=:hospCode AND DRG=:DRG AND MdtrtArea=:mdtrtArea)","                }","\t\t    }","\t\t    elseif (iCount=1)","\t\t    {","\t\t\t    set insuAreaDesc=\"市本级\"","                if (queryYear '= \"\") ","                {","                    &sql(SELECT Points, PipValue, DGDOV, PayStandard into :points,:pipValue,:dgdov,:payStandard FROM HB_DRGCoreAlgorithmData ","                         WHERE FixmedinsCode=:hospCode AND DRG=:DRG AND (Year=:queryYear OR Year IS NULL OR Year=''))","                } ","                else ","                {","                    &sql(SELECT Points, PipValue, DGDOV, PayStandard into :points,:pipValue,:dgdov,:payStandard FROM HB_DRGCoreAlgorithmData ","                         WHERE FixmedinsCode=:hospCode AND DRG=:DRG)","                }","\t\t\t}","\t\t\telse","\t\t\t{","\t\t\t\tset (points,pipValue,dgdov,payStandard)=\"0.00\"","\t\t\t\tset insuAreaDesc=\"\"","\t\t\t\tif (groupYear '= \"\") { set insuAreaDesc=\"未维护【\"_groupYear_\"年】DRG分组数据\" }","\t\t\t}\t        ","                                                           ","\t\t    if (payStandard=\"0.00\")||(payStandard=\"\") { set (points,pipValue,dgdov,payStandard)=\"0.00\" }","            ","            set jo={}","            set jo.hisHospCode = hisHospCode","            set jo.hospCode = hospCode","            set jo.hospName = hospName_\"[\"_queryYear_\"年\"_insuAreaDesc_\"DRG分组方案]\"","            set jo.algorithm= insuAreaDesc","            set jo.policyType= policyType","            set jo.drg = DRG ","            set jo.drgDesc = DRGDesc                       ","            set jo.points = points","            set jo.pipValue = pipValue","            set jo.dgdov = dgdov","            set jo.payStandard = payStandard                        ","            set jo.totalCost = totalCost","","            if (payStandard=\"0.00\")||(payStandard=\"\")","            {","                set discrepancyRate = 100                    ","                set discrepancyAmt = payStandard - totalCost","\t        }","\t        else","\t        {","                set discrepancyRate = $FNUMBER(($ZABS(totalCost - payStandard)/payStandard)*100,\"L\",2)                       ","                set discrepancyAmt = payStandard - totalCost   ","\t\t    }","                        ","            if (discrepancyAmt > 0)","            {","\t            set jo.preProfit = $FNUMBER(discrepancyAmt,\"L\",2)","                set jo.preLoss = \"0.00\"","                set jo.profitLoss = \"盈利\"  ","\t        }","\t        elseif (discrepancyAmt < 0)","\t        {","\t            set jo.preProfit = \"0.00\"","\t            set jo.preLoss = $FNUMBER(discrepancyAmt,\"L\",2)","\t            set jo.profitLoss = \"亏损\"  ","\t\t    }","\t        elseif (discrepancyAmt = 0)","\t        {","\t            set jo.preProfit = \"0.00\"","\t            set jo.preLoss = \"0.00\"","\t            set jo.profitLoss = \"\"  ","\t\t    }","\t\t    \t","\t\t    set jo.discrepancyRate = discrepancyRate","\t\t    set jo.groupPlanYear = queryYear","\t\t    ","\t\t\tdo jaAlgorithm.%Push(jo)     \t                                                                     ","        }","       ","        //第七步：封装返回值","\t\tset DRG=joRtn.result.code","\t\tset DRGDesc=joRtn.result.desc","\t\tset resultObj = ..SetSuccessResult(DRG,DRGDesc)","","\t\tset joRtn={}","\t\tset joRtn.mdc=MDC","\t\tset joRtn.mdcDesc=MDCDesc","\t\tset joRtn.complicationInfo=jaComplication","\t\tset joRtn.drgInfo=jaDRG","\t\tset joRtn.hospAlgorithmInfo=jaAlgorithm","\t\tset joRtn.checkTime = $ZDATETIME($HOROLOG,3)","","    \tset resultObj={}","\t    set resultObj.errorCode = \"0\"","\t    set resultObj.errorMessage = \"\"","\t    set resultObj.result = joRtn    ","\t    set resultObj.params = params","\t    \t","\t}","    catch(e) ","    {","        set status = e.AsStatus()","        set errorCode = $piece(##class(%SYSTEM.Status).GetErrorCodes(status), \",\")","        set errorMsg = $replace(##class(%SYSTEM.Status).GetErrorText(status,\"cn\"), \"^\", \" \")","        set errorInfo = \"DRG分组异常：类=\" _ $ClassName() _ \"，入参=\" _ jsonObj.%ToJSON() _ \"，错误：\" _ errorMsg","        ","        set errorLogID = ##class(src.Interface.Message).InsErrRecord(\"04000007\", errorInfo, errorMsg)","        set resultObj = ..SetErrorResult(\"-99\", \"DRG分组异常(日志ID：\"_errorLogID_\")：\"_errorMsg)","    }","","    quit resultObj","}","","/// Creator:     CM","/// CreatDate:   2026-01-01","/// Description: 分组器（改造版：增加特异化分组匹配步骤）","/// code:\t\t ","/// Input:{\"params\":[{\"\":\"\"}]}","/// Debug","ClassMethod DeviceNew(jsonObj As %Library.DynamicObject) As %Library.DynamicObject","{","\t///病例实际费用 ÷ 该病组标准费用（次均费用 / 支付标准）」算出倍率，再按当地医保阈值划分为：高倍率、正常倍率、低倍率。","\t///DRG 权重RW与基准点数本质是同一个 “相对资源值”，只是单位与叫法不同：权重是小数（比值）基准点数 = DRG 权重 × 100（或 ×1000，各地不同）","\ttry","\t{","        // 初始化返回对象（标准化结构）","        set resultObj = ..SetSuccessResult(\"0\",\"\")","        ","        // 参数合法性校验（核心前置检查）","        if (jsonObj = \"\") || (jsonObj.params = \"\") ","        {","            set resultObj = ..SetErrorResult(\"-1\", \"入参异常：缺少params参数或参数为空\")","            quit ","        }","        \t    ","        // 提取入参并设置默认值（避免空值报错）","        set params = jsonObj.params.%Get(0)","        set mainDiagCode = params.mainDiagnosisCode  ","        set diseinfo = params.diseInfo  // 疾病诊断-数组对象   ","\t\tset mainOperationCode = params.mainOperationCode    // 主手术代码","    \tset oprninfo = params.oprnInfo  // 手术操作-数组对象（兼容空数组）  ","    \tset hospinfo = params.hospInfo  // 医疗机构-数组对象   \t","        set sex = params.sex                       // 性别","        set age = params.age                         // 年龄（默认0）","        set ageGroupDays = params.ageGroupDays        // 新生儿出生天数（默认0）","        set newbornFlag = params.newbornFlag        // 新生儿标志（默认0）","        set respiratorTime = params.respiratorTime    // 有创呼吸机时长（默认0）","        set ecmoFlag = params.ecmoFlag             // ECMO标志（默认0）","        set transplantFlag = params.transplantFlag  // 器官移植标志（默认0）","        set marrowTransplantFlag = params.marrowTransplantFlag // 骨髓移植标志","        set hivFlag = params.hivFlag                // HIV标志（默认0）","        set traumaLevel = params.traumaLevel          // 多发创伤等级（默认0）","\t\tset department = params.department           // 科室编码","\t\tset departmentDesc = params.departmentDesc   // 科室名称","\t\tset dischargeType = params.dischargeType // 离院方式 1医嘱离院;2医嘱转院;3医嘱转社区卫生服务机构/乡镇卫生院;4非医嘱离院;5死亡;9其他 代码 2（医嘱转院） 和 4（非医嘱离院） 在DRG分组中会被特别标记","\t\tset hospitalDays = params.hospitalDays   //住院天数 \t","\t\tset totalCost = params.totalCost             //住院已发生费用合计","\t\t","\t\tset patientName=params.patientName //患者姓名","\t\tset deptCode=params.deptCode //HIS科室编码","\t\tset deptName=params.deptName //HIS科室名称\t","\t\t","\t\tset doctorCode=params.doctorCode //HIS医生编码","\t\tset doctorName=params.doctorName //HIS医生名称","\t\tset medicalRecordID=params.medicalRecordDr //病案号\t","\t\tset hisAdmID=params.hisAdmID //HIS就诊号\t\t\t\t","","\t\t//增加HIS患者就诊信息","\t\tset psnNo=params.psnNo //医保个人编号","\t\tset insuranceAreaCode=params.insuranceAreaCode //参保地区划代码 ","\t\tset mdtrtareaAreaCode=params.mdtrtareaAreaCode //就医地区划代码","\t\tset insuType=params.insuType //险种类型\t\t\t\t\t\t\t\t","\t\tset diagnosisCode=params.diagnosisCode //病种编码","\t\tset diagnosisName=params.diagnosisName //病种名称","\t\tset groupStage=params.groupStage  //分组阶段 1.事前 2.事中 3.事后","\t\tset diaTypeCode=params.diaTypeCode //诊断类型编码 ADD入院 OPD门诊 DIS出院\t\t","\t\tset admDateTime=params.admDateTime //入院时间","\t\tset discgDateTime=params.discgDateTime //出院时间","\t\tset settleDateTime=params.settleDateTime //结算时间","\t\tset unionOprnFlag=params.unionOprnFlag //联合手术标志 ","","\t\t//分组方案年份（由前端传入，默认当前年份）","\t\tset groupYear = params.groupYear","\t\tif (groupYear = \"\") set groupYear = $PIECE($ZDATE($HOROLOG,3),\"-\",1)","","    \t// 如果为空字符串或非数组，设置为空数组","    \tif (diseinfo = \"\") || ('$ISOBJECT(diseinfo)) set diseinfo = []","    \tif (oprninfo = \"\") || ('$ISOBJECT(oprninfo)) set oprninfo = []\t\t","    \tif (hospinfo = \"\") || ('$ISOBJECT(hospinfo)) set hospinfo = []    \t    \t\t  \t                    ","\t\t\t\t\t\t\t","\t\tset (MDC,MDCDesc,ADRG,ADRGDesc,DRG,DRGDesc,Complication,ComplicationDesc)=\"\"\t\t","\t\t         \t","\t\t//1.分组流程前 校验入参 ","\t\tset joRtn=..CheckRules(jsonObj)","\t\tif (joRtn.errorCode '= \"0\")","\t\t{","            set resultObj = ..SetErrorResult(\"-1\", \"进入分组流程前CheckRules校验失败：\"_joRtn.errorMessage)","            quit","\t\t}","","\t\t//2.第一步：MDC先期分组      ","\t\tset joRtn=..GroupPreMDC(jsonObj)","\t\tif (joRtn.errorCode '= \"0\")","\t\t{","            set resultObj = ..SetErrorResult(\"-2\", \"2.MDC先期分组失败：\"_joRtn.errorMessage)","            quit","\t\t}","\t\telse","\t\t{","\t\t\tset MDC=joRtn.result.code","\t\t\tset MDCDesc=joRtn.result.desc","\t\t}","\t\t","\t\t//3.第二步：判断QY歧义组","        set params.mdc = MDC","        set params.mdcDesc = MDCDesc","\t\tset joRtn=..CheckGroupQY(jsonObj)","\t\tif (joRtn.errorCode '= \"0\")","\t\t{\t","\t\t    //返回不为0表示 进入歧义组\t\t","            set resultObj = ..SetErrorResult(\"-3\", \"3.QY歧义组判断：\"_joRtn.errorMessage)","            quit","\t\t}","","\t\t//4.第三步：ADRG分组        ","        set params.mdc = MDC","        set params.mdcDesc = MDCDesc","\t\tset joRtn=..GroupADRG(jsonObj)","\t\t","\t\t//set resultObj=joRtn","\t\t//quit","\t\t","\t\tif (joRtn.errorCode '= \"0\")","\t\t{","            set resultObj = ..SetErrorResult(\"-4\", \"4.1 ADRG分组失败：\"_joRtn.errorMessage)","            quit","\t\t}","\t\telse","\t\t{","\t\t\t//返回结果是数组对象,可能存在多个ADRG分组结果","\t\t\tset totalCount = joRtn.totalCount //返回记录数","\t\t\tset jaADRG= joRtn.result","\t\t\tif (totalCount = 0)","\t\t\t{","\t\t\t    set resultObj=..SetErrorResult(\"-4\",\"4.2 ADRG分组失败,请检查主诊断大类【\"_MDC_\"：\"_MDCDesc_\"】的分组规则是否维护！0000组入组条件：主要诊断大类(MDC),或者未入任何ADRG分组！\")\t","\t\t\t    quit","\t\t\t}\t\t\t\t","\t\t}","","\t\t//第四步B：特异化分组匹配（新增步骤，仅当hospinfo非空时执行）","\t\t// 命中特异化分组后跳过CC/MCC和标准DRG细分，直接进入算法配置查询","\t\tset skipToAlgorithm = 0","\t\t","\t\tif ($ISOBJECT(hospinfo)) && (hospinfo.%Size() > 0) ","\t\t{","\t\t\tset joSpecialRtn = ..GroupSpecialMatch(jsonObj, MDC, jaADRG, hospinfo, groupYear)","\t\t\tif (joSpecialRtn.errorCode = \"0\") ","\t\t\t{","\t\t\t\t// 命中特异化分组，直接使用特异化DRG编码","\t\t\t\t// 防御性检查：确保result是DynamicObject且包含必要属性","\t\t\t\tif ($ISOBJECT(joSpecialRtn.result)) {","\t\t\t\t\tset DRG = $GET(joSpecialRtn.result.drgCode, \"\")","\t\t\t\t\tset DRGDesc = $GET(joSpecialRtn.result.drgDesc, \"\")","\t\t\t\t} else {","\t\t\t\t\tset DRG = \"\"","\t\t\t\t\tset DRGDesc = \"\"","\t\t\t\t}","\t\t\t\t","\t\t\t\t// 构造jaDRG数组（后续算法查询和返回值封装需要）","\t\t\t\tset jaDRG = ##class(%DynamicArray).%New()","\t\t\t\tset drgItem = {}","\t\t\t\tset drgItem.code = DRG","\t\t\t\tset drgItem.desc = DRGDesc","\t\t\t\tdo jaDRG.%Push(drgItem)","\t\t\t\t","\t\t\t\t// 并发症信息设为空（特异化分组不考虑CC/MCC）","\t\t\t\tset jaComplication = ##class(%DynamicArray).%New()","\t\t\t\t","\t\t\t\tset skipToAlgorithm = 1","\t\t\t}","\t\t}","\t\t","\t\t// hospinfo为空或未命中特异化分组，继续标准流程（Step 5 Complication → Step 6 GroupDRG）","\t\tif (skipToAlgorithm = 0) ","\t\t{","\t    \t//第四步：并发症确认CC/MCC","\t\t    set params.adrgInfo = jaADRG","\t\t    set joRtn=..GroupComplication(jsonObj)\t","\t\t\t\t","\t\t    if (joRtn.errorCode '= \"0\")","\t\t    {","                set resultObj = ..SetErrorResult(\"-5\", \"5.1 并发症确认CC/MCC失败：\"_joRtn.errorMessage)","                quit","\t    \t}","\t    \telse","\t\t    {","\t\t\t    //返回结果是数组对象,可能存在多个ADRG分组结果","\t\t\t    set totalCount = joRtn.totalCount //返回记录数","\t\t    \tset jaComplication= joRtn.result","    \t\t}","","\t    \t//第五步：DRG分组","            set params.complicationInfo= jaComplication                       ","\t\t    set joRtn=..GroupDRG(jsonObj)\t\t\t\t\t\t\t\t","\t\t    if (joRtn.errorCode '= \"0\")","\t\t    {","                set resultObj = ..SetErrorResult(\"-7\", \"7.1 DRG分组失败：\"_joRtn.errorMessage)","                quit","\t\t    }","\t    \telse","\t\t    {","\t\t\t    //返回数组对象,可能存在多个DRG分组结果","\t\t\t    set totalCount = joRtn.totalCount ","\t\t\t    set jaDRG= joRtn.result\t","\t\t\t    if (totalCount =0)","\t\t    \t{","\t\t\t        set resultObj=..SetErrorResult(\"-7\",\"7.2 DRG分组失败：\"_joRtn.errorMessage)\t","\t\t\t        quit","\t\t\t    }","\t\t\t","                set 