{"status":{"errors":[],"summary":""},"console":[],"result":{"name":"src.DRG.GroupDevice.cls","db":"DRG-SRC","ts":"2026-05-27 14:32:11.274","upd":true,"cat":"CLS","status":"","enc":false,"flags":0,"content":["Import SQLUSER","","Class src.DRG.GroupDevice Extends (%RegisteredObject, %XML.Adaptor) [ Not ProcedureBlock ]","{","","/// 设置成功返回结果（封装重复逻辑）","ClassMethod SetSuccessResult(code As %String, message As %String) As %Library.DynamicObject","{","\tset resultObj={}","\tset resultObj.errorCode=\"0\"","\tset resultObj.errorMessage=message","","\tset result={}","\tset result.code=code","\tset result.desc=message","\tset result.checkTime=$ZDATETIME($HOROLOG,3)","    set resultObj.result=result","    ","    quit resultObj","}","","/// 设置成功返回结果数组（封装重复逻辑）","ClassMethod SetJarraySuccessResult(jsonObj As %Library.DynamicObject, iCount As %String) As %Library.DynamicObject","{","\tset resultObj={}","\tset resultObj.errorCode=\"0\"","\tset resultObj.errorMessage=\"\"","    set resultObj.result=jsonObj","    set resultObj.totalCount=iCount","\t//set resultObj.result.checkTime=$ZDATETIME($HOROLOG,3)","    ","    quit resultObj","}","","/// 设置错误返回结果（封装重复逻辑）","ClassMethod SetErrorResult(errorCode As %String, errorMsg As %String) As %Library.DynamicObject","{","\tset resultObj={}","\tset resultObj.errorCode= errorCode","\tset resultObj.errorMessage= errorMsg","","\tset result={}","\tset result.code=\"\"","\tset result.desc=\"\"","\tset result.checkTime= $ZDATETIME($HOROLOG,3)","    set resultObj.result= result","    ","    quit resultObj","}","","/// 私有方法：记录检查日志（可扩展到日志表）","ClassMethod LogCheckInfo(logType As %String, logContent As %String)","{","    // 此处可扩展：写入日志表/文件","    // 示例：do ##class(src.Interface.Log).InsertLog(\"DRG分组\", \"PreMDC\", logType, logContent)","    w $ZDATETIME($HOROLOG,3) _ \" | \" _ logType _ \" | \" _ logContent _ $C(13,10)","}","","/// 根据参保地区和就医地区划代码判断结算类型","/// @param insuranceAreaCode 参保地区划代码（6位）","/// @param mdtrtareaAreaCode 就医地区划代码（6位）","/// @return 市本级|省直|异地","ClassMethod GetSettlementType(insuranceAreaCode As %String, mdtrtareaAreaCode As %String) As %String","{","    quit:(insuranceAreaCode = \"\")||(mdtrtareaAreaCode = \"\") \"市本级\"","    ","    set insuranceAreaCode = $ZCVT(insuranceAreaCode, \"U\")","    set mdtrtareaAreaCode = $ZCVT(mdtrtareaAreaCode, \"U\")","    ","    // 判断是否省直（第3-4位=99）","    set isDirect = ($EXTRACT(insuranceAreaCode, 3, 4) = \"99\")","    ","    if (isDirect) {","        // 省直：同一省份返回\"省直\"，否则\"异地\"","        set insProv = $EXTRACT(insuranceAreaCode, 1, 2)","        set medProv = $EXTRACT(mdtrtareaAreaCode, 1, 2)","        quit $SELECT(insProv = medProv: \"省直\", 1: \"异地\")","    }","    ","    // 市本级：前4位相同","    if ($EXTRACT(insuranceAreaCode, 1, 4) = $EXTRACT(mdtrtareaAreaCode, 1, 4)) {","        quit \"市本级\"","    }","    ","    quit \"异地\"","}","","/// 将分隔符分割的编码字符串拆分为$LIST列表","/// 支持：英文逗号\",\" 中文逗号\"，\" 分号\";\" 斜杠\"/\" 加号\"+\" 空格\" \"作为分隔符","ClassMethod SplitCodes(codeStr As %String) As %List","{","\tif (codeStr = \"\")","\t{","\t\tquit \"\"","\t}","\t","\t// 将所有分隔符统一替换为英文逗号","\tset normalized = $TRANSLATE(codeStr, \"，;/+ \", \",,,,,,\")","\t","\tset list = \"\"","\tset count = $LENGTH(normalized, \",\")","\tfor i = 1:1:count","\t{","\t\tset oneCode = $ZSTRIP($PIECE(normalized, \",\", i), \"<>W\")","\t\tif (oneCode '= \"\")","\t\t{","\t\t\tset list = list _ $LISTBUILD(oneCode)","\t\t}","\t}","\tquit list","}","","/// 计算输入编码列表在存储字段中的匹配数量","/// 支持ICD编码层级：一方是另一方的前缀即视为匹配","/// inputList  : $LIST格式的入参编码列表","/// storedField: 表内存储的字段值（可能包含多个逗号分隔的编码）","/// 返回       : 匹配到的编码数量","ClassMethod CountCodeMatches(inputList As %List, storedField As %String) As %Integer","{","\tif (inputList = \"\") || (storedField = \"\")","\t{","\t\tquit 0","\t}","\t","\t// 将存储字段也拆分为列表","\tset storedList = ..SplitCodes(storedField)","\tset storedCount = $LISTLENGTH(storedList)","\tif (storedCount = 0)","\t{","\t\tquit 0","\t}","\t","\tset matchCount = 0","\tset inputCount = $LISTLENGTH(inputList)","\t","\t// 逐个比较入参编码与存储编码（ICD层级匹配：前缀关系）","\tfor i = 1:1:inputCount","\t{","\t\tset oneInput = $LISTGET(inputList, i)","\t\tif (oneInput = \"\") { continue }","\t\t","\t\tfor j = 1:1:storedCount","\t\t{","\t\t\tset oneStored = $LISTGET(storedList, j)","\t\t\tif (oneStored = \"\") { continue }","\t\t\t","\t\t\t// 双向前缀匹配：入参可能是存储编码的子类（如H25.900匹配H25.9），或反之","\t\t\tif (..IsCodeMatch(oneInput, oneStored))","\t\t\t{","\t\t\t\tset matchCount = matchCount + 1","\t\t\t\tquit  // 一个入参编码只匹配一次","\t\t\t}","\t\t}","\t}","\tquit matchCount","}","","/// 判断两个ICD编码是否匹配（双向包含/前缀关系）","/// 入参H25.900 能匹配 存储的H25.9、H25（子类→父类）","/// 入参H25     能匹配 存储的H25.9、H25.001（父类→子类）","ClassMethod IsCodeMatch(code1 As %String, code2 As %String) As %Boolean","{","\tif (code1 = \"\") || (code2 = \"\")","\t{","\t\tquit 0","\t}","\t","\t// 精确相等直接匹配","\tif (code1 = code2)","\t{","\t\tquit 1","\t}","\t","\t// 双向包含判断：一方是另一方的子串","\t// code1包含code2 → code2是code1的前缀（如code1=H25.900, code2=H25）","\tif ($FIND(code1, code2) = ($LENGTH(code2) + 1))","\t{","\t\tquit 1","\t}","\t// code2包含code1 → code1是code2的前缀（如code1=H25, code2=H25.9）","\tif ($FIND(code2, code1) = ($LENGTH(code1) + 1))","\t{","\t\tquit 1","\t}","\t","\tquit 0","}","","/// 构建多编码WHERE条件（OR组合）","/// fieldName: 表字段名","/// codeList : $LIST格式的编码列表","/// 支持ICD编码层级匹配：入参编码与存储编码双向包含（前缀关系）","ClassMethod BuildMultiCodeWhere(fieldName As %String, codeList As %List) As %String","{","\tset codeCount = $LISTLENGTH(codeList)","\tif (codeCount = 0)","\t{","\t\tquit \"\"","\t}","\t","\tset where = \" AND (\"","\tfor i = 1:1:codeCount","\t{","\t\tset oneCode = $LISTGET(codeList, i)","\t\tif (oneCode = \"\") { continue }","\t\t","\t\tif (i > 1)","\t\t{","\t\t\tset where = where _ \" OR \"","\t\t}","\t\t// 双向前缀匹配：支持ICD编码层级（如入参H25.900可匹配存储的H25.9、H25）","\t\tset where = where _ \" (INSTR(\"_fieldName_\", '\"_oneCode_\"') > 0 \"","\t\t        _ \" OR INSTR('\"_oneCode_\"', \"_fieldName_\") > 0) \"","\t}","\tset where = where _ \")\"","\tquit where","}","","/// 通过序号获取对应的并发症情况说明","ClassMethod GetComplicationDesc(num As %String) As %String","{","    set descripts = $select(","        num = \"1\": \"伴有严重并发症与合并症\",","        num = \"3\": \"伴有一般并发症与合并症\",","        num = \"5\": \"不伴有并发症与合并症\",","        num = \"7\": \"死亡或转院\",","        num = \"0\": \"小于17岁组，儿童病例（<17岁）\",","        num = \"9\": \"合并症与并发症未作区分的情况\",","        num = \"QY\": \"歧义（QY）组，指与主要诊断无关的手术病例组，检查病例的主要诊断和主要手术/操作是否匹配，如果二者在临床逻辑上不匹配，或者不在同一个主要诊断大类（MDC）里，这个病例就会被判定为歧义，送入QY组\",","        num = \"0000\": \"指由于疾病诊断编码不规范等原因导致的不能正常入组的病例进入的组\",","        1: \"其他数字表示其他需单独分组的情况\"","    )","    ","    return descripts","}","","/// 校验是否存在 不作为分组规则疾病诊断、手术操作表中","ClassMethod CheckNoRulesList(code As %String) As %String","{","    set iCount = 0","    &sql(SELECT COUNT(*) INTO :iCount FROM HB_DRGBasicDataSub ","         WHERE HBDictionaries_Dr->InsuCode IN ('NoRuleOfDiagnosis', 'NoRuleOfOperation') ","         AND Code = :code)","    ","    quit iCount","}","","/// 校验是否存在 合并症或并发症排除列表 表6-3-1 —— 表6-3-211","ClassMethod CheckNoComplicationList(code As %String) As %String","{","    set iCount = 0","    &sql(SELECT COUNT(*) INTO :iCount FROM HB_DRGBasicDataSub ","         WHERE HBDictionaries_Dr->InsuCode ='NoComplicationList'","         AND Code = :code)","    ","    quit iCount","}","","/// Creator:     CM","/// CreatDate:   2026-01-01","/// Description: 分组前校验规则：校验不作为分组规则的疾病诊断和手术操作列表、QY组 检查病例的主要诊断和主要手术/操作是否匹配","///              在分组流程的第一步（确定主要诊断大类MDC）和第二步（确定核心疾病诊断相关组ADRG）中，","///              如果病例的主要诊断或主要手术操作存在于这个列表中，系统就会判定该病例无法进入正常的MDC或ADRG。","///              被过滤掉的病例最终会进入“0000组”（空白病组，即无法入组的病例）","/// code: ","/// Input:{\"params\":[{\"\":\"\"}]}","/// Debug：","ClassMethod CheckRules(jsonObj As %Library.DynamicObject) As %Library.DynamicObject","{","\tnew (jsonObj)","\tset params = ##class(%DynamicArray).%New()\t","\ttry","\t{","        // 1. 初始化返回对象（标准化结构）","        set resultObj = ..SetSuccessResult(\"0\",\"\")","        ","        // 2. 参数合法性校验（核心前置检查）","        if (jsonObj = \"\") || (jsonObj.params = \"\") ","        {","            set resultObj = ..SetErrorResult(\"-1\", \"入参异常：缺少params参数或参数为空\")","            quit ","        } ","","        // 3. 提取入参并设置默认值（避免空值报错）","        set preMsg=\"CheckRules分组前校验不通过：\"","        set params = jsonObj.params.%Get(0)","        set mainDiagCode = params.mainDiagnosisCode  // 主诊断代码","        set mainOperationCode = params.mainOperationCode  // 主手术代码","        ","        if (mainDiagCode =\"\")","        {","\t\t    set resultObj = ..SetErrorResult(\"-1\", \"主诊断不能为空！\")","\t\t    quit    ","\t    }\t    ","        ","        //1.剔除不作为分组规则的疾病诊断列表、不作为分组规则的手术操作列表\t         \t         \t\t","\t    set iCountA=..CheckNoRulesList(mainDiagCode)","\t    set iCountB=..CheckNoRulesList(mainOperationCode)\t   ","\t    ","\t    if (mainOperationCode '=\"\")","    \t{","\t         if (iCountA>0)","\t         {","\t\t         set preMsg= preMsg_\" 该主诊断[\"_mainDiagCode_\"]存在CHS-DRG不作为分组规则的疾病诊断列表中,无法分组,请检查！\"","             }","\t\t ","\t         if (iCountB>0)","\t         {","\t\t         set preMsg= preMsg_\" 该主手术操作[\"_mainOperationCode_\"]存在CHS-DRG不作为分组规则的手术操作列表中,无法分组,请检查！\"\t\t\t ","\t         }","\t         ","\t         if (iCountA>0)||(iCountB>0)","\t         {","\t\t         set resultObj = ..SetErrorResult(\"-1\", preMsg)","\t\t         quit    ","\t\t     } \t        ","\t    }","\t    else\t","\t    {","\t         if (iCountA>0)","\t         {","\t\t         set preMsg=OutMsg_\" 该主诊断[\"_mainDiagCode_\"]存在CHS-DRG不作为分组规则的疾病诊断列表中,无法分组！\"","\t\t         set resultObj = ..SetErrorResult(\"-1\", preMsg)","\t\t         quit   ","             }\t    \t","\t    }    \t","\t}","    catch(e) ","    {","        // 7. 异常处理（增强：包含错误码+详细信息）","        set status = e.AsStatus()","        set errorCode = $piece(##class(%SYSTEM.Status).GetErrorCodes(status), \",\")","        set errorMsg = $replace(##class(%SYSTEM.Status).GetErrorText(status,\"cn\"), \"^\", \" \")","        set errorInfo = \"CheckRules分组前校验规则异常：类=\" _ $ClassName() _ \"，入参=\" _ jsonObj.%ToJSON() _ \"，错误：\" _ errorMsg","        ","        // 记录错误日志到数据库","        set errorLogID = ##class(src.Interface.Message).InsErrRecord(\"04000007\", errorInfo, errorMsg)","        set resultObj = ..SetErrorResult(\"-99\", \"CheckRules分组前校验规则异常（日志ID：\"_errorLogID_\")：\"_errorMsg)","    }","","    quit resultObj","}","","/// Creator:     CM","/// CreatDate:   2026-01-01","/// Description: 判断歧义组-主要诊断与主要手术操作在临床逻辑上不相关,或分属不同的主要诊断大类（MDC）","///              必要判断条件：主诊断MDC、主要手术操作","/// code:\t\t ","/// Input:{\"params\":[{\"\":\"\"}]}","/// Debug：","ClassMethod CheckGroupQY(jsonObj As %Library.DynamicObject) As %Library.DynamicObject","{","\tnew (jsonObj)","\tset params = ##class(%DynamicArray).%New()\t","\ttry","\t{","        // 1. 初始化返回对象（标准化结构）","        set resultObj = ..SetSuccessResult(\"0\",\"\")","        ","        // 2. 参数合法性校验（核心前置检查）","        if (jsonObj = \"\") || (jsonObj.params = \"\") ","        {","            set resultObj = ..SetErrorResult(\"-1\", \"入参异常：缺少params参数或参数为空\")","            quit ","        } ","                   ","        // 3. 提取入参并设置默认值（避免空值报错）","        set preMsg=\"CheckRules分组前校验不通过：\"","        set params = jsonObj.params.%Get(0)        ","        set mainDiagCode = params.mainDiagnosisCode  // 主诊断代码","        set mainOperationCode = params.mainOperationCode  // 主手术代码","        set mainDiagMDC = params.mdc //主诊断MDC","        set mainOprnMDC = \"\"  //主手术MDC","                ","        if (mainOperationCode '= \"\")","\t    {","\t\t    //set cc = $EXTRACT(mdc,4) Left(ADRG, 1)=:cc","\t\t    set leftMDC = $EXTRACT(mainDiagMDC,4) ","\t\t    set iCount=\"\"","\t\t    &sql(SELECT COUNT(*) into :iCount FROM CB_DRGCoreGroupsList WHERE MajorProcedure=:mainOperationCode ","\t\t         AND SelectionCriteria='包含以下主要手术或操作' AND UnionFlag=0 AND LEFT(ADRG,1)=:leftMDC)","\t\t         \t\t \t    ","\t\t    if (SQLCODE =0) && (iCount =0)","\t\t    {\t\t\t    ","\t\t\t     set resultObj = ..SetErrorResult(\"-1\", \"进入QY组,主手术操作与主诊断对应MDC：【\"_mainDiagMDC_\"】不匹配！\")\t","\t\t\t}","\t\t}\t    \t                   \t   \t        \t","\t}","    catch(e) ","    {","        // 7. 异常处理（增强：包含错误码+详细信息）","        set status = e.AsStatus()","        set errorCode = $piece(##class(%SYSTEM.Status).GetErrorCodes(status), \",\")","        set errorMsg = $replace(##class(%SYSTEM.Status).GetErrorText(status,\"cn\"), \"^\", \" \")","        set errorInfo = \"CheckGroupQY校验歧义组异常：类=\" _ $ClassName() _ \"，入参=\" _ jsonObj.%ToJSON() _ \"，错误：\" _ errorMsg","        ","        // 记录错误日志到数据库","        set errorLogID = ##class(src.Interface.Message).InsErrRecord(\"04000007\", errorInfo, errorMsg)","        set resultObj = ..SetErrorResult(\"-99\", \"CheckGroupQY校验歧义组异常（日志ID：\"_errorLogID_\")：\"_errorMsg)","    }","","    quit resultObj","}","","/// Creator:     CM","/// CreatDate:   2026-01-01","/// Description: 第一步：MDC先期分组","/// code:\t\t ","/// Input:{\"params\":[{\"\":\"\"}]}","/// Debug：","ClassMethod GroupPreMDC(jsonObj As %Library.DynamicObject) As %Library.DynamicObject","{","\tnew (jsonObj)","\tset params = ##class(%DynamicArray).%New()\t","    try","    {  ","        // 1. 初始化返回对象（标准化结构）","        set resultObj = ..SetSuccessResult(\"0\",\"\")","        ","        // 2. 参数合法性校验（核心前置检查）","        if (jsonObj = \"\") || (jsonObj.params = \"\") ","        {","            set resultObj = ..SetErrorResult(\"-1\", \"入参异常：缺少params参数或参数为空\")","            quit ","        }              ","        // 3. 提取入参并设置默认值（避免空值报错）","        set params = jsonObj.params.%Get(0)","        set mainDiagCode = params.mainDiagnosisCode  // 主诊断代码","        set sex = params.sex                        // 性别","        set age = params.age                          // 年龄（默认0）","        set ageGroupDays = params.ageGroupDays        // 新生儿出生天数（默认0）","        set newbornFlag = params.newbornFlag        // 新生儿标志（默认0）","        set respiratorTime = params.respiratorTime    // 有创呼吸机时长（默认0）","        set ecmoFlag = params.ecmoFlag              // ECMO标志（默认0）","        set transplantFlag = params.transplantFlag  // 器官移植标志（默认0）","        set marrowTransplantFlag = params.marrowTransplantFlag // 骨髓移植标志","        set hivFlag = params.hivFlag                // HIV标志（默认0）","        set traumaLevel = params.traumaLevel          // 多发创伤等级（默认0）","","        // 4. 日志记录（新增：便于问题排查）","        set checkParams = \"主诊断=\" _ mainDiagCode _ \",年龄=\" _ age _ \",新生儿天数=\" _ ageGroupDays","        //do ..LogCheckInfo(\"PreMDC检查开始\", checkParams)","","        // 5. 先期分组核心逻辑（按优先级排序：高资源消耗优先）","        // 5.1 MDCA - 高资源消耗病例（器官移植/骨髓移植/ECMO/呼吸机≥96h）","        if (transplantFlag = \"1\") ","        {","            set resultObj = ..SetSuccessResult(\"MDCA\", \"主诊断大类入组MDCA：器官移植病例\")","        } ","        elseif (marrowTransplantFlag = \"1\") ","        {","            set resultObj = ..SetSuccessResult(\"MDCA\", \"主诊断大类入组MDCA：骨髓移植病例\")","        } ","        elseif (ecmoFlag = \"1\") ","        {","            set resultObj = ..SetSuccessResult(\"MDCA\", \"主诊断大类入组MDCA：ECMO治疗病例\")","        } ","        elseif (respiratorTime >= 96) ","        {","            set resultObj = ..SetSuccessResult(\"MDCA\", \"主诊断大类入组MDCA：有创呼吸机使用时长≥96小时（实际：\"_respiratorTime_\"小时）\")","        }","        // 5.2 MDCP - 新生儿病例（出生天数1-28天 或 新生儿标志为1）","        elseif ((ageGroupDays > 0) && (ageGroupDays < 29) || (newbornFlag = \"1\")) ","        {","            set resultObj = ..SetSuccessResult(\"MDCP\", \"主诊断大类入组MDCP：新生儿疾病（出生天数：\"_ageGroupDays_\"天）\")","        }","        // 5.3 MDCY - HIV感染病例","        elseif (hivFlag = \"1\") ","        {","            set resultObj = ..SetSuccessResult(\"MDCY\", \"主诊断大类入组MDCY：HIV感染相关疾病\")","        }","        // 5.4 MDCZ - 多发严重创伤（等级≥2）","        elseif (traumaLevel >= 2) ","        {","            set resultObj = ..SetSuccessResult(\"MDCZ\", \"主诊断大类入组MDCZ：多发严重创伤（创伤等级：\"_traumaLevel_\"级）\")","        }","        // 5.5 未命中先期分组（返回空编码，进入常规MDC分组）","        else ","        {","\t\t    set (mdcCode,mdcDesc)=\"\"","\t\t    &sql(SELECT HBDictionaries_Dr->InsuCode,HBDictionaries_Dr->InsuDesc into :mdcCode,:mdcDesc ","\t\t         FROM HB_DRGBasicDataSub WHERE HBDictionaries_Dr->Remark='主诊断编码对照表' ","\t\t         AND Code= :mainDiagCode )","\t\t    ","\t\t    if (mdcCode'=\"\")","\t\t    {","\t\t\t    set resultObj = ..SetSuccessResult(mdcCode, mdcDesc) ","\t\t\t}","\t\t\telse","\t\t\t{","\t\t\t    set resultObj = ..SetErrorResult(\"-1\", \"通过主诊断 \"_mainDiagCode_\", 主诊断大类MDC分组失败, 请先检查传入的诊断编码是否为医保诊断编码！\")\t","\t\t\t}\t        \t                    ","        }","","        // 6. 日志记录检查结果","        //do ..LogCheckInfo(\"PreMDC检查结束\", \"分组结果：\" _ resultObj.result.Code _ \"，说明：\" _ resultObj.result.Message)        ","    } ","    catch(e) ","    {","        // 7. 异常处理（增强：包含错误码+详细信息）","        set status = e.AsStatus()","        set errorCode = $piece(##class(%SYSTEM.Status).GetErrorCodes(status), \",\")","        set errorMsg = $replace(##class(%SYSTEM.Status).GetErrorText(status,\"cn\"), \"^\", \" \")","        set errorInfo = \"PreMDC分组异常：类=\" _ $ClassName() _ \"，入参=\" _ jsonObj.%ToJSON() _ \"，错误：\" _ errorMsg","        ","        // 记录错误日志到数据库","        set errorLogID = ##class(src.Interface.Message).InsErrRecord(\"04000007\", errorInfo, errorMsg)","        set resultObj = ..SetErrorResult(\"-99\", \"MDC先期分组异常（日志ID：\"_errorLogID_\")：\"_errorMsg)","    }","","    quit resultObj","}","","/// Creator:     CM","/// CreatDate:   2026-01-01","/// Description: 第二步：ADRG分组 ","/// code:\t\t ","/// Input:{\"params\":[{\"\":\"\"}]}","/// Debug：","ClassMethod GroupADRG(jsonObj As %Library.DynamicObject) As %Library.DynamicObject","{","     //ADRG分组顺序","     //ADRG联合分组规则有AC1、AH2、PS1、PS2、PS3、PS4、BB1、CB2、CB3、FB1、FF1、YC1、YR1、YR2、ZZ1     ","\t //1.先期分组+联合分组规则--AC1、AH2、PS1、PS2、PS3、PS4、YC1、YR1、YR2、ZZ1","\t //2.先期分组+非联合分组规则--AA1、AA2、AB1、AD1、AE1、AF1、AG1、AG2、AG3、AH1、PB1、PC1、PD1、PJ1、PK1、PR1、PU1、PV1、ZB1、ZC1、ZD1、ZJ1","\t //3.非先期分组+联合分组规则--BB1、CB2、CB3、FB1、FF1...","\t //4.非先期分组+非联合分组规则+主要诊断--...","\t //5.非先期分组+非联合分组规则+主要手术或操作--...","\t ","\t//new (jsonObj)","\t//set params = ##class(%DynamicArray).%New()    ","    try","    {\t    ","        // 1. 初始化返回对象（标准化结构）","        set resultObj = ..SetSuccessResult(\"\",\"\")","        ","        // 2. 参数合法性校验（核心前置检查）","        if (jsonObj = \"\") || (jsonObj.params = \"\") ","        {","            set resultObj = ..SetErrorResult(\"-1\", \"入参异常：缺少params参数或参数为空\")","            quit ","        }                                       ","        \t    ","        // 3. 提取入参并设置默认值（避免空值报错）","        set params = jsonObj.params.%Get(0)","        set mainDiagCode = params.mainDiagnosisCode  // 主诊断代码","        set diseinfo = params.diseInfo  // 疾病诊断代码-数组对象","        set mainOpCode = params.mainOperationCode  // 主手术操作代码","        set oprninfo = params.oprnInfo  // 手术操作代码-数组对象        ","        set respiratorTime = params.respiratorTime    // 有创呼吸机时长（默认0）","        set sex = params.sex                         // 性别","        set age = params.age                         // 年龄（默认0）","        set mdc = params.mdc                          //MDC主诊断大类分组   ","        ","        // 如果为空字符串或非数组，设置为空数组","    \tif (diseinfo = \"\") || ('$ISOBJECT(diseinfo)) set diseinfo = []","    \tif (oprninfo = \"\") || ('$ISOBJECT(oprninfo)) set oprninfo = []       \t   \t      \t        \t                                          \t    \t     ","\t    ","\t    //先期分组标志","\t    set preMDCFlag=0","\t    if ($listfind($lb(\"MDCA\",\"MDCP\",\"MDCY\",\"MDCZ\"), mdc) = 1)","\t    {","\t\t    set preMDCFlag=1   ","\t\t}  ","\t\t","        set (adrgCode,adrgDesc,adrgCodeList,adrgDescList)= \"\"\t ","        Set sqlStr = \" SELECT Code,Descripts,Identification FROM HB_DRGBasicDataSub WHERE HBDictionaries_Dr->InsuCode='ADRG' \"  ","                   _ \" AND Left(Code, 1)= '\"_$EXTRACT(mdc,4)_\"'\"","\t","\t\tset sqlObj=##class(%SQL.Statement).%New(1)","\t\tset sc=sqlObj.%Prepare(sqlStr)","\t\t//set list=sqlObj.%Execute()\t","\t\tSet rs = sqlObj.%Execute()       ","        while rs.%Next(sc)","        {\t        \t        \t        ","\t        set adrgCode= rs.%Get(\"Code\")      //ADRG编码","\t        set adrgDesc= rs.%Get(\"Descripts\") //ADRG名称\t  ","\t        ","\t        if (adrgCode=\"\")","\t        {","\t\t\t\tset resultObj = ..SetErrorResult(\"-1\",\"主诊断大类_【\"_mdc_\"】未维护对应ADRG核心疾病诊断相关分组！\")","\t\t\t\tquit ","\t\t    }      \t                \t        ","\t        \t        ","\t\t\t//查询当前ADRG分组规则  主要诊断/主要手术或操作","\t\t\tset (adrg,selectionCriteria,unionFlag)=\"\" //入组规则、联合规则标志\t\t\t      \t\t\t\t         \t\t\t\t        ","\t\t\t&sql(SELECT Top 1 ADRG,SelectionCriteria,UnionFlag into :adrg,:selectionCriteria,:unionFlag FROM CB_DRGCoreGroupsList WHERE ADRG=:adrgCode)\t        \t","\t        if (SQLCODE=0)","\t        {","\t\t        if (adrg =\"\")","\t\t        {","\t\t\t\t    set resultObj = ..SetErrorResult(\"-11\",\"ADRG核心疾病诊断相关分组表CB_DRGCoreGroupsList未维护:【\"_adrgCode_\"：\"_adrgDesc_\"】分组规则！\")","\t\t\t\t    quit\t   ","\t\t\t    }","\t\t        ","\t\t        if (selectionCriteria =\"\")","\t\t        {","\t\t\t\t    set resultObj = ..SetErrorResult(\"-12\",\"ADRG核心疾病诊断相关分组表CB_DRGCoreGroupsList未维护:【\"_adrgCode_\"：\"_adrgDesc_\"】入组条件！\")","\t\t\t\t    quit\t\t\t        ","\t\t\t    } ","\t\t    }  ","\t\t     ","            set row={},rows = []","            set row.code = adrgCode","            set row.desc = adrgDesc                 ","            do rows.%Push(row)","            set resultObj = ..SetJarraySuccessResult(rows,1)\t\t\t    \t\t    ","\t\t    \t\t         \t        \t        \t               \t          ","\t        //1.先处理--先期分组","\t        if (preMDCFlag=1)","\t        {","\t\t        //2.处理先期分组--联合分组规则","\t\t        //同时包含以下手术或操作","\t\t        if (adrgCode=\"AC1\") ","\t\t        {\t\t\t             ","\t\t            set (iCount,m)=0\t\t        \t","                    // 遍历operationArray数组","                    for j=0:1:oprninfo.%Size()-1 ","                    {        ","                        // 获取手术操作编码和名称             ","                        set item = oprninfo.%Get(j)","                        set mainFlag = item.mainFlag","                        set oprnSn = item.oprnSn","                        set oprnCode = item.oprnCode","                        set oprnName = item.oprnName ","                        ","                        //存在不作为分组规则手术及操作代码表中","                        continue:(..CheckNoRulesList(oprnCode)>0)","                                                                                                  ","                        &sql(SELECT COUNT(DISTINCT ADRG) into :iCount FROM CB_DRGCoreGroupsList WHERE UnionFlag =1  ","                             AND ADRG=:adrgCode AND (MajorProcedure=:oprnCode OR SecondaryProcedure=:oprnCode OR ThirdlyProcedure=:oprnCode))","                        // 如果SQL执行成功且有结果","                        if (SQLCODE = 0) && (iCount > 0) ","                        {","                            set m = m + 1","                        }","                        ","                        quit:m>1\t                    \t                                              ","                    }\t\t\t        \t        \t\t\t        \t\t\t        \t\t\t       \t","\t\t\t    }","\t\t\t    //（其他诊断 或 手术或操作1）+ 手术或操作2","\t\t\t    elseif (adrgCode=\"AH2\") ","\t\t\t    {              ","\t\t\t       set (m,n)=0\t\t\t       ","\t\t\t       //手术或操作1 + 手术或操作2","\t\t\t       for i=0:1:oprninfo.%Size()-1 ","\t\t\t       {","                        // 获取手术或操作编码和名称                    ","                        set item = oprninfo.%Get(i)","                        set mainFlag = item.mainFlag","                        set oprnSn = item.oprnSn","                        set oprnCode = item.oprnCode","                        set oprnName = item.oprnName","                        ","                        //存在不作为分组规则手术及操作代码表中","                        continue:(..CheckNoRulesList(oprnCode) > 0)","\t                    ","                        //主要手术或操作标识不为1,序号需要为2表示第二次要手术或操作","                        if (mainFlag '= \"1\")&&(oprnSn=\"2\")","                        {","\t                        set secOperationCode = oprnCode","\t                    }","\t                    //主要手术或操作标识不为1,序号需要为3表示第三次要手术或操作","\t                    elseif (mainFlag '= \"1\")&&(oprnSn=\"3\")","                        {","\t                        set thirdOperationCode = oprnCode","\t                    }","\t                    ","\t                    //手术或操作1 + 手术或操作2","                        &sql(SELECT COUNT(DISTINCT ADRG) into :m FROM CB_DRGCoreGroupsList WHERE UnionFlag =1 AND ADRG=:adrgCode                                    ","                             And SecondaryProcedure=:secOperationCode And ThirdlyProcedure=:thirdOperationCode)","                        // 如果SQL执行成功且有结果","                        quit:((SQLCODE = 0) && (m > 0))\t                    \t                    \t\t\t       ","\t\t\t\t    }","\t\t\t    \t\t\t    \t\t\t          \t\t\t\t   \t\t\t\t    \t\t\t\t    \t\t\t\t   \t\t\t\t    \t\t\t\t    ","                    //其他诊断 + 手术或操作2\t\t        \t","                    for j=0:1:diseinfo.%Size()-1 ","                    {","                        // 获取诊断编码和名称                  ","                        set item = diseinfo.%Get(j)","                        set mainFlag = item.mainFlag","                        set diagSn = item.diagSn","                        set diagCode = item.diagCode","                        set diagName = item.diagName","                        ","                        //存在不作为分组规则疾病诊断表中","                        continue:(..CheckNoRulesList(diagCode)>0)                        ","            ","                        if (mainFlag '=\"1\") //其他诊断","                        {","                            &sql(SELECT COUNT(DISTINCT ADRG) into :n FROM CB_DRGCoreGroupsList WHERE UnionFlag =1","                                 AND ADRG=:adrgCode and (SecondaryDiagnosis=:diagCode OR ThirdlyDiagnosis=:diagCode) And ThirdlyProcedure=:thirdOperationCode)","                            // 如果SQL执行成功且有结果","                            quit:((SQLCODE = 0) && (n > 0))                          ","\t                    }                                                \t                    \t                                              ","                    }\t\t\t          ","\t\t\t\t}","\t\t\t\t//包含以下主要诊断或其他诊断 ","\t\t\t    elseif ($listfind($lb(\"PS1\",\"PS2\",\"PS3\",\"PS4\",\"YR1\",\"YR2\"), adrgCode) = 1)","\t\t\t    {","\t\t\t\t    //遍历诊断数组","                    for j=0:1:diseinfo.%Size()-1 ","                    {","                        // 获取诊断编码和名称                   ","                        set item = diseinfo.%Get(j)","                        set mainFlag = item.mainFlag","                        set diagSn = item.diagSn","                        set diagCode = item.diagCode","                        set diagName = item.diagName","                        ","                        //存在不作为分组规则疾病诊断表中","                        continue:(..CheckNoRulesList(diagCode)>0)                       ","\t                    \t                                          ","                        if (mainFlag '=\"1\") //其他诊断","                        {","\t                        set n=0","                            &sql(SELECT COUNT(DISTINCT ADRG) into :n FROM CB_DRGCoreGroupsList WHERE UnionFlag =1                                    ","                                 AND ADRG=:adrgCode AND (PrincipalDiagnosis=:mainDiagCode OR SecondaryDiagnosis=:diagCode OR ThirdlyDiagnosis=:diagCode))","                            ","                            // 如果SQL执行成功且有结果","                            quit:((SQLCODE = 0)&&(n > 0))","\t                    }                                                \t                    \t                                              ","                    }\t\t\t","\t\t\t\t}","\t\t\t\t//包含全部手术或操作","\t\t\t\telseif (adrgCode=\"YC1\")","\t\t\t\t{","\t\t\t\t\t//存在手术或操作并且存在诊断符合HIV感染疾病及相关操作,符合YC1-HIV相关疾病的手术","\t\t\t\t\tif (mainOpCode '= \"\") || (diseinfo.%Size()>0)","\t\t\t\t\t{","\t\t\t\t\t\t//遍历诊断数组","\t\t\t\t\t\tfor j=0:1:diseinfo.%Size()-1","\t\t\t\t\t\t{","                            // 获取诊断编码和名称                   ","                            set item = diseinfo.%Get(j)","                            set mainFlag = item.mainFlag","                            set diagSn = item.diagSn","                            set diagCode = item.diagCode","                            set diagName = item.diagName","                        ","                            //存在不作为分组规则疾病诊断表中","                            continue:(..CheckNoRulesList(diagCode)>0)","\t                        ","\t                        set n=0","                            &sql(SELECT COUNT(DISTINCT ADRG) into :n FROM CB_DRGCoreGroupsList WHERE UnionFlag =1 AND ADRG=:adrgCode                                     ","                                 AND (PrincipalDiagnosis=:diagCode OR SecondaryDiagnosis=:diagCode OR ThirdlyDiagnosis=:diagCode))","                                 ","                            // 如果SQL执行成功且有结果","                            quit:((SQLCODE = 0)&&(n > 0)) \t                        \t                        \t                        ","\t\t\t\t\t\t}\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t","\t\t\t\t\t}","\t\t\t\t}","\t\t\t\t//包含以下主要诊断","\t\t\t\telseif ($listfind($lb(\"PR1\",\"PU1\",\"PV1\"), adrgCode) = 1)","\t\t\t\t{","\t                set n=0","                    &sql(SELECT COUNT(DISTINCT ADRG) into :n FROM CB_DRGCoreGroupsList WHERE UnionFlag =0                                   ","                         AND ADRG=:adrgCode AND PrincipalDiagnosis=:mainDiagCode)","                         ","                    // 如果SQL执行成功且有结果","                    quit:((SQLCODE = 0)&&(n > 0))","\t\t\t\t}","\t\t\t\t//包含以下主要手术或操作","\t\t\t\telseif ($listfind($lb(\"AA1\",\"AA2\",\"AB1\",\"AD1\",\"AE1\",\"AF1\",\"AG1\",\"AG2\",\"AG3\",\"AH1\",","\t\t\t\t                      \"PB1\",\"PC1\",\"PD1\",\"PJ1\",\"PK1\",\"ZB1\",\"ZC1\",\"ZD1\",\"ZJ1\"), adrgCode) = 1)","\t\t\t\t{                   ","                    if (mainOpCode '=\"\")","                    {","                        if (..CheckNoRulesList(mainOpCode)=0)","                        {","\t                        set n=0","                            &sql(SELECT COUNT(DISTINCT ADRG) into :n FROM CB_DRGCoreGroupsList WHERE UnionFlag =0                                   ","                                 AND ADRG=:adrgCode AND MajorProcedure=:mainOpCode)","                                 ","                             // 如果SQL执行成功且有结果","                            quit:((SQLCODE = 0) && (n > 0))","\t                    }    ","\t                } \t\t","\t\t\t\t}\t","\t\t\t\t//符合 MDCZ 诊断表,且无手术或操作            ","\t\t\t\telseif (adrgCode=\"ZZ1\")","\t\t\t\t{","\t\t\t\t\t//主要手术及操作和手术及操作数组对象都为空","\t\t\t\t\tif (mainOpCode=\"\") && (oprninfo.%Size()=0)","\t\t\t\t\t{","\t                    set n=0","                        &sql(SELECT COUNT(DISTINCT ADRG) into :n FROM CB_DRGCoreGroupsList WHERE UnionFlag =1                                    ","                             AND ADRG=:adrgCode AND PrincipalDiagnosis=:mainDiagCode)","                             ","                        // 如果SQL执行成功且有结果","                        quit:((SQLCODE = 0) && (n > 0)) \t","\t\t\t\t\t}","\t\t\t\t}\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t   \t\t   \t\t   ","\t\t    }","\t\t    else //其他ADRG分组","\t\t    {","\t\t\t    \t\t","                //无手术/操作时：可以用主诊断来查找对应的ADRG（内科组）","                //有手术/操作时：不能仅用主诊断来查找ADRG，必须用主诊断锁定MDC，再用主手术锁定该MDC下的外科/操作组ADRG    \t\t\t","    \t\t\t","    \t\t\t//同时包含CB4和CB5的手术或操作(CB2)--至少存在两个手术","    \t\t\tif ($listfind($lb(\"CB2\"), adrgCode) = 1)","    \t\t\t{","\t\t\t        //遍历手术或操作","\t\t\t        set m=0","\t\t\t        for i=0:1:oprninfo.%Size()-1 ","\t\t\t        {","                        // 获取手术或操作编码和名称                   ","           