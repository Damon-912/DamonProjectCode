insuAreaDesc=\"市本级\")","\t\t        {","\t\t\t        set mdtrtArea=$E(mdtrtareaAreaCode,1,4)_\"00\"     ","\t\t\t    }","\t\t\t    elseif (insuAreaDesc=\"省直\")","\t\t        {","\t\t\t        set mdtrtArea=$E(mdtrtareaAreaCode,1,2)_\"9900\"     ","\t\t\t    }","\t\t\t    elseif (insuAreaDesc=\"异地\")","\t\t        {","\t\t\t        set mdtrtArea=$E(mdtrtareaAreaCode,1,2)_\"0000\"     ","\t\t\t    }","\t\t\t    ","                if (queryYear '= \"\") ","                {","                    &sql(SELECT Points, PipValue, DGDOV, PayStandard into :points,:pipValue,:dgdov,:payStandard FROM HB_DRGCoreAlgorithmData ","                         WHERE FixmedinsCode=:hospCode AND DRG=:DRG AND MdtrtArea=:mdtrtArea AND (Year=:queryYear OR Year IS NULL OR Year=''))","                } ","                else ","                {","                    &sql(SELECT Points, PipValue, DGDOV, PayStandard into :points,:pipValue,:dgdov,:payStandard FROM HB_DRGCoreAlgorithmData ","                         WHERE FixmedinsCode=:hospCode AND DRG=:DRG AND MdtrtArea=:mdtrtArea)","                }    \t\t\t    ","\t\t    }","\t\t    elseif (iCount=1) //只存在一条记录，表示当前医院市本级、省直、异地算法配置都一样,直接取市本级数据","\t\t    {","\t\t\t    set insuAreaDesc=\"市本级\"","                if (queryYear '= \"\") ","                {","                    &sql(SELECT Points, PipValue, DGDOV, PayStandard into :points,:pipValue,:dgdov,:payStandard FROM HB_DRGCoreAlgorithmData ","                         WHERE FixmedinsCode=:hospCode AND DRG=:DRG AND (Year=:queryYear OR Year IS NULL OR Year=''))","                } ","                else ","                {","                    &sql(SELECT Points, PipValue, DGDOV, PayStandard into :points,:pipValue,:dgdov,:payStandard FROM HB_DRGCoreAlgorithmData ","                         WHERE FixmedinsCode=:hospCode AND DRG=:DRG)","                }","\t\t\t}","\t\t\telse //iCount=0 当前年份/上一年份均无匹配数据","\t\t\t{","\t\t\t\tset (points,pipValue,dgdov,payStandard)=\"0.00\"","\t\t\t\tset insuAreaDesc=\"\"","\t\t\t\tif (groupYear '= \"\") ","\t\t\t\t{","\t\t\t\t\tset insuAreaDesc=\"未维护【\"_groupYear_\"年】DRG分组数据\"","\t\t\t\t}","\t\t\t}\t        ","                                                           ","\t\t    if (payStandard=\"0.00\")||(payStandard=\"\")\t\t    ","\t\t    {","\t\t\t    set (points,pipValue,dgdov,payStandard)=\"0.00\"","\t\t\t}","\t\t\t","\t\t\t//continue:(payStandard =\"0.00\")||(payStandard =\"\")","            ","            set jo={}","            set jo.hisHospCode = hisHospCode","            set jo.hospCode = hospCode","            set jo.hospName = hospName_\"[\"_queryYear_\"年\"_insuAreaDesc_\"DRG分组方案]\"","            set jo.algorithm= insuAreaDesc","            set jo.policyType= policyType","            set jo.drg = DRG ","            set jo.drgDesc = DRGDesc                       ","            set jo.points = points","            set jo.pipValue = pipValue","            set jo.dgdov = dgdov","            set jo.payStandard = payStandard                        ","            set jo.totalCost = totalCost","","            //差异率（相对差异） = （实际费用 - 预估费用） / 预估费用 × 100%                           ","            if (payStandard=\"0.00\")||(payStandard=\"\")","            {","                set discrepancyRate = 100                    ","                set discrepancyAmt = payStandard - totalCost","\t        }","\t        else","\t        {","                set discrepancyRate = $FNUMBER(($ZABS(totalCost - payStandard)/payStandard)*100,\"L\",2)                       ","                set discrepancyAmt = payStandard - totalCost   ","\t\t    }","                        ","            if (discrepancyAmt > 0)","            {","\t            set jo.preProfit = $FNUMBER(discrepancyAmt,\"L\",2) //盈利","                set jo.preLoss = \"0.00\" //亏损","                set jo.profitLoss = \"盈利\"  ","\t        }","\t        elseif (discrepancyAmt < 0)","\t        {","\t            set jo.preProfit = \"0.00\" //盈利","\t            set jo.preLoss = $FNUMBER(discrepancyAmt,\"L\",2) //亏损 ","\t            set jo.profitLoss = \"亏损\"  ","\t\t    }","\t        elseif (discrepancyAmt = 0)","\t        {","\t            set jo.preProfit = \"0.00\" //盈利","\t            set jo.preLoss = \"0.00\" //亏损 ","\t            set jo.profitLoss = \"\"  ","\t\t    }","\t\t    \t","\t\t    set jo.discrepancyRate = discrepancyRate //差异率%","\t\t    set jo.groupPlanYear = queryYear //实际使用的分组方案年份","\t\t    ","\t\t\tdo jaAlgorithm.%Push(jo)     \t                                                                     ","        }","       ","        //第七步：封装返回值","\t\tset DRG=joRtn.result.code","\t\tset DRGDesc=joRtn.result.desc","\t\tset resultObj = ..SetSuccessResult(DRG,DRGDesc)","","\t\tset joRtn={}","\t\tset joRtn.mdc=MDC","\t\tset joRtn.mdcDesc=MDCDesc","\t\tset joRtn.complicationInfo=jaComplication","\t\tset joRtn.drgInfo=jaDRG","\t\tset joRtn.hospAlgorithmInfo=jaAlgorithm","\t\tset joRtn.checkTime = $ZDATETIME($HOROLOG,3)","","    \tset resultObj={}","\t    set resultObj.errorCode = \"0\"","\t    set resultObj.errorMessage = \"\"","\t    set resultObj.result = joRtn    ","\t    set resultObj.params = params","\t    ","\t    //第八步：分组成功插入分组记录表","\t    /*","\t    if (medicalRecordID '= \"\")","\t    {","\t\t    // 构造保存分组记录的入参","\t\t    set saveParams = {}","\t\t    set saveParams.admID = $GET(hisAdmID, \"\")","\t\t    set saveParams.medcasNo = $GET(medicalRecordID, \"\")","\t\t    set saveParams.patientName = patientName","\t\t    set saveParams.psnNo = $GET(psnNo, \"\")","\t\t    set saveParams.insuranceAreaCode = $GET(insuranceAreaCode, \"\")","\t\t    set saveParams.mdtrtareaAreaCode = $GET(mdtrtareaAreaCode, \"\")","\t\t    ","\t\t    set saveParams.insuType = $GET(insuType, \"\")","\t\t    set saveParams.sex = $GET(sex, \"\")","\t\t    set saveParams.age = $GET(age, \"\")","\t\t    set saveParams.mainDiagnosisCode = $GET(mainDiagCode, \"\")","\t\t    set saveParams.mainDiagnosisName = \"\"","\t\t    set saveParams.diaTypeCode = 