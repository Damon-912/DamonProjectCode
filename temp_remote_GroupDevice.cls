lWhere = sqlWhere _ \" AND DRG = ?\"","            do sqlParams.%Push(drg)","        }","        if (mainDiagnosisCode '= \"\")","        {","            set sqlWhere = sqlWhere _ \" AND MainDiagnosisCode = ?\"","            do sqlParams.%Push(mainDiagnosisCode)","        }","        if (department '= \"\")","        {","            set sqlWhere = sqlWhere _ \" AND Department = ?\"","            do sqlParams.%Push(department)","        }","        if (groupStage '= \"\")","        {","            set sqlWhere = sqlWhere _ \" AND GroupStage = ?\"","            do sqlParams.%Push(groupStage)","        }","        if (startDate '= \"\")","        {","            set sqlWhere = sqlWhere _ \" AND CreateDate >= ?\"","            do sqlParams.%Push($ZDATEH(startDate, 3))","        }","        if (endDate '= \"\")","        {","            set sqlWhere = sqlWhere _ \" AND CreateDate <= ?\"","            do sqlParams.%Push($ZDATEH(endDate, 3))","        }","        // 入院时间范围查询","        if (admStartDate '= \"\")","        {","            set sqlWhere = sqlWhere _ \" AND AdmDateTime >= ?\"","            do sqlParams.%Push($ZDATEH(admStartDate, 3))","        }","        if (admEndDate '= \"\")","        {","            set sqlWhere = sqlWhere _ \" AND AdmDateTime <= ?\"","            do sqlParams.%Push($ZDATEH(admEndDate, 3))","        }","        // 出院时间范围查询","        if (discgStartDate '= \"\")","        {","            set sqlWhere = sqlWhere _ \" AND DiscgDateTime >= ?\"","            do sqlParams.%Push($ZDATEH(discgStartDate, 3))","        }","        if (discgEndDate '= \"\")","        {","            set sqlWhere = sqlWhere _ \" AND DiscgDateTime <= ?\"","            do sqlParams.%Push($ZDATEH(discgEndDate, 3))","        }","        // 结算时间范围查询","        if (settleStartDate '= \"\")","        {","            set sqlWhere = sqlWhere _ \" AND SettleDateTime >= ?\"","            do sqlParams.%Push($ZDATEH(settleStartDate, 3))","        }","        if (settleEndDate '= \"\")","        {","            set sqlWhere = sqlWhere _ \" AND SettleDateTime <= ?\"","            do sqlParams.%Push($ZDATEH(settleEndDate, 3))","        }","        ","        // 5. 查询总记录数","        set totalSql = \"SELECT COUNT(*) AS total FROM BS_DRGGroupRecord\" _ sqlWhere","        set stmt = ##class(%SQL.Statement).%New()","        set sc = stmt.%Prepare(totalSql)","        ","        set total = 0","        if ($$$ISOK(sc))","        {","            set rs = stmt.%Execute(sqlParams...)","            if (rs.%Next())","            {","                set total = rs.total","            }","        }","        set resultObj.result.total = total","        ","        // 6. 如果没有记录，直接返回","        if (total = 0)","        {","            return resultObj","        }","        ","        // 7. 计算分页参数","        set page = $GET(currentPage, 1)","        set limit = $GET(pageSize, 20)","        set startRow = (page - 1) * limit","        ","        // 8. 查询数据列表（使用对象方式构建返回结构）","        set dataSql = \"SELECT ID FROM User.BSDRGGroupRecord \" _ sqlWhere _ \" ORDER BY CreateDate DESC, CreateTime DESC\"","        set stmt = ##class(%SQL.Statement).%New()","        set sc = stmt.%Prepare(dataSql)","        ","        set rows = []","        set rowIndex = 0","        set skipCount = 0","        ","        if ($$$ISOK(sc))","        {","            set rs = stmt.%Execute(sqlParams...)","            ","            while (rs.%Next())","            {","                set rowIndex = rowIndex + 1","                ","                // 分页处理：跳过前面的记录","                if (rowIndex <= startRow)","                {","                    continue","                }","                ","                // 限制返回数量","                if (rows.%Size() >= limit)","                {","                    quit","                }","                ","                // 使用对象方式获取完整数据","                set record = ##class(User.BSDRGGroupRecord).%OpenId(rs.ID)","                if (record '= \"\")","                {","                    set row = {}","                    set row.id = record.%Id()","                    set row.admID = record.AdmID","                    set row.medcasNo = record.MedcasNo","                    set row.patientName = record.PatientName","                    set row.psnNo = record.PsnNo","                    set row.insuranceAreaCode = record.InsuranceAreaCode","                    set row.insuType = record.InsuType","                    set row.sex = record.Sex","                    set row.age = record.Age","                    ","                    // 诊断信息","                    set row.mainDiagnosisCode = record.MainDiagnosisCode","                    set row.mainDiagnosisName = record.MainDiagnosisName","                    set row.diaTypeCode = record.DiaTypeCode","                    set row.diagnosisCode = record.DiagnosisCode","                    set row.diagnosisName = record.DiagnosisName","                    set row.mainOperationCode = record.MainOperationCode","                    set row.mainOperationName = record.MainOperationName","                    ","                    // DRG分组结果","                    set row.drg = record.DRG","                    set row.drgDesc = record.DRGDesc","                    set row.weight = record.Weight","                    set row.benchmarkCost = record.BenchmarkCost","                    set row.ccFlag = record.CCFlag","                    set row.mccFlag = record.MCCFlag                    ","                    set row.groupTime = $ZDATETIME(record.GroupTime, 3)","                    set row.groupStage = record.GroupStage","                    set row.remark = record.Remark","                    ","                    // 科室信息","                    set row.department = record.Department","                    set row.departmentDesc = record.DepartmentDesc","                    ","                    // 机构信息","                    set row.fixmedinsCode = record.FixmedinsCode","                    set row.fixmedinsName = record.FixmedinsName","                    ","                    // 时间信息","                    set row.createDate = $ZD(record.CreateDate, 3)","                    set row.createTime = $ZT(record.CreateTime, 1)","                    set row.updateDate = $ZD(record.UpdateDate, 3)","                    set row.updateTime = $ZT(record.UpdateTime, 1)","                    ","                    // 就诊时间信息","                    set row.admDateTime = \"\"","                    set row.discgDateTime = \"\"","                    set row.settleDateTime = \"\"","                    if (record.AdmDateTime '= \"\") set row.admDateTime = $ZDATETIME(record.AdmDateTime, 3)","                    if (record.DiscgDateTime '= \"\") set row.discgDateTime = $ZDATETIME(record.DiscgDateTime, 3)","                    if (record.SettleDateTime '= \"\") set row.settleDateTime = $ZDATETIME(record.SettleDateTime, 3)","                    ","                    set count=count+1","                    if pageSize'=\"\" continue:(count<((currentPage-1)*pageSize+1))||(count>((currentPage)*pageSize))","                    do rows.%Push(row)","                }","            }","        }","","\t\tset resultObj.result.rows=rows","\t\tset resultObj.result.total=total","                ","    }","    catch(e)","    {","        set status = e.AsStatus()","        set errorCode = $piece(##class(%SYSTEM.Status).GetErrorCodes(status), \",\")","        set errorMsg = $replace(##class(%SYSTEM.Status).GetErrorText(status,\"cn\"), \"^\", \" \")","        set errorInfo = \"查询DRG分组记录异常：类=\" _ $ClassName() _ \"，错误：\" _ errorMsg","        ","        // 记录错误日志","        set errorLogID = ##class(src.Interface.Message).InsErrRecord(\"02010036\", errorInfo, errorMsg)","        set resultObj.errorCode = \"-99\"","        set resultObj.errorMessage = \"查询DRG分组记录异常（日志ID：\"_errorLogID_\"）：\"_errorMsg","    }","    ","    quit resultObj","}","","/// Creator:     系统","/// CreatDate:   2026-05-26","/// Description: 解析GroupFactors结构化入组因素字符串","///              格式: \"主要诊断+主要手术\"  → [[\"主要诊断\"],[\"主要手术\"]]","///              格式: \"主要诊断或次要诊断+主要手术\" → [[\"主要诊断\",\"次要诊断\"],[\"主要手术\"]]","///              + 表示 AND 关系，或 表示 OR 关系","/// Input:       groupFactors - 入组因素字符串","/// Output:      $List格式的二维结构：外层是AND关系的组列表，内层是OR关系的字段名列表","///              $LB($LB(\"1\",\"2\"), $LB(\"3\")) 表示 (字段1或字段2)且(字段3)","///              字段映射: \"主要诊断\"→1, \"次要诊断\"→2, \"主要手术\"→3, \"次要手术\"→4","ClassMethod ParseGroupFactors(groupFactors As %String) As %List","{","\tnew (groupFactors)","\tif (groupFactors = \"\") quit \"\"","\t","\tset result = \"\"","\t; 按 + 号分割得到 AND 组","\tset andGroups = $LENGTH(groupFactors, \"+\")","\tfor andIdx = 1:1:andGroups {","\t\tset andGroup = $ZSTRIP($PIECE(groupFactors, \"+\", andIdx), \"<>W\")","\t\tif (andGroup = \"\") continue","\t\t","\t\t; 在各 AND 组内按\"或\"分割得到 OR 项","\t\tset orList = \"\"","\t\tset orCount = $LENGTH(andGroup, \"或\")","\t\tfor orIdx = 1:1:orCount {","\t\t\tset orItem = $ZSTRIP($PIECE(andGroup, \"或\", orIdx), \"<>W\")","\t\t\tif (orItem = \"\") continue","\t\t\t","\t\t\t; 将中文字段名映射为数字编码","\t\t\tif (orItem = \"主要诊断\") {","\t\t\t\tset orList = orList _ $LISTBUILD(1)","\t\t\t} elseif (orItem = \"次要诊断\") {","\t\t\t\tset orList = orList _ $LISTBUILD(2)","\t\t\t} elseif (orItem = \"主要手术\") {","\t\t\t\tset orList = orList _ $LISTBUILD(3)","\t\t\t} elseif (orItem = \"次要手术\") {","\t\t\t\tset orList = orList _ $LISTBUILD(4)","\t\t\t}","\t\t}","\t\t","\t\tif ($LISTLENGTH(orList) > 0) {","\t\t\tset result = result _ $LISTBUILD(orList)","\t\t}","\t}","\t","\tquit result","}","","/// Creator:     系统","/// CreatDate:   2026-05-26","/// Description: 特异化分组匹配算法","///              根据ADRG编码列表、省市信息和年份，查询特异化分组规则表进行匹配","/// Input:       jsonObj - 患者就诊信息JSON对象（含diseinfo, oprninfo数组）","///              MDC - MDC编码","///              jaADRG - ADRG分组结果数组（每个元素含code/drcode）","///              hospinfo - 医疗机构信息数组（取第一个元素的省市信息）","///              groupYear - 分